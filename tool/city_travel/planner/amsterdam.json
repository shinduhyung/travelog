  "transit": {
    "best": "Walk or bike in the centre; use trams for longer hops.",
    "modes": [
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "The main way around, run by GVB. Most routes run about 06:00 to midnight. Tap a contactless bank card (OVpay) or use an OV-chipkaart."
      },
      {
        "mode": "Metro",
        "has": true,
        "text": "Fills the gaps where trams don't go. Same GVB tickets and OVpay tap-in."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Covers areas beyond the tram lines. A few night buses run after midnight."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Bolt work in Amsterdam. Taxis are metered and pricey; use them for late nights or heavy bags."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not worth it in the compact centre. Parking is limited and costly; stick to trams, bikes and walking."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre is flat and compact, so walking is often fastest. Watch for bike lanes."
      },
      {
        "mode": "Bike",
        "has": true,
        "text": "Locals' favourite. Rent for a half day and follow the rules: use bike lanes and park only in marked spots."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Free ferries cross the IJ behind Centraal station. A cheap way to see Amsterdam Noord."
      }
    ]
  },
  "climate_guide": {
    "summary": "Temperate and changeable: mild summers, cool winters, and rain in every month. Always carry a light waterproof.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 12–15 rain days every month. Showers pass quickly, so a light rain jacket beats an umbrella in wind."
      },
      {
        "icon": "🌡️",
        "title": "Mild summers",
        "text": "July and August peak around 22°C with lows near 14–15°C. Rarely hot; evenings stay cool."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "December to February highs sit near 7–8°C and lows near 2–4°C. A warm coat, hat and gloves help."
      },
      {
        "icon": "🌸",
        "title": "Best months: May to September",
        "text": "Warmest and brightest, around 17–22°C. Also the busiest, so book museums and stays early."
      },
      {
        "icon": "💨",
        "title": "Wind and changeable skies",
        "text": "Weather shifts within a day. Check the forecast each morning and keep plans flexible."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket, comfortable walking shoes and a small day bag. Add a warm layer for winter."
      }
    ]
  }
