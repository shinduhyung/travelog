  "transit": {
    "best": "Use the RapidKL metro for most sights; Grab for late nights and places off the rail grid.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "RapidKL lines 3, 4, 5, 8, 9, 11 and 12 cover most sights. Trains every 2–7 minutes. Buy a Touch 'n Go card (RM10 plus top-up)."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "KTM lines 1, 2 and 10 and ERL lines 6 and 7 link KL Sentral to suburbs and the airport. Contactless cards work on KTM and ERL only."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Cheap but slow. Use buses for short hops off the rail grid."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Grab is the main ride app. Metered taxis exist but agree the fare first."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is stressful in jams. Only worth it for trips out of the city."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in the centre, but pavements are patchy. Watch your step and cross with care."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year: highs around 30–32°C, lows around 23–24°C, and rain on most months. It is wettest from March to May and October to December.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Hot every month",
        "text": "Highs stay around 30–32°C and lows around 23–24°C all year. There is no cool season."
      },
      {
        "icon": "🌧️",
        "title": "Rain is normal",
        "text": "Expect 17–29 rain days a month. February is driest; November is wettest."
      },
      {
        "icon": "⛈️",
        "title": "Afternoon storms",
        "text": "Downpours are often short and heavy, usually later in the day. Plan outdoor sights for the morning."
      },
      {
        "icon": "💦",
        "title": "High humidity",
        "text": "It feels muggy most days. Take breaks in air-conditioned malls and cafés."
      },
      {
        "icon": "☂️",
        "title": "Pack rain gear",
        "text": "A small umbrella or light rain jacket helps. Pavements can flood briefly after storms."
      },
      {
        "icon": "👕",
        "title": "What to wear",
        "text": "Light, breathable clothes and comfortable shoes. A light layer for strong indoor AC. Cover shoulders and knees at mosques and temples."
      }
    ]
  }
