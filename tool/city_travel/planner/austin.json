  "climate_guide": {
    "summary": "Subtropical: long hot summers, mild winters, and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: March to May and October to November",
        "text": "Mild to warm days around 21–29°C. Ideal for walking, parks and patios."
      },
      {
        "icon": "🥵",
        "title": "Summer is very hot (June to September)",
        "text": "Highs of 32–36°C. Go outside early or after sunset and carry water."
      },
      {
        "icon": "🌧️",
        "title": "Rain any month",
        "text": "About 8–16 rain days a month, most in May. Showers are often short."
      },
      {
        "icon": "🌡️",
        "title": "Warm nights in summer",
        "text": "Lows stay near 22–25°C from June to September, so evenings stay hot."
      },
      {
        "icon": "🧥",
        "title": "Cool winter nights",
        "text": "December to February lows near 6–8°C. Bring a jacket for evenings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
