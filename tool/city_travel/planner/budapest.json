  "climate_guide": {
    "summary": "Continental climate: cold winters, warm summers, and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days from about 21°C to 28°C. Ideal for walking, the river and outdoor bars."
      },
      {
        "icon": "🥶",
        "title": "Cold winters (December to February)",
        "text": "Highs of 4–8°C and lows near or below freezing. Wear a warm coat, hat and gloves."
      },
      {
        "icon": "🌂",
        "title": "Rain any month",
        "text": "Expect roughly 8–12 rainy days each month. Carry a small umbrella year-round."
      },
      {
        "icon": "🌡️",
        "title": "Summer heat is mild",
        "text": "July and August peak near 28°C, not extreme. Mornings and evenings are the best times out."
      },
      {
        "icon": "🍂",
        "title": "Spring and autumn are sweet spots",
        "text": "April–May and September–October give mild temperatures and fewer crowds."
      },
      {
