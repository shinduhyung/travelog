  "climate_guide": {
    "summary": "Cool, windy maritime climate: mild summers, cool winters and rain in every month. Wind is the constant.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to February",
        "text": "Warmest and driest, highs around 18–20°C with about 7 rain days a month. Best for the coast and gardens."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Every month has rain days, peaking around 14 in July and August. Carry a small umbrella or rain jacket daily."
      },
      {
        "icon": "💨",
        "title": "Windy city",
        "text": "Wellington is known for strong wind. A windproof layer matters more than an umbrella on exposed waterfront walks."
      },
      {
        "icon": "🧥",
        "title": "Cool winters (June to August)",
        "text": "Highs near 12–13°C and lows around 8–9°C. Bring a warm coat, especially for evening ferries and the south coast."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not hot, summers",
        "text": "Even in January highs stay near 20°C. Layers work better than summer beachwear for most days."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Waterproof jacket, warm mid-layer, comfortable walking shoes and sunglasses. Add a hat and sunscreen for summer."
      }
    ]
