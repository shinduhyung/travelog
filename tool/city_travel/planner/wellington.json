  "transit": {
    "best": "Walk the compact centre; use Metlink buses for hills and suburbs.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram in the city. Don't plan around rail inside Wellington."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Metlink buses and suburban trains cover the city. Pay with a Snapper card or contactless card. Cash fares are about $3–6 by zone; card is cheaper. Day passes cost about $13–30 by zones, after 9AM weekdays and all day weekends."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "Suburban trains run under Metlink with the same Snapper or contactless payment. Useful for trips out of the centre."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and DiDi work in Wellington. Taxis include Combined, Corporate, Green and Kiwi."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Handy for day trips out of the city. The compact centre is easier on foot, so pick up a car only when leaving town."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries cross the harbour and to Picton. Check times on the day."
      },
      {
        "mode": "Cable car",
        "has": true,
        "text: ": "The Kelburn cable car climbs from Lambton Quay to the Botanic Gardens. A quick, scenic way up the hill.",
        "text": ""
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The central city is compact and best on foot. The Golden Mile links the station to Courtenay Place."
      }
    ]
