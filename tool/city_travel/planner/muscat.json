  "climate_guide": {
    "summary": "Hot desert climate: sunny most of the year, very little rain, and a very hot, humid summer from May to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 25–29°C and cooler nights. Ideal for forts, the souq and wadi walks."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (May to September)",
        "text": "Highs of 36–39°C with warm nights. Do outdoor sights at sunrise or after dark."
      },
      {
        "icon": "💧",
        "title": "Humid near the coast",
        "text": "Muggy evenings in summer; the sea breeze helps but shade and water matter more."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "Only a few rain days a year, mostly December to March. No umbrella needed most trips."
      },
      {
        "icon": "🌪️",
        "title": "Dust and haze",
        "text": "Occasional dusty winds can haze the sky and make mountain or wadi trips less pleasant."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a hat and strong sunscreen; a light layer for cool winter nights and indoor AC; modest clothing for mosques."
      }
    ]
  }
