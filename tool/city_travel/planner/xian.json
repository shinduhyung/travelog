  "climate_guide": {
    "summary": "Four clear seasons: cold dry winters, hot humid summers with the most rain, and mild spring and autumn.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Mild days around 19–28°C. Ideal for the city wall, the Terracotta Army and walking the old town."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and wet (June to August)",
        "text": "Highs of 31–33°C with about 8–10 rain days a month. Go out early, carry water and an umbrella."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold and dry",
        "text": "January highs near 6°C and lows around -4°C. Few rainy days; pack a warm coat and layers."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in late summer and autumn",
        "text": "About 10 rain days a month from July to October. Showers are often short; a light rain jacket helps."
      },
      {
        "icon": "🌬️",
        "title": "Spring can be dusty",
        "text": "March to May sometimes brings dusty, hazy air. Check the air quality on the day if you have breathing issues."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, layers for cool mornings, sunscreen and a hat in summer, a warm coat in winter."
      }
    ]
  }
