  "climate_guide": {
    "summary": "Four clear seasons: cold dry winters, mild springs and autumns, and a hot, humid, rainy summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to June and September to October",
        "text": "Mild days around 20–26°C, good for beaches, old streets and coastal walks."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (July–August)",
        "text": "Highs of 27–29°C with 12–13 rain days a month. Plan indoor stops and early outings."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in midsummer",
        "text": "July and August are the wettest; carry a compact umbrella and check forecasts on the day."
      },
      {
        "icon": "🧥",
        "title": "Cold winters (December–February)",
        "text": "Highs of 4–6°C and lows near or below freezing. Bring a warm coat and layers."
      },
      {
        "icon": "🌊",
        "title": "Sea breezes",
        "text": "The coast stays breezy; a light windproof layer helps even in summer evenings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer, a rain layer in July–August, and warm layers for winter."
      }
