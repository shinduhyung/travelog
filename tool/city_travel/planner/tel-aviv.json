  "climate_guide": {
    "summary": "Mediterranean climate: hot, dry summers and mild, rainy winters. The beach season runs roughly May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: April to June and October",
        "text": "Warm days around 23–29°C with little rain. Ideal for the beach and walking the city."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (July to September)",
        "text": "Highs of 31–32°C and warm nights. Swim early, rest in the shade at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wet winter (December to February)",
        "text": "Around 10–12 rain days a month and highs of 17–20°C. Pack a jacket and umbrella."
      },
      {
        "icon": "🌂",
        "title": "Rain is seasonal",
        "text": "Almost none from June to September. Most rain falls between November and March."
      },
      {
        "icon": "🌊",
        "title": "Sea and beach",
        "text": "The sea is warmest in late summer. Check flags and lifeguard hours on the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
