  "climate_guide": {
    "summary": "Tropical city: hot all year, with a dry season roughly December to April and a very wet season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Highs 31-34°C, lows 23-25°C and only 3-10 rain days a month. Best for walking and markets."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "25-29 rain days a month. Showers are often heavy but short; streets can flood."
      },
      {
        "icon": "🥵",
        "title": "Hot year-round",
        "text": "Highs stay 30-35°C. March and April are hottest at 35°C. Plan outdoor sights for early morning."
      },
      {
        "icon": "🌂",
        "title": "Pack rain gear in the wet months",
        "text": "A light rain jacket or umbrella helps from May to October. Wear quick-dry shoes."
      },
      {
        "icon": "💧",
        "title": "Humid most days",
        "text": "Lows rarely drop below 23°C. Light, breathable clothes work all year."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, sunscreen, a hat and a refillable water bottle; add rain gear for May-October."
      }
    ]
