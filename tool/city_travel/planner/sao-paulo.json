    "best": "Metrô for long hops; Uber or 99 for late nights and hilly areas.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Modern, safe and the fastest way around. Lines 1–5 and 9 suit tourists."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Covers the whole city. Fares are R$5.30; Bilhete Único gives free transfers within 3 hours."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are metered; Guarucoop has a monopoly at GRU and fares are posted. Uber and 99 are widely used and usually cheaper."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is stressful. Traffic peaks 06:00–09:00 and 16:00–19:00, so avoid renting a car."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in central and Jardins areas. Bikes are popular too, with many cycleways."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "CPTM trains are modern and safe; Line 9 is useful for tourists."
      }
    ]
