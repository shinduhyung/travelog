  "climate_guide": {
    "summary": "Subtropical and mild year-round, with a dry, cool winter (Jun–Aug) and a wet, warm summer (Dec–Mar).",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: April to September",
        "text": "Milder days around 22–26°C and fewer rain days. July is the driest, with about 3 rain days."
      },
      {
        "icon": "🌧️",
        "title": "Summer is wet (Dec–Mar)",
        "text": "About 19–24 rain days a month. Storms are often short and heavy; keep indoor plans ready."
      },
      {
        "icon": "🧥",
        "title": "Winter nights are cool",
        "text": "June to August lows sit around 12–13°C. Days stay mild near 22°C. Bring a jacket."
      },
      {
        "icon": "🌂",
        "title": "Carry an umbrella in summer",
        "text": "Downpours come fast from December to March. A small umbrella beats waiting it out."
      },
      {
        "icon": "🌡️",
        "title": "No extreme heat",
        "text": "Highs stay around 22–27°C all year. It is rarely very hot or very cold."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket or umbrella, comfy walking shoes and a warm layer for winter evenings."
      }
    ]
  }
