  "transit": {
    "best": "Uber or a yellow metered taxi for most trips; Transmetro for cheap rides on main routes.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro. Transmetro is a bus rapid transit system, not rail."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Transmetro BRT has 7 lines. Pay with the Citizen's Card (Q20 with 5 trips) or a contactless card; cash is not accepted. Transurbano buses need a prepaid card and are slower but cover more routes. Avoid red city buses."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Yellow metered taxis (call 1766) or white taxis where you negotiate the price first. Uber works and is handy for airport and late-night rides."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Traffic is chaotic. Cars are available but not recommended for city driving."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Use caution. Walk accompanied where you can, and avoid quiet streets after dark."
      }
    ]
