  "climate_guide": {
    "summary": "Mild year-round at about 1,500 m. Two seasons: dry and cooler from November to April, wet from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to April",
        "text": "Highs around 22–28°C and few rain days. Ideal for walking Zona 1 and day trips."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "Rain on 18–24 days a month, usually afternoon showers. Do outdoor sights in the morning."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not hot",
        "text": "Highs stay between 22 and 28°C all year. Nights are cool, around 12–16°C."
      },
      {
        "icon": "🧥",
        "title": "Cool evenings",
        "text": "Lows near 12–13°C in December to February. Bring a light jacket."
      },
      {
        "icon": "☔",
        "title": "Pack for rain in the wet months",
        "text": "A compact umbrella and a dry bag for your phone help in June to September."
      },
      {
        "icon": "🧴",
        "title": "Sun at altitude",
        "text": "The city sits high, so the sun is strong even on mild days. Use sunscreen and a hat."
      }
    ]
  }
