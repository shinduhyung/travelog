  "climate_guide": {
    "summary": "Four clear seasons: cold, dry winters, a hot humid summer and a rainy spell in June–July. Spring and autumn are the best times to walk.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: spring and autumn",
        "text": "April and November bring mild days around 16–22°C and the famous blossoms and leaves. Book early."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "July and August reach 30–32°C with many rain days. Sightsee at sunrise and rest in the afternoon."
      },
      {
        "icon": "🌧️",
        "title": "Rainy season in June–July",
        "text": "Around 15–18 rain days. Showers are often short; a small umbrella is enough."
      },
      {
        "icon": "❄️",
        "title": "Cold, dry winter",
        "text": "January lows near -1°C. Days are clear and quiet; temples are far less crowded."
      },
      {
        "icon": "🍂",
        "title": "Autumn is the busiest",
        "text": "November has only about 7 rain days but huge crowds at maple spots. Go early morning."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a light rain jacket, and layers for cool mornings. Add a warm coat for December–February."
      }
    ]
  }
