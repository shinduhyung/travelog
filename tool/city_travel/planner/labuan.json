  "climate_guide": {
    "summary": "Tropical and hot all year, with rain in every month. February is the driest; October to December the wettest.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Warm all year",
        "text": "Days sit around 29–30°C and nights around 25–26°C. No cool season."
      },
      {
        "icon": "🌧️",
        "title": "Rain every month",
        "text": "Expect 18–27 rain days a month. Showers are often short but heavy."
      },
      {
        "icon": "☂️",
        "title": "Best odds: February",
        "text": "About 18 rain days, the lowest of the year. Still bring a rain jacket."
      },
      {
        "icon": "🌊",
        "title": "Wettest: October to December",
        "text": "Around 27 rain days each month. Sea trips may be cancelled."
      },
      {
        "icon": "👕",
        "title": "What to pack",
        "text": "Light, quick-dry clothes, sandals, a rain jacket or umbrella, and sunscreen."
      },
      {
        "icon": "⛴️",
        "title": "Ferry weather",
        "text": "Heavy rain and rough seas can delay boats. Check schedules on the day."
