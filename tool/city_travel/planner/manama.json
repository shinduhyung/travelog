  "transit": {
    "best": "Buses for cheap trips, ride apps or taxis for speed; rent a car if you plan to explore the island.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Bahrain Public Transport runs routes across the city; route A1 links the airport and Manama every 20 minutes. Single fare 300 fils paper, or 250 fils with a Go Card; daily cap 600 fils. Weekly pass BD 3 and 28-day pass BD 12 need a personalised Go Card from a terminal office."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are metered but pricey; airport rides add BD 2 and hotel pickups add BD 1. Uber and Careem work in Bahrain."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Renting a car is cheaper than relying on taxis for a full day of sightseeing."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in the souq and old town in the cooler months. Use a bus or taxi for longer hops in summer."
      }
    ]
  },
  "climate_guide": {
    "summary": "Hot desert climate: long, very hot summers, mild winters and almost no rain.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 20–28°C and cooler evenings. Ideal for the souq, the fort and walking."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs of 37–39°C. Stay indoors at midday and go out early or after dark."
      },
      {
        "icon": "💧",
        "title": "Humid by the water",
        "text": "Muggy evenings from May to October, especially along the corniche."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "A few short showers between December and March. No umbrella needed most of the year."
      },
      {
        "icon": "🌪️",
        "title": "Dusty winds",
        "text": "Occasional sand haze in spring and early summer can dull the sky."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a hat and sunscreen; a light layer for winter nights and indoor AC; modest clothing for mosques."
