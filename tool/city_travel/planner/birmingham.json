  "climate_guide": {
    "summary": "Temperate and changeable: mild summers, cool wet winters, and rain possible in any month.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 11–14 rain days every month. Showers are often short; carry a small umbrella."
      },
      {
        "icon": "🌡️",
        "title": "Mild summers",
        "text": "July and August peak near 20–21°C. Rarely hot; evenings cool to about 12°C."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "January and February highs near 7–8°C, lows around 2°C. A warm coat is essential."
      },
      {
        "icon": "🌤️",
        "title": "Best months",
        "text": "May to September is warmest and brightest, though rain never stops entirely."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for wet pavements."
      },
      {
        "icon": "☁️",
        "title": "Grey skies are normal",
        "text": "Overcast days are common. Plan indoor backups like museums and food halls."
      }
    ]
