  "transit": {
    "best": "Use Uber, Bolt or a taxi with the fare agreed first; TroTros are the cheap local option.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram in Accra. Don't plan around rail."
      },
      {
        "mode": "TroTro",
        "has": true,
        "text": "Minibuses are the main public transport. They run fixed routes and a 'mate' calls out destinations. Cheap but crowded."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis rarely use meters, so agree the fare before you ride. Uber, Bolt, Yango and InDrive all work and are easy to book."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Hiring a car with a driver is common for sightseeing. Self-driving is possible but traffic is heavy."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine by day in areas like Osu. Watch for open drains and fast traffic; avoid unlit streets at night."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year, around 27–31°C by day. A long rainy season runs roughly May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to February",
        "text": "Warm days near 31°C and the fewest rain days, about 4–8 a month. Ideal for walking and the beaches."
      },
      {
        "icon": "🌧️",
        "title": "Rainy season May to October",
        "text": "Rain days peak at about 24 in June. Showers are often heavy but short; carry a rain jacket."
      },
      {
        "icon": "🌡️",
        "title": "Hot and humid year-round",
        "text": "Lows stay around 23–25°C, so nights are warm. Light, breathable clothes work best."
      },
      {
        "icon": "🌂",
        "title": "Pack an umbrella",
        "text": "From May to October, expect wet afternoons. A compact umbrella and dry bag help."
      },
      {
        "icon": "🚗",
        "title": "Rain slows traffic",
        "text": "Heavy rain floods roads and jams traffic. Build extra time into taxi rides in the wet months."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, sunscreen, a hat, mosquito repellent for evenings, and a light layer for air-conditioned rooms."
      }
    ]
  }
