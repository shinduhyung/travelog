  "climate_guide": {
    "summary": "Four clear seasons: cold winters, warm summers and mild spring and autumn. Rain is spread through the year.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best time: May, June and September",
        "text": "Highs around 19–25°C with long days. Comfortable for walking the castle and old town."
      },
      {
        "icon": "❄️",
        "title": "Winter is cold (December to February)",
        "text": "Highs of 4–7°C and lows near or below freezing. Pack a warm coat, hat and gloves."
      },
      {
        "icon": "☔",
        "title": "Rain all year",
        "text": "About 8–12 rain days every month. A small umbrella or rain jacket is always useful."
      },
      {
        "icon": "🥾",
        "title": "Cobblestones need good shoes",
        "text": "The old centre is paved with uneven stones. Wear comfortable, grippy shoes, especially when wet."
      },
      {
        "icon": "🌤️",
        "title": "Summer is warm, not extreme",
        "text": "July and August peak near 26°C. Start sightseeing early and take a midday break."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for changeable days, a waterproof layer, walking shoes and a warm coat for winter."
      }
    ]
  }
