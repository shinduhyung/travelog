    "best": "Walk the centre; use metro and trams for longer hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Three lines (A, B, C) run roughly 05:00–24:00. Fast for crossing the city; not needed inside the old centre."
      },
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "Trams cover the centre well. Buy tickets at yellow machines or in apps. A 90-minute ticket costs about 50 CZK; a 24-hour ticket about 150 CZK."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses mostly serve the outskirts and the airport. Use metro and trams for sightseeing."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Bolt work in Prague. Use them to avoid taxi touts."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving in the centre is slow and parking is restricted. Use P+R lots and take transit in."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre is walkable. Charles Bridge and Old Town are best on foot."
      }
    ]
