  "climate_guide": {
    "summary": "Mild, changeable weather with rain in every month. Summers are warm, not hot; winters are cold and grey.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best months: May to September",
        "text": "Highs around 19–26°C. Long daylight and the best odds of dry, pleasant days."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 9–13 rain days every month. Showers are often short; carry a small umbrella."
      },
      {
        "icon": "❄️",
        "title": "Cold winters",
        "text": "December to February highs of 7–10°C and lows near 2°C. Warm coat, scarf and layers."
      },
      {
        "icon": "☀️",
        "title": "Warm, not hot, summers",
        "text": "July peaks near 26°C. Comfortable for walking, but book popular sights ahead in peak season."
      },
      {
        "icon": "🧥",
        "title": "Pack layers",
        "text": "Mornings and evenings are cooler than midday. A light jacket works most of the year."
      },
      {
        "icon": "👟",
        "title": "Wear good shoes",
        "text": "You will walk a lot on cobbles and stone. Waterproof shoes help on wet days."
      }
    ]
