  "climate_guide": {
    "summary": "Semi-arid climate with hot summers and mild winters. Rain is modest but peaks in May and September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Mild days around 19–26°C and cool evenings. Good for walking the Macroplaza and parks."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot (June to August)",
        "text": "Highs around 33–34°C. Do outdoor sights early morning; use air-conditioned museums midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in May and September",
        "text": "About 11 rain days in each. Showers are often short; carry a light rain jacket."
      },
      {
        "icon": "🌡️",
        "title": "Big day–night swing in winter",
        "text": "January lows near 9°C and highs near 19°C. Layer up."
      },
      {
        "icon": "💧",
        "title": "Humidity in summer",
        "text": "June to September feel muggy. Drink water and take breaks."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes for summer, a warm layer for winter nights, sunscreen, and a light rain layer for May and September."
