  "climate_guide": {
    "summary": "Delhi has hot summers, a wet monsoon from July to September, and cool, dry winters. October to March is the comfortable window.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: October to March",
        "text": "Mild days around 19–32°C and cool evenings. Ideal for forts, bazaars and long walks."
      },
      {
        "icon": "🥵",
        "title": "Summer is brutal (April to June)",
        "text": "Highs of 36–39°C. Sightsee at sunrise, then stay indoors or in the Metro at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon (July to September)",
        "text": "Up to 23 rain days in July. Short heavy downpours, humid air and slow traffic. Carry a light rain jacket."
      },
      {
        "icon": "🌫️",
        "title": "Winter fog",
        "text": "December and January mornings can be foggy, which delays flights and trains. Build in buffer time."
      },
      {
        "icon": "🧥",
        "title": "Cold nights in winter",
        "text": "January lows near 8°C. Bring a warm layer for evenings; many hotels have weak heating."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton for summer, a rain jacket for monsoon, warm layers for winter. Modest clothing for temples and mosques, plus comfortable shoes."
      }
    ]
  }
