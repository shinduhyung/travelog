  "climate_guide": {
    "summary": "Temperate climate with cold winters and mild, wet summers. Rain falls year-round, so pack layers and an umbrella.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 18–25°C make walking and outdoor sights comfortable. July and August are warmest."
      },
      {
        "icon": "🥶",
        "title": "Cold winters (December to February)",
        "text": "Highs of 2–5°C and lows down to -3°C. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 10–14 rain days every month. July is the wettest at about 14 days."
      },
      {
        "icon": "🌂",
        "title": "Pack an umbrella",
        "text": "Showers are common in every season. A light waterproof layer helps in spring and autumn."
      },
      {
        "icon": "🌡️",
        "title": "Big swings in spring and autumn",
        "text": "April and October can be mild by day and cool at night. Dress in layers."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a rain jacket and warm layers for winter. Summer needs only light clothes plus something for cool evenings."
