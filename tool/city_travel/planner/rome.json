  "transit": {
    "best": "Walk the centre; use the metro and buses for longer hops and taxis for late nights.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Two main lines (A and B) plus a short branch. Useful but limited coverage; good for the Vatican and Colosseum areas."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Trams and city buses fill the gaps. Buy tickets before boarding."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis use fixed airport fares and meters in town. Uber works in Rome."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Driving in the centre is chaotic and ZTL cameras fine you. Don't do it."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The best way to see the centre. Bikes and scooters are common."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "No ferry needed in the city; cruise ships dock at Civitavecchia, reached by train."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mediterranean climate: hot, dry summers and mild, wetter winters. Spring and autumn are the sweet spots.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best months: April–May and September–October",
        "text": "Highs of 20–27°C with manageable rain. Ideal for walking between sights."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and dry",
        "text": "July and August hit 33°C with only 4–5 rain days. Plan outdoor sights for early morning."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in autumn and early spring",
        "text": "November has about 13 rain days, March 11. Showers are often short; carry a small umbrella."
      },
      {
        "icon": "🧥",
        "title": "Winter is cool, not freezing",
        "text": "January highs near 12°C and lows around 4°C. A warm coat and layers are enough."
      },
      {
        "icon": "👟",
        "title": "Wear good shoes",
        "text": "Cobblestones and long museum days mean a lot of walking in any season."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers in spring and autumn, sun hat and water bottle in summer, warm coat and umbrella in winter. Cover shoulders and knees for churches."
      }
    ]
  }
