  "climate_guide": {
    "summary": "Temperate climate with cold winters and mild summers. Rain is spread through the year, so pack layers.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs around 19–25°C and lows of 9–16°C. Best for walking, parks and outdoor sights."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs of 4–6°C and lows near or below freezing. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 8–14 rain days a month. No dry season; carry a small umbrella or rain jacket."
      },
      {
        "icon": "🌂",
        "title": "Wettest months",
        "text": "January and December have the most rain days, around 12–14. Plan indoor backups."
      },
      {
        "icon": "🍂",
        "title": "Spring and autumn are mild",
        "text": "April and October sit around 14–15°C highs. Good for sightseeing with fewer crowds."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes. Add a warm coat and gloves for November to March."
      }
    ]
  }
