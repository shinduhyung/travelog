  "climate_guide": {
    "summary": "Tropical and hot all year: highs near 29–30°C, lows near 24–25°C, and rain on most months.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Warm every month",
        "text": "Highs stay around 29–30°C and lows around 24–25°C. No cool season."
      },
      {
        "icon": "🌧️",
        "title": "Rain is common",
        "text": "Expect 18–28 rain days a month. February is the driest; May, November and December are the wettest."
      },
      {
        "icon": "☔",
        "title": "Short heavy showers",
        "text": "Downpours often pass quickly. Carry a small umbrella and use covered walkways."
      },
      {
        "icon": "💦",
        "title": "High humidity",
        "text": "It feels hotter than the numbers. Drink water and take breaks in air-conditioning."
      },
      {
        "icon": "🌤️",
        "title": "Best outdoor months",
        "text": "February and July–September have fewer rain days. Still plan around afternoon storms."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, sandals or quick-dry shoes, an umbrella and sunscreen. A light layer for cold indoor AC."
      }
    ]
  }
