  "climate_guide": {
    "summary": "Continental climate with four clear seasons: cold winters, warm dry summers and a wet spring.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days from 21°C to 28°C. Ideal for walking the city and hiking Vitosha."
      },
      {
        "icon": "🥶",
        "title": "Cold winters (December to February)",
        "text": "Highs of 5–9°C and lows below freezing. Snow is possible. Pack a warm coat, hat and boots."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in spring",
        "text": "May has about 14 rain days. Showers pass quickly; carry a small umbrella."
      },
      {
        "icon": "🌞",
        "title": "Driest in late summer",
        "text": "July, August and September have only 5–6 rain days. Reliable sunshine."
      },
      {
        "icon": "🍂",
        "title": "Mild, pleasant autumn",
        "text": "September and October stay at 18–24°C. Good light and fewer crowds."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable shoes for uneven pavements, layers for cool evenings, and a rain jacket in spring and autumn."
      }
    ]
  }
