  "transit": {
    "best": "Metro for most trips; Didi for late nights and sights off the metro lines.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "7 lines, fares ¥2–9. First trains around 06:00, last around 23:00 (the Chengjiao line ends at 22:00). Cheap and easy for the centre and the station."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "¥1–2 per ride with an extensive network and BRT lines. Cheap but slower than the metro."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis: flagfall ¥8 day, ¥10 night, then ¥1.5/km after 2 km. Meters are used but watch for cheating. Didi works widely; Uber and similar international apps do not."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Not recommended for visitors: heavy traffic and complex rules. Use metro, taxis and Didi instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Central areas are walkable and shared bikes are available, but the city is spread out. Use the metro for longer hops."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, dry winters and hot, humid summers with the most rain in July and August.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May and October",
        "text": "Highs around 21–29°C and fewer rain days. Ideal for the museum, ruins and day trips."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 31–33°C with the most rain days. Plan indoor sights at midday and carry water."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in July and August",
        "text": "Around 12 rain days each month. Pack a light umbrella and a rain jacket."
      },
      {
        "icon": "❄️",
        "title": "Cold, dry winter (December to February)",
        "text": "Highs of 7–11°C and lows near or below freezing. A warm coat and layers are essential."
      },
      {
        "icon": "🍂",
        "title": "Clear autumn",
        "text": "September and October turn drier and milder, with highs of 21–28°C. Great for outdoor sights."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, light breathable clothes and rain gear for summer. Comfortable shoes for temple and ruins visits."
      }
    ]
  }
