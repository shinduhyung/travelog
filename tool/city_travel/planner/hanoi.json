  "transit": {
    "best": "Grab for cars and motorbike taxis; walk in the Old Quarter.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Line 2A runs Cat Linh to Yen Nghia; Line 3 runs Cau Giay to Nhon. Fares are distance-based, about 8,000–15,000 VND; tap contactless cards at gates."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses are cheap and air-conditioned, about 7,000–12,000 VND per ride."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Grab works well for cars and motorbike taxis; fares are fixed in the app. Metered taxis: Mai Linh and Taxi Group are reliable; flag-fall about 20,000 VND."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not practical for most visitors: chaotic traffic and hard parking. Use Grab or taxis instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Fine in the Old Quarter, but crossing takes nerve. Traffic is chaotic; take your time at crossings."
      }
    ]
  },
  "climate_guide": {
    "summary": "Subtropical Hanoi: mild, drier winters and hot, very wet summers. Rain peaks from July to September.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: October to April",
        "text": "Milder days around 21–29°C and fewer rain days. Good for walking the Old Quarter."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (May to September)",
        "text": "Highs of 31–33°C with many rain days. Sightsee early morning and after showers."
      },
      {
        "icon": "🌧️",
        "title": "Wettest months: July to September",
        "text": "Around 21–24 rain days a month. Showers can be heavy; keep a raincoat handy."
      },
      {
        "icon": "🧥",
        "title": "Cool winter (December to February)",
        "text": "Highs near 21–22°C and lows around 14–15°C. Bring a jacket for evenings."
      },
      {
        "icon": "☂️",
        "title": "Rain is often short",
        "text": "Even in wet months, showers pass. Plan indoor stops like museums and cafés as backup."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a raincoat or umbrella, comfortable shoes for uneven streets, and a warm layer for winter."
      }
    ]
  }
