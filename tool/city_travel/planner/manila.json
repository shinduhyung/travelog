  "transit": {
    "best": "LRT Line 1 for the old sights, plus ride apps for everything else.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "LRT Line 1 (green) links Malate, Ermita, Quiapo, Binondo and Santa Cruz, where most sights sit. LRT Line 2 (blue) serves Quiapo, Sampaloc and Santa Mesa; trains are packed at rush hour."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses start around PHP 16 and provincial buses around PHP 12. Route numbers are shown on the bus."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Grab, Angkas, Gojek, Joyride and MyTaxi.PH work. Taxis are plentiful but insist on the meter."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not recommended for first-timers: heavy traffic and hard parking. Use apps and rail instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good inside Intramuros and around Rizal Park. Sidewalks are uneven and hot at midday; cross with care."
      },
      {
        "mode": "Jeepney",
        "has": true,
        "text": "From about PHP 10 for the first 4 km. Routes are painted on the sides, not numbered, so ask the driver."
      },
      {
        "mode": "Tricycle / pedicab / calesa",
        "has": true,
        "text": "Short trips only. A one-hour calesa ride in the old city costs around PHP 50–70; agree the price first."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year, with a clear dry season from January to April and a long wet season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: January to April",
        "text": "Highs of 29–33°C and the fewest rain days, from 6 to 10 a month. Best for walking the old city."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: June to October",
        "text": "Rain on 25–28 days a month. Showers are often heavy and short; plan indoor stops and check roads on the day."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid year-round",
        "text": "Lows stay around 23–26°C, so nights are warm. April is the hottest month at 33°C highs."
      },
      {
        "icon": "🌂",
        "title": "Carry rain gear in the wet months",
        "text": "A light rain jacket or umbrella helps from May to October. Streets can flood briefly after heavy rain."
      },
      {
        "icon": "🌀",
        "title": "Typhoon season",
        "text": "Storms are most likely from June to November. Check forecasts before day trips and keep plans flexible."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light, breathable clothes, sunscreen and a hat; a rain layer for the wet months; comfortable shoes for uneven old-city streets."
      }
    ]
  }
