  "climate_guide": {
    "summary": "Subtropical and humid: mild winters, hot sticky summers, and rain in most months.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: October to December",
        "text": "Mild highs of 17–26°C and fewer rain days. Good for walking the old lanes."
      },
      {
        "icon": "🌧️",
        "title": "Rain is common",
        "text": "Expect 7–20 rain days a month. June and August are the wettest. Carry a small umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "July peaks near 34°C with lows around 26°C. Plan indoor sights at midday."
      },
      {
        "icon": "🧥",
        "title": "Mild but cool winters",
        "text": "January and February highs around 16°C, lows near 8°C. A jacket is enough."
      },
      {
        "icon": "💦",
        "title": "Humidity all year",
        "text": "Sticky from May to September. Light, breathable clothes work best."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket or umbrella, and comfortable shoes for wet lanes and hills."
      }
