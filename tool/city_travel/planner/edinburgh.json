  "climate_guide": {
    "summary": "Cool and changeable: mild summers, cold winters and rain in every month. Rarely very hot or very cold.",
    "items": [
      {
        "icon": "🌦️",
        "title": "Rain any month",
        "text": "Expect rain on roughly 12–17 days each month. Showers pass quickly; carry a light waterproof."
      },
      {
        "icon": "🌡️",
        "title": "Mild summers",
        "text": "July and August highs sit near 18°C, lows near 12°C. Rarely hot; layers help."
      },
      {
        "icon": "🥶",
        "title": "Cold winters",
        "text": "January highs near 6°C, lows near 2°C. Wind off the sea makes it feel colder; bring a warm coat."
      },
      {
        "icon": "🌬️",
        "title": "Windy and exposed",
        "text": "Hills and the coast are breezier. A windproof layer matters more than an umbrella."
      },
      {
        "icon": "☀️",
        "title": "Long summer days",
        "text": "June and July give very long daylight, so late walks are easy. Winter days are short."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Waterproof jacket, layers, comfortable walking shoes for cobbles and hills, and a warm hat in winter."
      }
