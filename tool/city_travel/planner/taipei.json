  "climate_guide": {
    "summary": "Subtropical and humid. Summers are hot and wet; winters are mild but grey and damp. Rain falls in every month.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 11–21 rain days each month. June is the wettest. Always carry a small umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "July and August reach about 33°C with high humidity. Plan indoor sights at midday."
      },
      {
        "icon": "🌤️",
        "title": "Best months: October to April",
        "text": "Highs of 19–27°C and less intense heat. Best for walking and day trips."
      },
      {
        "icon": "🧥",
        "title": "Mild winter",
        "text": "January and February sit around 14–20°C. A light jacket is enough; indoor spaces can feel cold."
      },
      {
        "icon": "☂️",
        "title": "Typhoon season",
        "text": "Late summer and early autumn can bring storms. Check forecasts on the day and keep plans flexible."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket or umbrella, and comfortable shoes. Add a warm layer for winter evenings."
      }
    ]
  }
