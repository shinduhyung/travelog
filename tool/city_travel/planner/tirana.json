    "best": "Walk the compact centre; use taxis or ride apps for longer hops and buses to save money.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses are the main public transport. A single ticket costs 40 lek, sold on board by a conductor."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Flag-fall 300 lek; a cross-town ride is 400–800 lek. Demand the meter. Apps like Speed Taxi, Patoko, Clust and VrapOn work like Uber."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Useful for day trips outside the city. Traffic in the centre is busy; check parking at your hotel."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best way to see the compact centre. Sidewalks can be uneven, so watch your step."
      },
      {
        "mode": "Bike",
        "has": true,
        "text": "Bike lanes exist on some main streets, but cycling can be risky due to traffic."
      }
    ]
