  "climate_guide": {
    "summary": "Mediterranean with hot, dry summers and cool, wet winters. Spring and autumn are the sweet spots.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to June and September to October",
        "text": "Highs of 22–28°C and fewer rainy days. Ideal for walking the centre and day trips."
      },
      {
        "icon": "🥵",
        "title": "July and August are hot",
        "text": "Highs around 32°C and lows near 20°C. Do sights in the morning, rest at midday, go out in the evening."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in autumn and early spring",
        "text": "May and November see about 11–14 rain days. Showers are often short; carry a small umbrella."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "December to February highs of 11–14°C and lows near 2–4°C. Pack layers and a warm coat."
      },
      {
        "icon": "🌂",
        "title": "Rain is spread across the year",
        "text": "No month is fully dry. Even summer has a few wet days, so a light rain jacket helps."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable shoes for uneven sidewalks, layers for cool evenings, sunscreen for summer, and an umbrella in spring and autumn."
      }
    ]
  }
