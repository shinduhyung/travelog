  "climate_guide": {
    "summary": "Four clear seasons. Hot, humid summers and cold winters. Spring and autumn are the best times to walk the city.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to June and September to October",
        "text": "Highs of 16–26°C. Comfortable for walking and parks. These are the busiest months."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (July to August)",
        "text": "Highs near 28–30°C with muggy nights. Plan indoor sights at midday and walk in the morning or evening."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold (December to February)",
        "text": "Highs of 4–7°C and lows near or below 0°C. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain is spread through the year",
        "text": "About 8–13 rain days a month. April and July are the wettest. Carry a small umbrella."
      },
      {
        "icon": "🍂",
        "title": "Autumn is crisp and clear",
        "text": "October highs near 19°C and fewer rain days. Great for parks and skyline views."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, layers, a rain jacket and sunscreen for summer. A warm coat for winter."
      }
    ]
  }
