  "climate_guide": {
    "summary": "Continental climate with cold winters and warm summers. The mountains nearby make weather change fast.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days from 22°C to 31°C. Ideal for mountain trips, parks and long walks."
      },
      {
        "icon": "🥶",
        "title": "Winter is properly cold",
        "text": "December to February: highs near 0°C, lows to -9°C. Bring a heavy coat, hat and boots."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in spring",
        "text": "March has about 13 rain days. April and May are also showery. A light rain jacket helps."
      },
      {
        "icon": "⛰️",
        "title": "Mountains are cooler",
        "text": "Higher trails and the lake sit well above the city. Take a warm layer even in summer."
      },
      {
        "icon": "🌡️",
        "title": "Big day-to-night swing",
        "text": "Evenings drop sharply, often 10°C or more. Carry a jacket for after sunset."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, comfortable walking shoes, sunscreen and sunglasses; winter boots and gloves from November to March."
      }
    ]
