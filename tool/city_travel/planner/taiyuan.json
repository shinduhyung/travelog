  "climate_guide": {
    "summary": "Continental climate with cold, dry winters and warm summers; most rain falls in July and August.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to June and September to October",
        "text": "Mild highs of 17–26°C and fewer rain days. Good for temples and walking."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold and dry",
        "text": "December to February highs are only 3–7°C with lows below freezing. Pack a heavy coat."
      },
      {
