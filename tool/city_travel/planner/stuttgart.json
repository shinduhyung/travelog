  "climate_guide": {
    "summary": "Temperate continental climate: cold winters, warm summers, and rain in every month. No month is reliably dry.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best months: May to September",
        "text": "Highs of 18–25°C make walking and vineyard trips comfortable. July and August are warmest."
      },
      {
        "icon": "❄️",
        "title": "Cold winters",
        "text": "December to February highs of 5–8°C and lows near or below freezing. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 10–14 rain days every month. January and December are wettest; September is driest."
      },
      {
        "icon": "🧥",
        "title": "Pack layers",
        "text": "Days can warm up and cool down fast, especially in spring and autumn. A light waterproof layer helps."
      },
      {
        "icon": "🍂",
        "title": "Mild shoulder seasons",
        "text": "April, May and September are pleasant but changeable. Check the forecast each morning."
      },
      {
        "icon": "☀️",
        "title": "Long summer evenings",
        "text": "June to August stay light late, good for beer gardens and outdoor walks after dinner."
      }
    ]
  }
