  "climate_guide": {
    "summary": "Humid subtropical: cold winters, hot humid summers, and the most rain in July. Spring and autumn are the best seasons.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Highs around 22–29°C with moderate rain. Ideal for parks, lakes and walking."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 30–32°C and lows near 21–25°C. Muggy nights; do outdoor sights early or late."
      },
      {
        "icon": "🌧️",
        "title": "Wettest month is July",
        "text": "About 16 rain days. Keep an umbrella and a backup indoor plan."
      },
      {
        "icon": "🧥",
        "title": "Cold winter (December to February)",
        "text": "Highs of 8–11°C and lows near 0–1°C. Bring a warm coat; indoor heating can be limited."
      },
      {
        "icon": "☂️",
        "title": "Rain is spread through the year",
        "text": "Most months have 8–11 rain days. A small umbrella is worth packing any month."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers in spring and autumn, breathable clothes and sunscreen for summer, a warm coat for winter, and rain gear in July."
      }
    ]
  }
