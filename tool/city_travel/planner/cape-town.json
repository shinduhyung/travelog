  "climate_guide": {
    "summary": "Mediterranean climate: warm, dry summers and cool, wet winters. Wind and cloud can change mountain plans fast.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Warm, mostly dry days around 22–26°C. Ideal for beaches, Table Mountain and the Winelands."
      },
      {
        "icon": "🌧️",
        "title": "Wettest: June to August",
        "text": "Around 10–11 rain days a month and highs near 16–17°C. Keep indoor plans ready."
      },
      {
        "icon": "💨",
        "title": "Windy days",
        "text": "The Cape is windy, especially in summer. Check the cableway status before heading up Table Mountain."
      },
      {
        "icon": "🌊",
        "title": "Cold Atlantic water",
        "text": "The sea stays cold even in summer. Bring a wetsuit or swim briefly at Camps Bay."
      },
      {
        "icon": "🧥",
        "title": "Cool evenings",
        "text": "Nights drop to 10–18°C. A light jacket helps year-round."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, sunscreen, a hat, a rain jacket for winter, and sturdy shoes for hiking."
      }
    ]
  }
