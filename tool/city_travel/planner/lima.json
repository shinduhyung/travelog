  "transit": {
    "best": "Ride apps or agreed-price taxis for most trips; walk in Miraflores and Barranco.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Line 1 is elevated and runs north-south east of the centre. It misses most tourist areas, so it is rarely useful for visitors."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Metropolitano is a fast bus rapid transit with dedicated lanes. Card costs S/4.5 and the fare is S/2.50. City buses and combis are cheap but confusing; agree the fare first."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber, DiDi and Cabify work in Lima; check the driver name and plate before getting in. Street taxis have no meters: agree the price first and confirm soles, not dollars."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is chaotic. Only rent if you plan to leave the city; parking and traffic are hard."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Fine in Miraflores and Barranco, and bike lanes are growing. Use care in the historic centre at night."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mild desert coast: warm and sunny December to April, cool and grey May to November. Rain is rare; the fog is the main weather story.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to April",
        "text": "Warm days around 23–26°C and little rain. Best for the beach and long walks."
      },
      {
        "icon": "🌫️",
        "title": "Grey season (May to November)",
        "text": "Cool, damp fog called garúa. Highs drop to about 19–22°C and the sun is rare. Pack a jacket."
      },
      {
        "icon": "🌂",
        "title": "Very little rain",
        "text": "Most months see zero rain days. March is the wettest with about 7 days, still light."
      },
      {
        "icon": "🌊",
        "title": "Cold sea",
        "text": "The Pacific here is chilly most of the year. Swimming is for the brave; beaches south are warmer in summer."
      },
      {
        "icon": "🧥",
        "title": "Layers, not umbrellas",
        "text": "Mornings are damp and cool even in summer. A light jacket and comfortable shoes work all year."
      },
      {
        "icon": "🧴",
        "title": "Sun in summer",
        "text": "December to April the sun is strong. Use sunscreen and a hat on the malecón and at ruins."
      }
    ]
  }
