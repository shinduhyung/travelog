  "transit": {
    "best": "Ride apps (Uber, Bolt) for most trips; BRT buses and the Blue Line rail if you're saving money.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Blue Line rail runs Marina to Mile 2; fare about ₦375, Cowry Card only."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "BRT buses use dedicated lanes; cash not accepted, buy a Cowry Card (₦500–1,000)."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber and Bolt work widely; taxis are metered or negotiated. Agree the price first."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not recommended for first-time visitors; traffic is heavy and driving rules are loosely followed."
      },
      {
        "mode": "Walking",
        "has": false,
        "text": "Only in a few central areas. The city is spread out and pavements are uneven."
      },
      {
        "mode": "Danfo minibus",
        "has": true,
        "text": "Yellow minibuses cover most routes; fares start around ₦50 and rise with distance. Cash only."
      },
      {
        "mode": "Okada (motorbike taxi)",
        "has": true,
        "text": "Quick but risky, and banned in many districts and after dark. Avoid unless you know the area."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries link Lagos Island, Banana Island, Mile 2 and the mainland. A fast way to skip traffic."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical climate: hot all year, with a long wet season from roughly April to October and a drier stretch from November to March.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to February",
        "text": "Warm days around 32°C and the fewest rain days (5–8). Ideal for beaches, markets and walking."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: April to October",
        "text": "Rain days climb to 22–28 a month. Downpours are often short but heavy; carry a rain jacket."
      },
      {
        "icon": "🌡️",
        "title": "Hot and humid all year",
        "text": "Highs stay between 27 and 32°C, lows near 24–26°C. Humidity makes it feel hotter."
      },
      {
        "icon": "🚗",
        "title": "Flooding slows traffic",
        "text": "In the wettest months (June, September, October) roads can flood. Allow extra time and avoid low-lying routes."
      },
      {
        "icon": "🌊",
        "title": "Beach days need timing",
        "text": "Beaches are best in the dry months. In the wet season, go early and check the sky."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, sandals, sunscreen, a rain jacket and insect repellent. A light layer for air-conditioned rooms."
      }
    ]
  }
