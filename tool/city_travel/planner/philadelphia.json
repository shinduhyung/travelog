  "climate_guide": {
    "summary": "Four clear seasons: cold winters, warm humid summers, and the best weather in spring and fall.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to June and September to October",
        "text": "Highs around 17–26°C with moderate rain. Ideal for walking Old City and the parks."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (July–August)",
        "text": "Highs near 30–31°C. Plan indoor sights at midday and carry water."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold (December–February)",
        "text": "Highs around 5–8°C and lows near or below freezing. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 8–14 rain days a month, most in July. A small umbrella is worth packing any month."
      },
      {
        "icon": "🍂",
        "title": "Fall is crisp and clear",
        "text": "October and November are cooler with fewer rain days — good for long walks."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers and comfortable walking shoes. Add a rain jacket, and a heavy coat for winter visits."
      }
    ]
  }
