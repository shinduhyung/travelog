  "climate_guide": {
    "summary": "Continental climate: hot, dry summers and cool winters, with the wettest spells in spring and autumn.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best months: May, June, September",
        "text": "Warm days around 24–30°C and mostly dry. Great for walking the old centre."
      },
      {
        "icon": "🥵",
        "title": "Summer is very hot (July–August)",
        "text": "Highs near 33–34°C with little rain. Do museums at midday and walk in the morning or evening."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in spring and autumn",
        "text": "March, April and October each see around 9 rain days. Pack a small umbrella."
      },
      {
        "icon": "❄️",
        "title": "Cool winters",
        "text": "January highs near 10°C and lows around 1°C. A warm coat and layers are essential."
      },
      {
        "icon": "☀️",
        "title": "Sunny most of the year",
        "text": "Even wet months have plenty of bright days. Sunscreen matters from spring to autumn."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and a hat for summer; a warm coat for winter; a rain layer for March, April and October; comfortable shoes for cobbled streets."
      }
    ]
  }
