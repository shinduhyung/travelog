  "transit": {
    "best": "Metro for most trips; walk the old centre.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "13 lines, fast and cheap. Single Zone A fare €1.50–2, airport supplement €3. A Multi Card costs €2.50 and is reloadable; a ten-trip Metrobús ticket is about €12.20."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses share the same tickets. Night buses run when the metro closes around 01:30."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are plentiful and metered. Uber, Cabify and Bolt operate in Madrid."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed in the city. Use the metro and trains for day trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best way to see the centre. Bikes and e-scooters are widely rented."
      },
      {
        "mode": "Tourist Travel Card",
        "has": true,
        "text": "Unlimited travel: 1 day €10, 2 days €17, 3 days €22.50, 5 days €32.50, 7 days €41. Worth it if you ride often."
      }
    ]
