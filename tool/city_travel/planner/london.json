  "climate_guide": {
    "summary": "Temperate and changeable: mild summers, cool winters, and rain in every month. Rarely extreme.",
    "items": [
      {
        "icon": "🌦️",
        "title": "Rain all year",
        "text": "About 10–13 rain days every month. Showers are often short; carry a small umbrella or jacket."
      },
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 17–23°C and long daylight. July is warmest; September is mild with fewer crowds."
      },
      {
        "icon": "🧥",
        "title": "Winter is cool, not freezing",
        "text": "January and February highs near 8–9°C and lows near 2–3°C. A warm coat and layers are enough."
      },
      {
        "icon": "🌂",
        "title": "March is the wettest",
        "text": "Around 13 rain days. Plan indoor backups like museums and galleries."
      },
      {
        "icon": "🕶️",
        "title": "Summer days are long",
        "text": "June to August gives the most daylight for parks, walks and the river. Evenings stay light."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for walking. Add sunglasses and a hat for summer."
      }
    ]
