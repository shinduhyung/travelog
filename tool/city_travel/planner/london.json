  "transit": {
    "best": "Contactless card on the Tube and buses; walk the centre.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "The Underground, Elizabeth line and Overground take contactless cards and Oyster. Fares are capped per day."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "A flat £1.75 per bus, and a second bus within an hour is free (Hopper fare). Good for sightseeing above ground."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Black cabs are metered and can be hailed. Uber, Bolt and FREENOW are widely used."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving in the centre means the Congestion Charge and ULEZ fees. Visitors rarely need a car."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Central London is very walkable; many sights are 15–30 minutes apart on foot."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Thames Clippers river boats link Westminster, the South Bank, the Tower and Greenwich."
      }
    ]
