  "transit": {
    "best": "Metro for most trips; DiDi or taxis for evenings and airport runs.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Many lines with English ticket machines. WeChat/Alipay and most international cards accepted. Line 10 links Shuangliu Airport to the centre in about 30–40 min. Line 18 links Tianfu Airport to South Railway Station in about 50 min; ticket to Tianfu Square around ¥11."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "¥2 air-conditioned, ¥1 older buses. Exact change or a transit card. Signs in Chinese only, so use a map app."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Metered taxis are cheap; add about ¥10 for the airport expressway toll when leaving town. DiDi works well."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed in the city; traffic and parking are a hassle. Use trains for day trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "The flat centre is good on foot, and shared bikes are handy for short hops."
      }
    ]
  },
  "climate_guide": {
    "summary": "Humid subtropical: mild winters, warm summers and rain in every month, heaviest in July and August.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: March to May and October to November",
        "text": "Highs of 19–27°C and manageable rain. Ideal for walking, pandas and day trips."
      },
      {
        "icon": "☔",
        "title": "Rain all year",
        "text": "Even the driest months see about 5 rain days. July and August are wettest with about 20. Always carry a small umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 30–31°C with muggy air. Do outdoor sights early morning; rest indoors in the afternoon."
      },
      {
        "icon": "🧥",
        "title": "Cool, damp winter (December to February)",
        "text": "Highs of 11–13°C and lows of 4–5°C. Homes and some rooms are lightly heated, so bring warm layers."
      },
      {
        "icon": "🌫️",
        "title": "Cloudy skies are common",
        "text": "Chengdu is often overcast and hazy. Don't count on blue skies for photos."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket or umbrella, comfortable walking shoes, and mosquito repellent for summer evenings."
      }
    ]
  }
}