  "climate_guide": {
    "summary": "Mild oceanic climate: warm, drier summers and cool, wetter winters. Rain can come any month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Warmest months, highs around 21–23°C. Best for beaches, ferries and volcano walks."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect roughly 11–15 rain days every month. Showers can be short; carry a light rain jacket."
      },
      {
        "icon": "🥶",
        "title": "Cool winters (June to August)",
        "text": "Highs near 14–15°C and lows around 9–11°C. Bring warm layers and a waterproof."
      },
      {
        "icon": "🌬️",
        "title": "Sea breezes and changeable days",
        "text": "Harbour winds can make it feel cooler. A layer you can add or remove helps."
      },
      {
        "icon": "🏖️",
        "title": "Swim in summer",
        "text": "Water and air are warmest December to March. Other months suit walks more than swims."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket, comfortable walking shoes and sunscreen for summer. A warm hat for winter."
      }
    ]
