  "climate_guide": {
    "summary": "Humid continental climate: cold winters, mild summers and frequent rain year-round.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Days of 15–22°C and long evenings. June and July bring the White Nights."
      },
      {
        "icon": "🥶",
        "title": "Cold winters (December to February)",
        "text": "Highs near -3°C to -1°C and lows to -8°C. Snow and ice on pavements; wear warm boots."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "10–16 rain days a month. July is wettest. Always carry a small umbrella."
      },
      {
        "icon": "🌗",
        "title": "Very short winter days",
        "text": "December daylight is brief; plan indoor sights and start early."
      },
      {
        "icon": "🌉",
        "title": "Bridge drawbridges",
        "text": "Bridges rise at night from spring to autumn. Check the schedule before late trips."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes; a warm coat, hat and gloves in winter."
      }
