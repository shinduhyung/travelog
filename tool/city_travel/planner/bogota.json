  "transit": {
    "best": "TransMilenio for cheap main routes; taxi or app for evenings and hills.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro yet. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "TransMilenio BRT and green SITP buses use a rechargeable Tullave card. Fares about COP$3,600 (TransMilenio) and COP$3,200 (SITP); the card costs about COP$8,000. Crowded at rush hour."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber, Cabify, DiDi and InDrive work but are officially unregulated; drivers may ask you to sit in front. Call taxis by dispatch or app, never hail on the street; check the meter starts and lock doors."
      },
      {
        "mode": "Cable car",
        "has": true,
        "text": "TransMiCable gondola links Ciudad Bolívar to TransMilenio; a separate tourist cable car climbs Monserrate."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "No intercity trains; Turistren steam trains run to Zipaquirá several times a week."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not recommended: heavy traffic, restricted plates and confusing parking. Use buses, taxis and apps instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in La Candelaria, Chapinero and Zona Rosa by day. Hills and uneven pavements; avoid unlit streets at night."
      }
    ]
  },
  "climate_guide": {
    "summary": "High-altitude tropical city: mild all year, cool nights, and rain possible in any month. September is driest, March and November wettest.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Mild days, cool nights",
        "text": "Highs stay near 18–20°C all year; lows around 8–10°C. Bring a jacket for evenings."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "Expect 8–24 rain days per month. Showers are often short and heavy in the afternoon."
      },
      {
        "icon": "☀️",
        "title": "Driest: August and September",
        "text": "About 8–10 rain days. Best odds for Monserrate views and day trips."
      },
      {
        "icon": "☔",
        "title": "Wettest: March and November",
        "text": "About 22–24 rain days. Plan museums and cafés, and carry an umbrella."
      },
      {
        "icon": "⛰️",
        "title": "Altitude about 2,600 m",
        "text": "Take the first day easy. Drink water and skip heavy exercise until you adjust."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket, comfortable shoes for hills and cobblestones, and sunscreen for sunny spells."
      }
    ]
  }
