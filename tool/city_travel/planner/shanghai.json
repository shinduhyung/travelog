  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, damp winters. Spring and autumn are the best times to walk.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April and October",
        "text": "Highs around 20–23°C with moderate rain. Ideal for the Bund and long walks."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid",
        "text": "July and August hit 32°C with lows near 25–26°C. Plan indoor sights midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June to September",
        "text": "Up to 18 rain days a month. Carry an umbrella and keep a backup indoor plan."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold and damp",
        "text": "January highs near 9°C and lows near 2°C. A warm coat and layers help."
      },
      {
        "icon": "💨",
        "title": "Humidity year-round",
        "text": "Summers feel sticky; winters feel raw. Breathable clothes in summer, layers in winter."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, an umbrella, and layers. Add sunscreen and a hat for summer."
      }
    ]
  }
