  "climate_guide": {
    "summary": "Mediterranean-style climate: hot, dry summers and cool, wetter winters. Rain is spread over the cooler months.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Warm to hot days around 23–28°C and low rain. Ideal for beaches, the hills and outdoor dining."
      },
      {
        "icon": "🌧️",
        "title": "Wettest: June to August",
        "text": "About 12–13 rain days a month and highs near 14–15°C. Pack a rain jacket and plan indoor stops."
      },
      {
        "icon": "🌡️",
        "title": "Cool winters",
        "text": "July lows drop to about 8°C. Mornings and evenings feel cold; bring layers."
      },
      {
        "icon": "🏖️",
        "title": "Beach weather",
        "text": "Best from December to March. By June to August the sea and air are cold for swimming."
      },
      {
        "icon": "🍂",
        "title": "Mild shoulder months",
        "text": "April, October and November are comfortable at about 21–23°C with moderate rain. Good for walking and wine regions."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Summer: light clothes, hat and sunscreen. Winter: warm layers, a waterproof jacket and an umbrella."
      }
    ]
