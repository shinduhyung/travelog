  "transit": {
    "best": "Metro and trams for most trips; walk or bike in the flat centre.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Lines A/B/C run east-west; D/E run north-south via Beurs and Centraal. Services every 10 minutes by day."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "RET buses cover the city. Buy tickets in advance; no sales on board."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Bolt work here; taxis wait at Centraal and main squares."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Possible, but parking and narrow streets make it a poor choice for a city visit."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre is flat and compact. Walk between Markthal, Oude Haven and the river."
      },
      {
        "mode": "Bike",
        "has": true,
        "text": "The city is flat and bike-friendly. Rent a bike for longer rides along the river."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "WaterBus ferries reach Kinderdijk and Dordrecht. Check times and fares on the day."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "Centraal station links the city to the rest of the Netherlands. Pay with OV-Pay or an OV-chipkaart (about €8.50)."
      }
    ]
  },
  "climate_guide": {
    "summary": "Temperate maritime climate: mild summers, cool winters and rain in every month. Pack layers and a rain jacket year-round.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 11–15 rain days every month. Showers pass quickly; a light rain jacket beats an umbrella in wind."
      },
      {
        "icon": "🌡️",
        "title": "Mild summers",
        "text": "July and August peak near 22–23°C. Rarely hot; evenings stay cool, so bring a layer."
      },
      {
        "icon": "❄️",
        "title": "Cool winters",
        "text": "December to February highs sit around 7–8°C with lows near 2°C. Wind off the river feels colder."
      },
      {
        "icon": "🌬️",
        "title": "Windy city",
        "text": "It is flat and open, so wind is common. A windproof jacket helps on bridges and boat trips."
      },
      {
        "icon": "🌷",
        "title": "Best months: May to September",
        "text": "Warmest and brightest. May, June and September are the sweet spots for walking and cycling."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket, comfortable shoes for cobbles, and sunglasses for bright summer days."
      }
    ]
  }
