  "climate_guide": {
    "summary": "Tropical and hot all year, around 29–31°C by day and 25–26°C at night. Rain is common in every month, heaviest from September to November.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Hot all year",
        "text": "Highs stay near 29–31°C and lows near 25–26°C. No cool season; pack light clothes."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "Expect 15–30 rain days a month. Showers are often short and heavy, not all-day."
      },
      {
        "icon": "☂️",
        "title": "Driest window: January to February",
        "text": "15–19 rain days. The best odds for dry sightseeing and outdoor walks."
      },
      {
        "icon": "🌊",
        "title": "Wettest: September to November",
        "text": "27–30 rain days. Keep indoor backups and check forecasts before hill or beach trips."
      },
      {
        "icon": "🥵",
        "title": "Humidity and heat",
        "text": "Muggy most days. Walk early morning or evening and rest in air-conditioned cafés at midday."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a compact umbrella or rain jacket, sandals, and sunscreen."
      }
    ]
  }
