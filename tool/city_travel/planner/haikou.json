  "climate_guide": {
    "summary": "Tropical and humid: warm all year, with a hot, very wet summer and a mild, drier winter.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Highs of 21–27°C and the fewest rain days. Ideal for walking the old streets and the coast."
      },
      {
        "icon": "🌧️",
        "title": "Wet season May to October",
        "text": "About 19–23 rain days a month, often short heavy showers. Carry a light rain jacket."
      },
      {
        "icon": "🥵",
        "title": "Hot summer",
        "text": "June peaks near 33°C with warm nights around 27°C. Do outdoor sights early morning."
      },
      {
        "icon": "🌀",
        "title": "Typhoon season",
        "text": "Late summer and autumn can bring storms. Check forecasts and keep travel plans flexible."
      },
      {
        "icon": "💧",
        "title": "Humid year-round",
        "text": "Sea air keeps it muggy, especially May to September. Light, quick-dry clothes help."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, sunscreen and a hat; a rain jacket in summer; a light layer for winter evenings."
      }
    ]
  }
