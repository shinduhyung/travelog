  "climate_guide": {
    "summary": "Hot semi-arid climate with a short cool winter and a hot, humid monsoon summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Mild days around 17–27°C and cool nights. Ideal for the Old City and food streets."
      },
      {
        "icon": "🥵",
        "title": "Very hot April to June",
        "text": "Highs of 34–39°C. Sightsee at sunrise and rest indoors in the afternoon."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon in July and August",
        "text": "About 16–17 rain days each month and muggy nights. Expect short heavy showers."
      },
      {
        "icon": "💧",
        "title": "Humid summer nights",
        "text": "Lows stay near 26–27°C in July and August, so evenings stay warm."
      },
      {
        "icon": "🌂",
        "title": "Little rain in winter",
        "text": "Only a few rain days from October to December; an umbrella is rarely needed."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat and sunscreen; a light jacket for winter nights; modest dress for mosques."
      }
