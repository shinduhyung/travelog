  "transit": {
    "best": "Doha Metro for the main sights, with taxis or ride apps for the last stretch.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Three lines (Red, Gold, Green); Msheireb is the main transfer station. About QR 2 per trip and QR 6 for a day pass; VIP cars cost more. Free metrolink buses connect stations to nearby areas."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Cheap but infrequent and often late; route maps are hard to read. Use the free metrolink feeder buses instead where you can."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Karwa and Al Million are the main taxis; Uber works well in Doha. Handy for the airport and late nights."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is on the right. Traffic jams and roadworks are common, so allow extra time."
      },
      {
        "mode": "Walking",
        "has": false,
        "text": "Only pleasant November to March, and sights are spread out. Use the metro or a taxi in summer."
      },
      {
        "mode": "Tram",
        "has": true,
        "text": "A free tram runs in Lusail and Msheireb Downtown. Useful for short hops in those areas."
      }
    ]
  },
  "climate_guide": {
    "summary": "Hot desert climate: sunny nearly every day, very little rain, and a long, humid summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 23–30°C with cool evenings. Ideal for the souq, Corniche and desert trips."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs of 39–41°C. Plan indoor sights by day and go outside only at sunrise or after dark."
      },
      {
        "icon": "💧",
        "title": "Humid by the water",
        "text": "Muggy evenings from May to October, especially on the Corniche and at The Pearl."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "Only a few short showers between December and March. No umbrella needed most of the year."
      },
      {
        "icon": "🌪️",
        "title": "Occasional dust",
        "text": "Dusty winds can haze the sky and spoil desert views. Check the forecast before booking a dune trip."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a hat and strong sunscreen; a light layer for cold indoor AC and winter nights; modest clothing for mosques and souqs."
      }
    ]
  }
