  "climate_guide": {
    "summary": "Four clear seasons: cold winters, warm humid summers, and the best weather in spring and autumn.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May, September, October",
        "text": "Highs of roughly 19–26°C and comfortable walking weather for the Mall and monuments."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid",
        "text": "July and August reach about 30–31°C with muggy air. Do outdoor sights in the morning."
      },
      {
        "icon": "🧥",
        "title": "Winter is genuinely cold",
        "text": "January highs near 6°C and lows around -2°C. Bring a proper coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain is spread through the year",
        "text": "About 8–14 rain days a month, most in summer. A small umbrella is worth packing."
      },
      {
        "icon": "☀️",
        "title": "Long summer days",
        "text": "June and July give long daylight for evening monument walks; winter days are short."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, layers, a rain jacket, sunscreen in summer and a warm coat in winter."
      }
    ]
