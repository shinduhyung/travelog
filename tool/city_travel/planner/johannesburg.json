  "climate_guide": {
    "summary": "High-altitude city with warm, wet summers and dry, cold winters. Rain falls mostly as afternoon thunderstorms.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Dry, sunny days with few rain days. Cool to cold nights, so pack layers."
      },
      {
        "icon": "🌧️",
        "title": "Wet summer (November to February)",
        "text": "Around 11–16 rain days a month, usually short afternoon storms. Mornings are often clear."
      },
      {
        "icon": "❄️",
        "title": "Cold winter nights",
        "text": "June and July drop to about 4°C at night. Days stay near 17°C and sunny."
      },
      {
        "icon": "🌤️",
        "title": "Mild shoulder months",
        "text": "April, May, September and October are comfortable, with highs of 20–26°C."
      },
      {
        "icon": "⛈️",
        "title": "Afternoon thunderstorms",
        "text": "Summer storms can be sudden. Avoid open high ground late in the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for cool mornings and warm afternoons, a rain jacket in summer, and a warm jacket for winter nights."
      }
    ]
  }
