  "climate_guide": {
    "summary": "Baku has cold, damp winters and hot, dry summers. Spring and autumn are the most comfortable for walking.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Highs around 17–26°C with moderate rain. Good for the Old City and the boulevard."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and dry",
        "text": "July and August reach about 31°C with lows near 23°C. Go out early or after sunset."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold and damp",
        "text": "January and February sit near 8–9°C highs and 3°C lows, with around 5–7 rain days."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in autumn and early winter",
        "text": "November has about 9 rain days and October about 8. Bring a light rain jacket."
      },
      {
        "icon": "💨",
        "title": "Windy city",
        "text": "Baku is known as the City of Winds. The seafront can feel cooler and breezier than inland streets."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, and light breathable clothes plus sunscreen for summer."
      }
    ]
  }
