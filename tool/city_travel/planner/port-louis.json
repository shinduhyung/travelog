  "transit": {
    "best": "Metro Express for suburbs and taxis for short city hops; buses are cheap but slow.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Metro Express light rail links suburbs to the city, daily 6 AM to 10 PM, roughly every 12–15 minutes."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Two bus stations: Immigration Square for north and east routes, Victoria Square for south and west. Intercity tickets about MUR 15–30; express and AC buses cost more. City buses run until about 8 PM."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis within the city cost about MUR 10–50, a bit more at night. Ride apps are limited; arrange taxis by phone or at ranks. Avoid rush hours."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is chaotic, so park at the marina or hotel. Only worth it for trips outside the city."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good for the waterfront and city centre in the drier, cooler months. Use taxis or the metro for longer hops."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical city: hot and humid most of the year, with a wet summer and a drier, cooler winter.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Highs around 25–26°C and only 7–8 rain days. The most comfortable months for walking."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: January to March",
        "text": "About 21–24 rain days a month. Showers can be heavy; keep indoor plans ready."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid summer",
        "text": "Highs near 30°C with lows around 25°C. Go out early and rest at midday."
      },
      {
        "icon": "🌂",
        "title": "Carry rain gear in summer",
        "text": "December to April brings frequent showers. A light rain jacket helps."
      },
      {
        "icon": "🌬️",
        "title": "Cooler evenings in winter",
        "text": "June to September lows drop to about 20°C. A light layer is useful at night."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, sunscreen and a hat; a rain jacket for summer; a light layer for winter evenings."
      }
    ]
  }
