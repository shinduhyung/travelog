  "climate_guide": {
    "summary": "Mild Mediterranean-style coast: warm dry summers, cool winters and little rain outside winter and spring.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: July to October",
        "text": "Warmest and driest, highs 24–26°C. Best for beaches and outdoor days."
      },
      {
        "icon": "🌫️",
        "title": "May grey and June gloom",
        "text": "Coastal fog and cloud in late spring and early summer. It often clears by midday; inland is sunnier."
      },
      {
        "icon": "🌧️",
        "title": "Rain is light and winter-based",
        "text": "Most rain falls December to March, peaking in March at about 8 rain days. Summer is almost dry."
      },
      {
        "icon": "🧥",
        "title": "Cool evenings year-round",
        "text": "Lows drop to 9–19°C depending on month. Bring a light layer even in summer."
      },
      {
        "icon": "🌊",
        "title": "Ocean stays cool",
        "text": "Water is chilly much of the year. Wetsuits are common for surfing; check conditions on the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a light jacket, sunscreen and comfortable shoes. Add a rain shell for winter and spring visits."
      }
