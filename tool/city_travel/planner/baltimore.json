  "transit": {
    "best": "Walk the harbor and Fells Point; use the free Circulator bus and light rail for the rest.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "The subway and light rail cost $2 per ride; a day pass is $4.60. The light rail runs from BWI Airport to the Inner Harbor in about 30 minutes for $2."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "MTA buses cost $2 per ride, $4.60 for a day pass. The Charm City Circulator is free and links the harbor, Fells Point and Mount Vernon."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Lyft both operate widely. Taxis are metered but less common."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is optional. Parking downtown runs about $5 per hour near the harbor."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The Inner Harbor, Fells Point and Federal Hill are close together and easy on foot in mild weather."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "MARC and Amtrak trains connect Penn Station to Washington, D.C. in about an hour."
      }
    ]
