  "climate_guide": {
    "summary": "Four clear seasons: cold winters, warm humid summers, and mild spring and fall. Rain falls year-round.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May, September and October",
        "text": "Highs of 18–26°C and comfortable evenings. Ideal for the harbor and Fort McHenry."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid",
        "text": "July and August reach about 30°C with muggy air. Do outdoor sights early and stay in the shade."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold",
        "text": "January highs near 6°C and lows below freezing. Bring a warm coat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain any month",
        "text": "Expect rain on 8–15 days each month. Summer is wettest; a small umbrella helps."
      },
      {
        "icon": "☀️",
        "title": "Long summer days",
        "text": "June to August gives the most daylight for walking the waterfront in the evening."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobbled streets. Add sunscreen and a hat for summer."
      }
    ]
