  "climate_guide": {
    "summary": "Continental climate with cold winters and warm summers. Rain is spread across the year, heaviest in May.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Warm highs of 22–28°C and long days. Ideal for the river, parks and day trips."
      },
      {
        "icon": "🌧️",
        "title": "May is the wettest month",
        "text": "About 16 rain days. Carry a rain jacket and keep outdoor plans flexible."
      },
      {
        "icon": "❄️",
        "title": "Cold winters",
        "text": "January highs near 5°C and lows around -3°C. Pack layers, a warm coat and gloves."
      },
      {
        "icon": "🌦️",
        "title": "Rain all year",
        "text": "Expect roughly 8–12 rain days most months. A compact umbrella helps any season."
      },
      {
        "icon": "🥵",
        "title": "Hot summer afternoons",
        "text": "July and August reach about 27–28°C. Sightsee in the morning and rest in the shade midday."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a rain layer and a warm jacket for winter. Summer needs light clothes and sun protection."
      }
    ]
  }
