  "transit": {
    "best": "Metro for most trips; DiDi or Alipay taxis for late nights and places off the metro.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Extensive, cheap (¥3–10) and reaches most sights. Buy a Yikatong card or use Alipay/WeChat."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Frequent but hard to navigate without Chinese; fares around ¥2."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Metered taxis, but drivers rarely speak English; show place names in Chinese characters. DiDi works and can be paid via Alipay or WeChat; Alipay also books taxis in English."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Needs a Chinese licence and a Beijing entry permit (进京证); most visitors skip driving."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in hutongs and parks. Use Baidu or Amap maps, not Google."
      },
      {
        "mode": "Shared bike",
        "has": true,
        "text": "Dockless shared bikes are great for last-mile trips; use Baidu or Amap maps."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, dry winters and hot, rainy summers. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May, September, October",
        "text": "Highs around 19–28°C with low rain. Perfect for the Great Wall and long walks."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold and dry",
        "text": "December to February highs near 3–6°C and lows below freezing. Very little rain; pack a heavy coat."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and wet",
        "text": "June to August highs near 30–33°C, with the most rain in July. Plan indoor sights at midday."
      },
      {
        "icon": "🌂",
        "title": "Rain peaks in July and August",
        "text": "About 12–14 rain days a month then. Other months are mostly dry."
      },
      {
        "icon": "🌬️",
        "title": "Spring can be windy and dusty",
        "text": "March and April bring wind; air quality varies. Check the day's forecast before outdoor plans."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a heavy coat for winter, light breathable clothes and an umbrella for summer. Comfortable shoes for long walks."
      }
    ]
  }
