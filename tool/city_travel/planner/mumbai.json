  "climate_guide": {
    "summary": "Tropical monsoon climate: hot and humid most of the year, with a long, very wet monsoon from June to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Dry days around 29–32°C with cooler evenings. Ideal for walking, ferries and street food."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon: June to September",
        "text": "Rain on most days, heaviest in July and August. Expect wet streets and possible travel delays."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid April to May",
        "text": "Highs near 33°C with rising humidity. Sightsee early morning and rest in the afternoon."
      },
      {
        "icon": "🌂",
        "title": "Carry rain gear in monsoon",
        "text": "An umbrella or light raincoat is essential from June to September."
      },
      {
        "icon": "💧",
        "title": "Humidity all year",
        "text": "It feels hotter than the numbers. Light, breathable clothes help."
      },
      {
        "icon": "🧳",
