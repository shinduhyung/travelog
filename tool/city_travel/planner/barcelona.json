  "transit": {
    "best": "Metro for most trips; walk the old town and use taxis late at night.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Metro and FGC trains cover the city. Zone 1 tickets are cheap and contactless via T-mobilitat."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City and intercity buses fill the gaps. Night buses run when the metro closes."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are metered. Uber, Bolt and Cabify operate in Barcelona."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is slow and parking is costly. Leave the car outside the centre."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Walking is best in the old town. Bike lanes and Bicing-style bike hire are common."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries and cruise shuttles link the port to La Rambla and the Balearics."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mediterranean climate: mild winters, hot dry summers and the most rain in autumn.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to July",
        "text": "Warm days around 21–29°C with little rain. Good for both sightseeing and the beach."
      },
      {
        "icon": "🥵",
        "title": "Hot summer (July and August)",
        "text": "Highs near 29°C and lows around 21–22°C. Sightsee early morning or evening; rest at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in autumn",
        "text": "September has about 12 rain days and October about 10. Showers can be heavy; carry a small umbrella."
      },
      {
        "icon": "🧥",
        "title": "Mild but cool winters",
        "text": "January highs near 14°C and lows around 5°C. A warm coat is needed, especially at night."
      },
      {
        "icon": "🏖️",
        "title": "Beach season",
        "text": "Comfortable swimming is roughly June to September. May and October are for walks, not long swims."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer; a layer for cool evenings; a rain jacket for spring and autumn."
      }
    ]
  }
