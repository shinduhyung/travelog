  "transit": {
    "best": "Ride apps or a rental car for most trips; Metro rail for downtown, Hollywood and Santa Monica.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Subway and light rail link Downtown, Hollywood, Santa Monica and Long Beach. Fares about $1.75 per ride."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Metro buses cover the whole sprawl. Use a TAP card or contactless tap on rail and bus."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are metered and costlier than apps. Uber and Lyft operate widely and are the usual choice."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is fastest off-peak, but freeways jam roughly 7–10am and 3–7pm."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Pleasant in beach towns and Hollywood. Bikes and e-scooters are common near the coast."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "No ferries serve the city centre. Harbour boats run from San Pedro to Catalina Island."
      }
    ]
  },
  "climate_guide": {
    "summary": "Warm and mostly dry, with mild winters and hot, sunny summers. Coastal areas stay cooler than inland.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: April to June and September to October",
        "text": "Mild to warm days with little rain. Good for both sightseeing and the beach."
      },
      {
        "icon": "🥵",
        "title": "Hot late summer",
        "text": "July and August reach about 31–32°C inland. Beaches are cooler; carry water and seek shade."
      },
      {
        "icon": "🌫️",
        "title": "Coastal fog",
        "text": "Mornings near Santa Monica and Venice can be grey in late spring and early summer; it often clears later."
      },
      {
        "icon": "🌧️",
        "title": "Rain is light",
        "text": "Most rain falls between November and March, usually a few days a month. An umbrella is handy in winter."
      },
      {
        "icon": "🧥",
        "title": "Cool winter nights",
        "text": "January and December nights drop to about 8°C. Pack a warm layer for evenings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, sunglasses and sunscreen; a jacket for winter nights and coastal fog."
      }
    ]
  }
