  "climate_guide": {
    "summary": "Baltic climate: cold winters, mild summers and rain in every month. Summer days are long; winter days are short.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to August",
        "text": "Highs around 22°C and long daylight. The busiest and priciest season; book ahead."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 9–15 rain days every month. July and December are wettest; May is driest."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold",
        "text": "January highs near 0°C and lows around -4°C. Snow is possible; wear a warm coat and boots."
      },
      {
        "icon": "🌗",
        "title": "Short winter days",
        "text": "November to February has little daylight. Plan indoor sights and start early."
      },
      {
        "icon": "🍂",
        "title": "Shoulder seasons are quiet",
        "text": "April–May and September–October are cheaper with fewer crowds, but pack rain gear."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobblestones. Add a warm hat and gloves from November to March."
      }
    ]
  }
