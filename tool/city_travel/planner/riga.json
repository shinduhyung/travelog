  "transit": {
    "best": "Walk the Old Town and centre; use trams and buses for longer hops, and ride apps at night.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro in Riga. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Trams, buses and trolleybuses by Rigas Satiksme: single fare €1.50 valid 90 minutes with transfers. Buy via Mobilly, Narvesen or ticket machines and scan the vehicle QR code. 24-hour pass €5, 3-day €8, 5-day €10; free on some holidays."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Bolt, Panda Taxi and Red Cab work well. Avoid hailing random street taxis."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not advised: traffic and parking fees up to €8/hour in the Old Town."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best way to see the Old Town, but cobblestones are rough. Bikes and e-scooters are common April to September."
      },
      {
        "mode": "Ferry / boat",
        "has": true,
        "text": "Seasonal boat to Jūrmala runs May to September, €15–20, about 2.5 hours."
      }
    ]
