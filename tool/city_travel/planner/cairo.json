  "climate_guide": {
    "summary": "Hot desert climate: sunny most days, almost no rain, and a very hot summer from June to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 19–27°C and cool nights. Ideal for the Pyramids and long walks."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs of 36–38°C. Do outdoor sights at sunrise; stay indoors at midday."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "Only about 1–2 rain days a month in winter. No umbrella needed most of the year."
      },
      {
        "icon": "🌪️",
        "title": "Dust and haze",
        "text": "Spring can bring dusty winds that blur the skyline. Check the air before desert trips."
      },
      {
        "icon": "🌙",
        "title": "Cool evenings in winter",
        "text": "Nights drop near 9–11°C from December to February. A jacket helps after dark."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a hat and sunscreen; a warm layer for winter nights; modest dress for mosques."
      }
    ]
  }
