  "climate_guide": {
    "summary": "Mild, wet winters and dry, sunny summers. Rain is common from October to March; July and August are the driest.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: July and August",
        "text": "Highs near 25°C and only about 3–5 rain days. The driest, sunniest stretch for outdoor plans."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: November to January",
        "text": "About 18–19 rain days a month and highs of 7–10°C. Bring a waterproof jacket, not just an umbrella."
      },
      {
        "icon": "🌦️",
        "title": "Spring is showery",
        "text": "March to May warms from about 11°C to 18°C, but expect around 10–15 rain days a month."
      },
      {
        "icon": "🧥",
        "title": "Layers beat a heavy coat",
        "text": "Days are rarely very cold or very hot. A light waterproof shell over layers works most of the year."
      },
      {
        "icon": "🌥️",
        "title": "Grey skies are normal",
        "text": "Cloud cover is common outside summer. Plan one indoor sight per day as a backup."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Waterproof jacket, comfortable walking shoes and layers. Add sunglasses and a hat for July and August."
      }
    ]
  }
