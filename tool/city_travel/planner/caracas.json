  "climate_guide": {
    "summary": "Mild all year at this altitude: highs around 26–28°C, cool nights, and rain in every month. The driest months are January and February.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Mild all year",
        "text": "Highs stay around 26–28°C and lows around 17–20°C. No extreme heat or cold."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "Expect 11–25 rain days a month. Showers are often short; a light rain jacket helps."
      },
      {
        "icon": "☔",
        "title": "Wettest: July and August",
        "text": "About 24–25 rain days. Keep indoor options ready and check mountain trips on the day."
      },
      {
        "icon": "☀️",
        "title": "Driest: January and February",
        "text": "Around 11–12 rain days. The best window for walking and outdoor plans."
      },
      {
