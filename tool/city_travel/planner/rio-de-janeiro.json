  "climate_guide": {
    "summary": "Tropical climate: hot most of the year, wetter in summer (Dec–Mar) and drier in winter (Jun–Aug).",
    "items": [
      {
        "icon": "☀️",
        "title": "Best months: May to September",
        "text": "Drier and milder, with highs 25–27°C and fewer rain days. Good for both beach and city walks."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: December to March",
        "text": "15–16 rain days a month. Showers are often short and heavy; carry a small umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot summer",
        "text": "Highs around 29–30°C with warm nights near 24°C. Pace yourself and drink water."
      },
      {
        "icon": "🧥",
        "title": "Cool evenings in winter",
        "text": "June to August lows drop to 18–19°C. A light jacket helps at night and on the water."
      },
      {
        "icon": "🏖️",
        "title": "Beach days",
        "text": "Beaches are busiest on hot weekends. Go early morning for space and softer sun."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, swimwear, sunscreen and a rain jacket. Add a light layer for winter evenings."
      }
    ]
  }
