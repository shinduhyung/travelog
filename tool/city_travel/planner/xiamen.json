  "climate_guide": {
    "summary": "Subtropical and humid: mild, fairly dry winters and hot, wet summers with typhoon-season rain.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: October to December",
        "text": "Warm days around 20–29°C and few rain days. Ideal for Gulangyu and the old town."
      },
      {
        "icon": "🌧️",
        "title": "Wettest months: May to August",
        "text": "15–20 rain days a month. Showers can be heavy; keep a rain jacket and a backup plan."
      },
      {
        "icon": "🥵",
        "title": "Hot summer",
        "text": "July and August peak near 32–33°C with warm nights. Sightsee early morning or after sunset."
      },
      {
        "icon": "🌪️",
        "title": "Typhoon season",
        "text": "Summer and early autumn can bring storms. Check forecasts and ferry status on the day."
      },
      {
        "icon": "🧥",
        "title": "Mild winters",
        "text": "January and February sit around 11–19°C. A jacket is useful, especially near the water."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a rain layer, sunscreen and comfortable shoes for cobbled island lanes."
      }
    ]
  }
