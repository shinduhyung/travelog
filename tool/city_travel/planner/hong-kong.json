        "best": true,
        "text": "Walking is best in dense districts. The Star Ferry crosses the harbour cheaply."
      },
      {
        "mode": "Tram",
        "has": true,
        "text": "Trams on Hong Kong Island are cheap and scenic."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "The Star Ferry crosses the harbour cheaply; other ferries reach the outlying islands."
      }
