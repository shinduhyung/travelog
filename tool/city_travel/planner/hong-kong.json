  "climate_guide": {
    "summary": "Subtropical: mild, dry winters and hot, very wet, humid summers with a typhoon season.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: October to March",
        "text": "Highs around 19–27°C with fewer rain days. Best for walking, hiking and the harbour."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to September)",
        "text": "Highs near 30°C and muggy. Move slowly, use the MTR and malls to cool down."
      },
      {
        "icon": "🌧️",
        "title": "Very wet late spring and summer",
        "text": "May to September brings 21–27 rain days a month. Pack a compact umbrella and a rain jacket."
      },
      {
        "icon": "🌀",
        "title": "Typhoon season",
        "text": "Storms are most likely from June to September. Watch official warnings; ferries and flights can stop."
      },
      {
        "icon": "💧",
        "title": "Humidity is high",
        "text": "Sticky from May to September. Light, quick-dry clothes help."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket and comfortable walking shoes; a warmer layer for cool winter evenings and strong indoor AC."
      }
    ]
  }
