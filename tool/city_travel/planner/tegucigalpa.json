  "climate_guide": {
    "summary": "Mild highland climate: warm days, cool nights, and a long rainy season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Days around 25–30°C and nights near 16–17°C, with the fewest rain days. Ideal for walking the centre."
      },
      {
        "icon": "🌧️",
        "title": "Rainy season May to October",
        "text": "Rain days climb to 19–26 a month. Showers often come in the afternoon; plan indoor sights then."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not tropical-hot",
        "text": "Highs stay between 25 and 31°C all year thanks to the altitude. Nights are cool, 16–19°C."
      },
      {
        "icon": "🧥",
        "title": "Pack a light layer",
        "text": "Evenings and early mornings are cool. Bring a light jacket and an umbrella in the wet months."
      },
      {
        "icon": "🥾",
        "title": "Wet-season shoes",
        "text": "Streets and hills can be slick from May to October. Waterproof shoes help."
      },
      {
        "icon": "📅",
        "title": "Shoulder months",
        "text": "November and April are in-between: some rain, comfortable temperatures, fewer crowds."
      }
