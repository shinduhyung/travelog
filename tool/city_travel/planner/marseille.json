  "transit": {
    "best": "Metro and tram for the centre; walk Le Panier and the port.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Two lines, running 05:00–00:30. Single ticket €1.70, or €15 for ten."
      },
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "Three lines until 00:30, same tickets as the metro. Handy along the main boulevards."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Good coverage, but most routes stop after 21:00. Night buses are limited, so plan evening trips around that."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis exist but watch for rogue drivers. Uber and similar apps work and are often easier."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not recommended in the centre: narrow streets and parking problems. Useful only for day trips out of town."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Best way to see the Vieux-Port and Le Panier, though the old town is steep in places."
      },
      {
        "mode": "Bike",
        "has": true,
        "text": "Le vélo scheme costs €1 a week with the first 30 minutes free. Few cycle paths, so ride carefully."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Boat across the Vieux-Port and to Frioul island, about €10 return. Check sailings on the day if windy."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mediterranean climate: mild winters, hot dry summers and a windy, sometimes wet spring and autumn.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 21–28°C and little rain. Ideal for the port, beaches and calanques."
      },
      {
        "icon": "🥵",
        "title": "July and August are hot",
        "text": "Around 28°C by day and 20–21°C at night. Sightsee in the morning; rest in the afternoon."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in autumn",
        "text": "October and November bring the most rain days (about eight to nine). Showers can be heavy but short."
      },
      {
        "icon": "💨",
        "title": "The mistral wind",
        "text": "A strong, cold north wind can blow any season. It clears the sky but makes the sea rough and boat trips uncertain."
      },
      {
        "icon": "🌊",
        "title": "Sea swimming",
        "text": "Comfortable roughly June to September. Outside that, beaches are for walking, not swimming."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer, a windproof layer and rain jacket for spring and autumn, warm layers for winter."
      }
    ]
  }
