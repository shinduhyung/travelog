  "transit": {
    "best": "Rent a car or use ride apps; the rail and buses help downtown but the city is spread out.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "METRORail covers about 37 km on the Red, Green and Purple lines. Handy for downtown and the Museum District."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "METRO buses fill the gaps; fare is about $1.25 each way. Pay with a METRO Q Card or day pass for free transfers within 3 hours."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber and Lyft are widely used; Empower is a local lower-cost option. Good for airport and late-night trips."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is easiest but rush hour runs roughly 7-9AM and 4-6:30PM. Plan around it."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Downtown is walkable; elsewhere sidewalks are patchy and heat is fierce. Use rides for longer hops."
      }
    ]
  },
  "climate_guide": {
    "summary": "Subtropical and humid: long hot summers, mild winters, and rain spread through the year with a wetter spring.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: October to April",
        "text": "Highs run about 17–27°C. Comfortable for walking, parks and the Space Center."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (June to September)",
        "text": "Highs near 32–33°C with muggy air. Do outdoor sights early morning; rest indoors midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 10–17 rain days each month, wettest in spring. Carry a small umbrella and check the forecast."
      },
      {
        "icon": "⛈️",
        "title": "Heavy downpours possible",
        "text": "Storms can be intense and brief. Streets may flood; wait it out rather than driving through water."
      },
      {
        "icon": "💧",
        "title": "Humidity is high",
        "text": "Expect sticky evenings in summer. Light, breathable clothes help; indoor AC is strong."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket or umbrella, sunscreen and a hat; a light sweater for cool winter nights and cold AC."
      }
    ]
  }
