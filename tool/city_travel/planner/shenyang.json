  "climate_guide": {
    "summary": "A cold northeast China climate: freezing winters, warm humid summers, and the best weather in spring and autumn.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Mild days around 16–24°C. Ideal for the palace, tomb parks and walking."
      },
      {
        "icon": "🥶",
        "title": "Winter is very cold",
        "text": "December to February highs sit near -4 to 0°C with lows around -14°C. Bring a heavy coat, hat and gloves."
      },
      {
        "icon": "☔",
        "title": "Rain peaks in summer",
        "text": "July and August have the most rain days, around 13–14. Keep a compact umbrella handy."
      },
      {
        "icon": "🥵",
        "title": "Short hot summer",
        "text": "June to August reach about 28–30°C and stay humid. Plan outdoor sights for morning."
      },
      {
        "icon": "🌬️",
        "title": "Spring can be windy and dusty",
        "text": "March and April are drier but breezy. A light scarf helps."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Warm layers and boots for winter; light clothes and rain gear for summer; a jacket for spring and autumn evenings."
      }
    ]
