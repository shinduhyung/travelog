  "transit": {
    "best": "Metro for cheap fast trips; ride apps for night and cross-town journeys.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "12 lines, M$5–6 per ride, 05:00–00:00 weekdays. Very crowded at rush hour; watch your pockets."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Metrobús BRT and trolleybuses cover main avenues; pay with a rechargeable card."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "White and magenta taxis: agree the fare or use the meter, and prefer sitio stands at night. Uber, DiDi and inDrive are widely used and cheap; check the plate before getting in."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is slow and parking is hard. Not worth it inside the city."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Best in Centro, Roma and Condesa. Sidewalks are uneven; watch your step."
      },
      {
        "mode": "Bike-share",
        "has": true,
        "text": "EcoBici stations in central areas. Helmets are not common."
      }
    ]
  },
  "climate_guide": {
    "summary": "High-altitude city with mild days all year and a wet summer. Rain falls mostly in afternoon storms from June to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to April",
        "text": "Dry, sunny days around 22–27°C. Ideal for walking, ruins and markets."
      },
      {
        "icon": "🌧️",
        "title": "Wet season June to September",
        "text": "Up to 26–27 rain days a month. Storms usually hit in the afternoon; keep mornings for outdoor plans."
      },
      {
        "icon": "🧥",
        "title": "Cool nights all year",
        "text": "Lows of 7–13°C. Evenings need a light jacket, especially in December and January."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not hot",
        "text": "Highs stay around 22–27°C. The altitude can make sun feel stronger; use sunscreen."
      },
      {
        "icon": "⛈️",
        "title": "Afternoon downpours",
        "text": "Summer storms are short but heavy. Carry a compact rain jacket and waterproof shoes."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a light rain jacket in summer, comfortable walking shoes and a hat."
      }
    ]
  }
