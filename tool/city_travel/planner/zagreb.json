  "climate_guide": {
    "summary": "Continental climate: cold winters, warm summers, and rain spread through the year, wettest in May.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: May to September",
        "text": "Warm days from 21°C to 28°C. June and September are the sweet spots; July and August are hottest."
      },
      {
        "icon": "🌧️",
        "title": "May is the wettest month",
        "text": "About 15 rain days. Pack a rain jacket and keep indoor plans ready."
      },
      {
        "icon": "❄️",
        "title": "Winter is cold",
        "text": "January highs near 5°C and lows around -2°C. December and February are only a little milder."
      },
      {
        "icon": "🧥",
        "title": "Layers all year",
        "text": "Evenings cool down in summer. Bring a light layer in warm months and a warm coat from November to March."
      },
      {
        "icon": "☀️",
        "title": "Summer heat is manageable",
        "text": "July and August peak near 28°C with mild nights around 18°C. Sightsee early and rest at midday."
      },
      {
        "icon": "🎒",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a rain jacket, sunglasses, and warm layers for winter. An umbrella helps in spring and autumn."
