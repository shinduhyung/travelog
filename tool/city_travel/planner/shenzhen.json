  "climate_guide": {
    "summary": "Subtropical and humid: mild dry winters, hot wet summers, and a long rainy season from spring to autumn.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Mild, mostly dry days around 20–25°C. Ideal for parks, walking and sightseeing."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "June to September brings 30–31°C highs and heavy humidity. Move slowly and use air-conditioned breaks."
      },
      {
        "icon": "🌧️",
        "title": "Long rainy season",
        "text": "May to September has 21–25 rain days a month. Carry an umbrella and keep plans flexible."
      },
      {
        "icon": "🌀",
        "title": "Typhoon season",
        "text": "Storms are possible roughly summer to early autumn. Check forecasts and transport alerts before travel."
      },
      {
        "icon": "🌂",
        "title": "Pack for rain and sun",
        "text": "Light layers, a compact umbrella, quick-dry shoes and sunscreen. A light jacket helps in winter."
      },
      {
        "icon": "🧳",
        "title": "Indoor backups",
        "text": "Malls, museums and food halls are good rainy-day options; save outdoor trails for dry days."
      }
    ]
  }
