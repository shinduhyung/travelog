  "transit": {
    "best": "Get a T-money card and use the metro for most trips; buses beat traffic on short hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "9 numbered lines plus suburban lines. Base fare ₩1,550 with card, ₩1,650 single ticket. Stops late at night."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Buses have their own lanes and beat traffic. Use a T-money card for both bus and metro."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Metered and plentiful. Kakao T is the main ride-hailing app; Uber works too."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Possible but traffic jams are common and parking is costly. Not needed for most trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in Myeongdong, Jongno and Hongdae. Use metro for longer hops between districts."
      },
      {
        "mode": "Climate Card",
        "has": true,
        "text": "Unlimited 1–7 day transit passes from ₩5,000 to ₩20,000. Good value if you ride often."
      },
      {
        "mode": "Night bus",
        "has": true,
        "text": "Subway stops late at night; night buses run on major routes."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, dry winters and hot, rainy summers. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Mild highs of 18–25°C with fewer rainy days. Ideal for palaces, walking and markets."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold and dry",
        "text": "January highs near 2°C and lows around -7°C, with only about 3 rain days. Bring a heavy coat."
      },
      {
        "icon": "🌧️",
        "title": "Rainy season in July and August",
        "text": "About 18 and 16 rain days, with highs near 29°C. Expect heavy downpours; carry an umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "June to August feels muggy. Plan outdoor sights for morning and rest indoors in the afternoon."
      },
      {
        "icon": "🍂",
        "title": "Crisp autumn",
        "text": "September and October cool to 19–25°C with fewer wet days. The most comfortable months."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, and a rain jacket or umbrella for summer."
      }
    ]
  }
