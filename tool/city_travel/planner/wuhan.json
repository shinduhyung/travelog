  "transit": {
    "best": "Metro for most trips; ferries for river views and short hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "12 lines and 300+ stations. Line 2 links the airport and Hankou station; Line 4 links Wuhan and Wuchang stations. Fares are distance-based; a Wuhan Tong card costs ¥15 and gives about 10% off."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Flat fare ¥1–2 (¥0.8–1.6 with card). Alipay and WeChat QR codes work on many routes."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Metered and cheap. DiDi works well; Uber does not operate in China."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed for a city visit; metro and taxis cover the sights."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good for short hops and riverside walks; shared bikes help between nearby spots."
      },
      {
        "mode": "Ferry",
        "has": true,
        "best": true,
        "text": "Ferries cross the Yangtze between the three towns; a cheap way to see the river."
      },
      {
        "mode": "Streetcar",
        "has": true,
        "text": "Two streetcar systems serve Hanyang and the Guanggu area."
      }
    ]
  },
  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, damp winters. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Highs around 23–30°C with manageable rain. Ideal for walking and the lake."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs of 30–33°C and lows near 26°C. Muggy nights; plan indoor sights at midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June",
        "text": "About 15 rain days in June. Keep a compact umbrella and a backup indoor plan."
      },
      {
        "icon": "❄️",
        "title": "Cool, damp winter",
        "text": "January highs near 9°C and lows around 2°C. Buildings can feel cold; bring warm layers."
      },
      {
        "icon": "🌂",
        "title": "Rain most months",
        "text": "Expect 6–15 rain days any month. Showers are often short, so carry rain gear rather than cancel plans."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes and sun protection for summer; a warm coat for winter; an umbrella year-round."
      }
    ]
  }
