  "climate_guide": {
    "summary": "Temperate lakeside climate: cold, grey winters and warm, sunny summers, with rain spread across the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Highs of 24–27°C and the most sun. Ideal for the lake, parks and boat trips."
      },
      {
        "icon": "❄️",
        "title": "Winter is cold (December to February)",
        "text": "Highs of 5–8°C and lows near 0°C. Pack a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 9–14 rain days most months. Bring a light waterproof and an umbrella."
      },
      {
        "icon": "🌸",
        "title": "Spring warms up slowly",
        "text": "March to May climbs from 11°C to 18°C. Pleasant but changeable; layer up."
      },
      {
        "icon": "🍂",
        "title": "Mild autumn",
        "text": "September and October stay around 16–21°C; good for walking before the cold sets in."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobbled lanes; sunglasses and sunscreen for summer."
      }
    ]
  }
