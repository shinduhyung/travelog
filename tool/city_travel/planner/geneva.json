      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Metered taxis are pricey; Uber and similar apps operate in Geneva."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Possible, but parking is costly and the centre is compact. Use transit instead for city trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The city is fairly flat and good for walking and bikes. Genèveroule lends bikes free in summer."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Yellow 'mouette' boats cross the lake and are covered by TPG tickets."
