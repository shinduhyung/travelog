  "climate_guide": {
    "summary": "Continental climate with cold winters and warm, humid summers. Rain falls year-round, spread over many days.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs from 18°C to 26°C and mild evenings. Best for walking, the islands and patios."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs near 0°C to 3°C and lows down to -8°C. Bring a heavy coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "About 9–13 rain days a month. April and October are the wettest; pack a light rain jacket."
      },
      {
        "icon": "🌡️",
        "title": "Summer can be humid",
        "text": "July and August highs near 26°C with muggy spells. Carry water and plan indoor breaks."
      },
      {
        "icon": "🍂",
        "title": "Spring and fall are mild",
        "text": "May and September are comfortable, around 18–22°C. Good shoulder-season months."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for cool evenings, a waterproof jacket, and warm boots in winter. Comfortable shoes for walking."
      }
    ]
