  "climate_guide": {
    "summary": "Cool coastal climate: mild summers, cold winters and rain in every month. Days are very long in summer and short in winter.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 16–21°C and long daylight. Best for fjord ferries, parks and walking."
      },
      {
        "icon": "🧥",
        "title": "Winters are cold",
        "text": "January and February highs sit near -1 to 1°C with lows of -6 to -5°C. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 8–13 rain days every month. A waterproof jacket beats an umbrella in wind."
      },
      {
        "icon": "🌗",
        "title": "Big daylight swing",
        "text": "Summer evenings stay bright late; December days are short. Plan outdoor sights for midday in winter."
      },
      {
        "icon": "👟",
        "title": "Watch for ice",
        "text": "Winter pavements can be slippery. Wear shoes with grip or bring traction aids."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket and comfortable walking shoes. Add a warm hat and gloves from November to March."
      }
    ]
  }
