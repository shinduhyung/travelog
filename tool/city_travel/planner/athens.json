  "transit": {
    "best": "Metro for the centre and airport; walk in Plaka and Monastiraki.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "3 lines, running about 05:30–00:30, later on Friday and Saturday nights. One OASA ticket costs €1.20 and covers metro, tram and bus with transfers for 90 minutes."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses and the tram use the same €1.20 OASA ticket. The airport express bus X93/X95 costs €5.50."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are yellow; insist on the meter and expect shared rides at busy times. Uber and Bolt work in Athens and help avoid fare haggling."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving in the centre is hard: narrow streets, little parking and heavy traffic. Skip it for city days."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best way around Plaka, Monastiraki and Syntagma. Wear shoes with grip for marble and stone paths."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Piraeus port is about 10 km from the centre, with ferries to the islands. Reach it by metro."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mediterranean climate: hot, dry summers and mild, wetter winters. Spring and autumn are the sweet spots.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: April to June and September to October",
        "text": "Days around 20–29°C with little rain. Ideal for ruins, walking and the coast."
      },
      {
        "icon": "🥵",
        "title": "Summer is very hot (July–August)",
        "text": "Highs near 33°C and few rain days. Sightseeing is hard at midday; go early or late."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in winter",
        "text": "December to February have about 7–8 rain days a month. Showers are usually short."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "January highs near 12°C and lows around 5°C. Bring a warm coat for evenings."
      },
      {
        "icon": "🌊",
        "title": "Sea season",
        "text": "Beach weather runs roughly June to September, warmest in July and August."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Sun hat and sunscreen for summer; a light rain jacket and warm layer for winter; comfortable shoes for marble and stone paths."
      }
    ]
  }
