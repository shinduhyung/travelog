  "climate_guide": {
    "summary": "Hot desert climate: long, very hot summers, mild winters and almost no rain.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Highs of 19–26°C and cool evenings. Ideal for souks, the corniche and walking."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs of 41–45°C. Plan indoor sights by day and go out only early or late."
      },
      {
        "icon": "🌂",
        "title": "Very little rain",
        "text": "A few rain days between November and March. No umbrella needed most of the year."
      },
      {
        "icon": "🌬️",
        "title": "Dusty winds possible",
        "text": "Dust can haze the sky in spring and summer. Check conditions before desert trips."
      },
      {
        "icon": "🧴",
        "title": "Strong sun",
        "text": "Sun is intense even in winter. Use sunscreen, a hat and water."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a light layer for winter nights and cool indoor AC, and modest dress for mosques."
      }
    ]
  }
