  "climate_guide": {
    "summary": "Hot and mostly dry, with a short, heavy monsoon from June to September. November to February is the comfortable window.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Highs of 27–32°C and cool nights. Ideal for walking the Old City and day trips."
      },
      {
        "icon": "🥵",
        "title": "Very hot April to June",
        "text": "Highs of 38–41°C. Do outdoor sights at sunrise or after dark and rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon July to September",
        "text": "Up to 23 rain days in July. Short heavy downpours; keep plans flexible and carry an umbrella."
      },
      {
        "icon": "💧",
        "title": "Humid in the rains",
        "text": "Sticky from June to September. Light, quick-dry clothes help."
      },
      {
        "icon": "🌡️",
        "title": "Big day-to-night swing in winter",
        "text": "January lows near 14°C. A light jacket is useful in the evening."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat and sunscreen; an umbrella for monsoon months; a light layer for winter nights."
      }
    ]
  }
