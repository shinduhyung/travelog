  "climate_guide": {
    "summary": "Temperate climate with warm summers and cold, grey winters. Rain is spread across the year, so pack layers and an umbrella any month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 20–26°C and long evenings. Ideal for the riverbank, old town and beer gardens."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold (December to February)",
        "text": "Highs of 5–8°C and lows near 0–1°C. Wear a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 9–14 rain days every month. November, December and January are the wettest."
      },
      {
        "icon": "🌂",
        "title": "Carry an umbrella",
        "text": "Showers are common and can be sudden. A light rain jacket beats an umbrella in wind."
      },
      {
        "icon": "🍂",
        "title": "September is the driest",
        "text": "About 9 rain days and highs near 21°C. A comfortable month for walking."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
