  "transit": {
    "best": "Metro for most trips; Didi or taxi for late nights and door-to-door rides.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Clean, cheap and fast. Single tokens cost ¥2–9 and run roughly 05:00–23:00. Line S1 links Nanjing South Station to the airport in about 30 min for ¥6."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses cost a flat ¥2 (some ¥1). An IC card gives about 20% off."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis start at ¥9 plus a ¥2 service fee; most trips cost under ¥25. Didi works well, but drivers rarely speak English, so show Chinese addresses."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed in the city; metro, buses and taxis cover the sights. Skip it unless you plan trips outside Nanjing."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in spring and autumn for Fuzimiao lanes, the city wall and lake paths. Hot and humid in summer, so walk early or late."
      },
      {
        "mode": "Shared bikes",
        "has": true,
        "text": "Hello and Meituan bikes are everywhere. Handy for short hops between metro stops and sights."
      },
      {
        "mode": "Tram",
        "has": true,
        "text": "Trams serve the southwest and Qilin Town. Useful only if your plans go that way."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, fairly dry winters and hot, humid, rainy summers. Spring and autumn are the best times to walk.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May and October",
        "text": "Highs around 21–26°C and comfortable lows. Ideal for the city wall, Purple Mountain and lake walks."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 29–32°C with muggy nights around 21–25°C. Do outdoor sights early morning."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in July",
        "text": "About 17 rain days in July and 12–13 in June and August. Carry a light rain jacket or umbrella."
      },
      {
        "icon": "❄️",
        "title": "Cold winters (December to February)",
        "text": "Highs around 8–11°C and lows near 0–1°C. Bring a warm coat, hat and gloves."
      },
      {
        "icon": "🍂",
        "title": "Dry, clear autumn",
        "text": "October and November have fewer rain days and mild highs. Great for photos and long walks."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, breathable clothes and rain gear for summer. Comfortable shoes for cobbled lanes."
      }
    ]
  }
