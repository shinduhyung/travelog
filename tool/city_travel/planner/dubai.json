    "best": "Metro for Downtown and Marina; taxis or ride apps for everything else.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Red and Green lines link the airport, Downtown and Marina; fares AED 3–7.50 with a Silver nol card."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses cover the rest of the city; tap out at the end of every ride."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Easy to flag; Careem and Uber both work in Dubai."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is common; rent a car with an International Driving Permit."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in Marina and Deira but hard in summer heat; abras cross the creek for AED 1–2."
      },
      {
        "mode": "Abra",
        "has": true,
        "text": "Small wooden boats cross the creek for AED 1–2; the cheapest ride in the city."
      }
    ]
