  "climate_guide": {
    "summary": "Hot desert climate: sunny nearly every day, very little rain, and a long, humid summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 24–31°C with cool evenings. Ideal for beaches, souks and the desert."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs of 39–41°C with humid nights near 30°C. Go outside only early or after dark."
      },
      {
        "icon": "💧",
        "title": "Humid by the coast",
        "text": "Muggy evenings from May to October; expect fogged sunglasses leaving air-conditioning."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "Only 0–2 rain days a month, mostly December to March. No umbrella needed most of the year."
      },
      {
        "icon": "🌪️",
        "title": "Occasional dust",
        "text": "Spring and early summer can bring hazy, dusty skies; desert trips may be cancelled."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, hat and strong sunscreen; a light layer for winter nights and cold AC; modest wear for souks and mosques."
      }
    ]
  }
