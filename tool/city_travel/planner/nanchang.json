      },
      {
        "mode": "Bus",
        "has": true,
        "text": "About ¥2 flat, more for double-deckers. Good coverage but slower in traffic."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis start at ¥6–8 and charge about ¥1.9/km, with a 20% night surcharge 23:00–05:00. Didi works well; tell drivers 'da biao' (use the meter)."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is busy in the centre. Only worth it for out-of-town trips; check licence rules first."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Easy in the centre and around Bayi Square and the old lanes. Use metro or taxi for longer hops."
      },
      {
