  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, fairly dry winters. Spring and autumn are the best times to walk the city.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April and October",
        "text": "Highs around 23–24°C with comfortable nights. Ideal for pavilions, squares and riverside walks."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs of 30–34°C and muggy nights near 27°C. Do sights early morning; rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in spring and early summer",
        "text": "March to June brings 15–20 rain days a month. Keep a compact umbrella and a backup indoor plan."
      },
      {
        "icon": "🧥",
        "title": "Cool winters (December to February)",
        "text": "Highs of 11–13°C and lows of 4–5°C. Bring a warm coat; buildings can feel cold."
      },
      {
        "icon": "☂️",
        "title": "Drier autumn",
        "text": "September and October see rain on only about 7–8 days. Good odds of clear days."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers and rain gear for spring and summer; a warm coat for winter; comfortable shoes for walking and metro trips."
      }
    ]
  }
