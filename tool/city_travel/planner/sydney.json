  "climate_guide": {
    "summary": "Warm temperate climate: mild winters, warm summers and rain spread through the year. Rarely very cold or very hot.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Warmest months, highs 25–27°C. Best for beaches and harbour days, but also the busiest and priciest."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Rain days run from 6 to 15 a month. March is wettest; August is driest. Showers often pass quickly."
      },
      {
        "icon": "🧥",
        "title": "Mild winters (June to August)",
        "text": "Highs around 17–18°C and lows near 8–9°C. Bring a warm layer; beach swims are for the brave."
      },
      {
        "icon": "🌊",
        "title": "Sea and sun",
        "text": "Summer sun is strong; use sunscreen and shade. Check flags and surf conditions at patrolled beaches."
      },
      {
        "icon": "🌂",
        "title": "Pack for changeable days",
        "text": "A light rain jacket and layers work in every month. Evenings cool down near the water."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "T-shirts and shorts for summer, a jumper and jacket for winter, comfortable walking shoes and a hat."
      }
    ]
  }
