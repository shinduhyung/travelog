  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, damp winters. Spring and autumn are the most comfortable.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Hot summers",
        "text": "July and August peak near 33°C with high humidity. Take midday breaks indoors."
      },
      {
        "icon": "🌧️",
        "title": "Rainy spring",
        "text": "March to June has the most rain days, up to 18 a month. Carry an umbrella."
      },
      {
        "icon": "🍂",
        "title": "Best time: October",
        "text": "Mild around 23°C with fewer rain days. Ideal for the mountain and river walks."
      },
      {
        "icon": "❄️",
        "title": "Cool winters",
        "text": "January highs near 10°C and lows near 3°C. Damp cold; pack warm layers."
      },
      {
        "icon": "💦",
        "title": "Humidity year-round",
        "text": "Summers feel hotter than the numbers; winters feel colder. Dress in layers."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes and rain gear for summer; a warm coat and umbrella for winter and spring."
      }
    ]
