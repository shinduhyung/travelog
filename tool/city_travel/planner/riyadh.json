  "climate_guide": {
    "summary": "Hot desert climate: near-constant sunshine, very little rain, and a fierce summer from May to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Days around 21–28°C and cool nights. Ideal for Diriyah, the old city and desert trips."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (May to September)",
        "text": "Highs of 39–43°C. Move between air-conditioned places by day; go out after sunset."
      },
      {
        "icon": "🌧️",
        "title": "Almost no rain",
        "text": "At most 2–3 rain days a month in winter and spring. No umbrella needed most trips."
      },
      {
        "icon": "🌙",
        "title": "Nights are cooler but not cool in summer",
        "text": "Summer lows stay near 26–30°C, so evenings are still hot. Winter nights drop to 9–11°C."
      },
      {
        "icon": "🧥",
        "title": "Pack layers for winter",
        "text": "December to February evenings are chilly. Bring a jacket and a light layer for strong indoor AC."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, hat and sunscreen; modest clothing for mosques and heritage sites; comfortable shoes for souq alleys."
      }
    ]
  }
