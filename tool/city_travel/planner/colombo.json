  "climate_guide": {
    "summary": "Tropical and hot all year, with a long wet season from April to October and drier, sunnier months from December to February.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to February",
        "text": "Warm days around 30–31°C and the fewest rain days, about 11 a month. Best for walking and the beach."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: April to October",
        "text": "Rain on 25–30 days a month, heaviest in May. Expect short heavy downpours, often in the afternoon."
      },
      {
        "icon": "🌡️",
        "title": "Hot and humid year-round",
        "text": "Highs stay near 28–31°C and lows near 23–25°C. Humidity makes it feel hotter."
      },
      {
        "icon": "🌂",
        "title": "Always carry rain cover",
        "text": "Even in dry months a shower is possible. A small umbrella or light rain jacket helps."
      },
      {
        "icon": "👕",
        "title": "What to pack",
        "text": "Light breathable clothes, sandals, sunscreen and a hat. A light layer for air-conditioned places."
      },
      {
        "icon": "🕌",
        "title": "Dress for temples",
        "text": "Cover shoulders and knees at religious sites. Remove shoes where asked."
      }
    ]
  }
