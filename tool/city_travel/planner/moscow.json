  "climate_guide": {
    "summary": "Continental climate with cold winters and warm summers. Rain falls in every month, so pack a layer and an umbrella.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 17–24°C and long days. Ideal for walking, parks and the river."
      },
      {
        "icon": "🥶",
        "title": "Winter is long and cold",
        "text": "December to February highs sit near -2 to -5°C. Wear a warm coat, hat, gloves and boots."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "Expect 8–14 rain days monthly. July and December are wettest; August is driest."
      },
      {
        "icon": "🧊",
        "title": "Icy streets in winter",
        "text": "Pavements can be slippery from November to March. Choose shoes with grip."
      },
      {
        "icon": "🌗",
        "title": "Short winter days",
        "text": "Daylight is limited in December and January. Plan indoor sights and start early."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Summer: light clothes and a rain jacket. Winter: heavy coat, thermals, hat, gloves and waterproof boots."
      }
    ]
  }
