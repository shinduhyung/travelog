  "climate_guide": {
    "summary": "Continental climate with cold winters and warm summers. Rain is spread across the year, heaviest in spring and autumn.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to June and September to October",
        "text": "Mild days around 18–24°C. Good for walking and day trips."
      },
      {
        "icon": "☀️",
        "title": "Summer is hot but not extreme",
        "text": "July and August reach about 30°C. Go to museums at midday and walk in the evening."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold",
        "text": "December to February see highs near 8–10°C and lows at or below freezing. Bring a warm coat."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "May is wettest with about 16 rain days. Keep a small umbrella handy in spring and autumn."
      },
      {
        "icon": "🌫️",
        "title": "Po valley haze",
        "text": "Winter days can be grey and foggy. Plan indoor sights as backup."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
