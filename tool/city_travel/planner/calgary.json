  "transit": {
    "best": "CTrain for downtown and nearby stops; walk the compact core and use buses or ride apps for the rest.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "CTrain light rail runs two lines, Red and Blue, through downtown on 7th Avenue South, which is transit-only."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Calgary Transit buses fill the gaps. A single fare is about $4 adult, $2.65 youth, free for ages 12 and under."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are metered. Uber is the main ride-hailing app and the only one authorized at the airport."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is easy outside rush hour. Downtown parking is expensive, so use park-and-ride at suburban stations."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Downtown is compact and walkable. The Bow River pathways are good for bikes and rentals."
      },
      {
        "mode": "Ferry",
        "has": false,
        "text": "No ferries; the city is inland."
      }
    ]
  },
  "climate_guide": {
    "summary": "Cold, dry winters and short, mild summers. Rain is spread through the year, heaviest in June.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Highs of 18–24°C and long days. Ideal for the river paths, parks and Rockies day trips."
      },
      {
        "icon": "🥶",
        "title": "Winter is genuinely cold",
        "text": "December to February highs sit near -2 to -3°C, with lows around -12°C. Pack a real coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June",
        "text": "About 13 rain days in June, versus 4–8 in most other months. Showers are usually short."
      },
      {
        "icon": "🍂",
        "title": "Spring and fall swing widely",
        "text": "April and October can be mild one day and cold the next. Layers beat a single heavy outfit."
      },
      {
        "icon": "❄️",
        "title": "Snow is possible in winter",
        "text": "February has the most snow days in the averages. Watch for icy sidewalks and check road conditions."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Summer: light layers and a rain jacket. Winter: insulated coat, boots, hat and gloves. Always bring a warm layer for evenings."
      }
    ]
  }
