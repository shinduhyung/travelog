  "climate_guide": {
    "summary": "Temperate continental climate: cold winters, warm summers and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 18–24°C. Best for parks, beer gardens and day trips."
      },
      {
        "icon": "❄️",
        "title": "Cold winters",
        "text": "December to February highs of 4–7°C and lows near -3 to -1°C. Snow is possible; pack a warm coat."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 11–16 rain days every month. May is wettest. Carry a small umbrella."
      },
      {
        "icon": "🌡️",
        "title": "Mild spring and autumn",
        "text": "April and October highs of 14–15°C. Good for walking with a jacket."
      },
      {
        "icon": "🧥",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes. Add gloves and a hat for winter."
      },
      {
        "icon": "🍺",
        "title": "Seasonal tips",
        "text": "Beer gardens are best June to September; Christmas markets run in December."
      }
    ]
