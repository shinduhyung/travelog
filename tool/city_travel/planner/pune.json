  "transit": {
    "best": "Use Uber, Ola or autos for most trips; the metro and buses are cheap for longer hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Two lines: Purple (PCMC to Swargate) and Aqua (Vanaz to Ramwadi). Useful for crossing the city; check the route on the day."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "PMPML buses reach most areas. Fares about ₹5–30; day passes cost ₹40–50. Cheap but can be slow."
      },
      {
        "mode": "Auto-rickshaw",
        "has": true,
        "best": true,
        "text": "Everywhere and handy for short trips. Insist on the meter; roughly ₹18 for the first 1.5 km."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Ola work well across the city. Local radio taxis also operate."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is busy but manageable. Two-wheelers are the local norm; helmets are compulsory. Scooter rental is about ₹200–300 a day for day trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in the old city and market areas in cooler months. Use rides for longer hops in the heat."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical with a hot, dry spring and a strong monsoon from June to September. October to February is the most comfortable.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Highs around 29–32°C and cool nights near 15–17°C. Ideal for forts, old-city walks and day trips."
      },
      {
        "icon": "🥵",
        "title": "Hot and dry: March to May",
        "text": "Highs reach 34–37°C with little rain. Sightsee early morning and evening; avoid midday sun."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon: June to September",
        "text": "Many rain days, up to 28 in July. Expect heavy showers; keep plans flexible and carry rain gear."
      },
      {
        "icon": "🌿",
        "title": "Green after the rain",
        "text": "October still has some rain days but hills and gardens look lush. Good for nature trips."
      },
      {
        "icon": "🧢",
        "title": "Sun protection",
        "text": "Even in cooler months the sun is strong at midday. Hat, sunscreen and water help."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a rain jacket or umbrella in monsoon, and a light layer for cool winter evenings."
      }
    ]
  }
