  "climate_guide": {
    "summary": "Northern city with cold winters and mild, bright summers. Rain falls year-round, so pack layers.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to August",
        "text": "Highs around 19–21°C with long daylight. Ideal for ferries, islands and walking."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (Dec–Feb)",
        "text": "Highs near -1 to 1°C and lows down to -6°C. Snow and ice are possible; wear warm, grippy shoes."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "Expect roughly 9–14 rain days a month. A light waterproof layer is worth packing all year."
      },
      {
        "icon": "🌱",
        "title": "Spring is slow",
        "text": "March stays near freezing; April warms to about 7°C. Bring a jacket even on sunny days."
      },
      {
        "icon": "🍂",
        "title": "Autumn cools fast",
        "text": "September around 15°C, October about 9°C. Layers and waterproof shoes help."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket and comfortable walking shoes. Add a warm hat and gloves from November to March."
      }
    ]
