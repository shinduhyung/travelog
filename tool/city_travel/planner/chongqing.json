    "best": "Metro for most trips; ride apps for hills, stairs and late nights.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Fast, cheap and air-conditioned, with announcements in Mandarin and English. Lines 3 and 10 link the airport to the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Frequent and cheap, but signs are mostly in Chinese. Useful for short local hops."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are yellow and metered; few drivers speak English, so show your destination in Chinese. DiDi works well; set up the app before you arrive."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not advised for visitors: steep, confusing roads and hard parking. Use metro and apps instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Expect stairs and hills everywhere. Biking is not advised in the centre. Wear good shoes."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "A short Liangjiang ferry crosses the river for about ¥10. A cheap way to see the skyline from the water."
      }
    ]
  },
  "climate_guide": {
    "summary": "Humid subtropical climate: mild winters, hot sticky summers, and rain in most months. Expect hills, stairs and haze.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best months: October to December",
        "text": "Highs of 12–22°C and fewer rainy days. Comfortable for walking the hills and riverfront."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs of 29–34°C with high humidity. Move slowly, carry water and rest at midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain in most months",
        "text": "Spring and autumn are wettest, with 14–17 rain days. Pack a compact umbrella and grippy shoes."
      },
      {
        "icon": "🥶",
        "title": "Cool, damp winter",
        "text": "January highs near 11°C and lows around 6°C. Buildings can feel cold; bring warm layers."
      },
      {
        "icon": "🌫️",
        "title": "Haze and mist",
        "text": "River mist and haze can hide the skyline. Views are clearest after rain or on cooler days."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes for stairs and hills, a rain jacket, and light breathable clothes for summer."
      }
    ]
  }
