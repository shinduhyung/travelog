  "transit": {
    "best": "Trams in the CBD and trains for longer hops; walk the grid for short trips.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Trains run every 10–20 minutes and reach the suburbs. A Night Network runs after midnight on Fri–Sat."
      },
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "Trams are free inside the CBD Free Tram Zone. Touch on with myki only if you travel beyond it."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses fill the gaps where trains and trams don't go. Pay with myki."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are metered; Uber, DiDi and Ola operate and often cost less. Handy for late nights."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Easy on freeways but CBD parking is costly. Skip the car in town; rent only for day trips."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The CBD grid is walkable. Shared bikes and scooters cover short hops."
      }
    ]
  },
  "climate_guide": {
    "summary": "Temperate and changeable: warm dry summers, cool wet winters, and rain possible in any month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Warm days around 24–26°C and fewer rain days. Ideal for the beach, gardens and outdoor dining."
      },
      {
        "icon": "🥶",
        "title": "Winter is cool and damp (June to August)",
        "text": "Highs only 13–14°C with 10–13 rain days a month. Bring a warm coat and plan indoor sights."
      },
      {
        "icon": "🌦️",
        "title": "Rain in every month",
        "text": "Expect 6–13 rain days whatever the season. Carry a small umbrella and a light layer."
      },
      {
        "icon": "🌡️",
        "title": "Weather changes fast",
        "text": "A warm morning can turn cool and showery by afternoon. Dress in layers you can add or shed."
      },
      {
        "icon": "🏖️",
        "title": "Beach days are summer-only",
        "text": "St Kilda and the bay are best December to March. Water stays cool even then."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for walking. Add a hat and sunscreen for summer."
      }
    ]
  }
