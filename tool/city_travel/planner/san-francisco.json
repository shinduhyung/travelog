  "climate_guide": {
    "summary": "Mild and Mediterranean-style: cool, wet winters and dry, foggy summers. Rarely hot or freezing.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: September to October",
        "text": "Warmest and driest months, highs near 21°C. Ideal for walking and the coast."
      },
      {
        "icon": "🌧️",
        "title": "Wet winters (Dec–Mar)",
        "text": "Around 8–10 rain days a month and highs of 13–15°C. Bring a waterproof jacket."
      },
      {
        "icon": "🌫️",
        "title": "Summer fog",
        "text": "June to August is dry but cool and foggy, highs 19–20°C. The coast is chillier than inland."
      },
      {
        "icon": "🧥",
        "title": "Layer up",
        "text": "Mornings and evenings are cool year-round. A light jacket helps every month."
      },
      {
        "icon": "💨",
        "title": "Wind on the bridge and coast",
        "text": "The Golden Gate and beaches are windy and colder than downtown. Wear a windproof layer."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes for hills, layers, a rain jacket in winter, and sunglasses for fog-free afternoons."
      }
    ]
