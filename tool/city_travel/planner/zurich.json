  "climate_guide": {
    "summary": "Temperate climate with four clear seasons. Summers are warm, winters are cold, and rain is possible in any month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Highs around 20–25°C and lows around 11–15°C. Best for the lake, boats and hill walks."
      },
      {
        "icon": "❄️",
        "title": "Winter is cold (December to February)",
        "text": "Highs around 4–7°C and lows near -2 to 0°C. Pack a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "About 12–18 rain days a month. May is the wettest. Always carry a small umbrella."
      },
      {
        "icon": "🌂",
        "title": "Plan indoor backups",
        "text": "Museums and cafés are good rainy-day options. Check the forecast each morning."
      },
      {
        "icon": "🌡️",
        "title": "Big swings between seasons",
        "text": "From about 4°C in January to 25°C in July. Layers work best in spring and autumn."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a waterproof layer and a warm jacket for winter. Light clothes for summer."
      }
    ]
  }
