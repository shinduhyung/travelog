  "climate_guide": {
    "summary": "Mild coastal climate: wet, cool winters and warm, dry summers. Rain is common from October to March.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Warm highs of 19–23°C and the fewest rain days. Ideal for parks, beaches and the seawall."
      },
      {
        "icon": "🌧️",
        "title": "Wet winters",
        "text": "November to January brings 19–20 rain days a month. Pack a waterproof jacket and shoes."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not freezing",
        "text": "Winter highs stay near 6°C and lows near 1–2°C. Snow is uncommon downtown."
      },
      {
        "icon": "🏖️",
        "title": "Short beach season",
        "text": "July and August are the only reliably warm beach months, around 22–23°C."
      },
      {
        "icon": "🌦️",
        "title": "Spring is showery",
        "text": "March to May warms from 9°C to 16°C but rain days stay at 9–16. Bring layers."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket and comfortable walking shoes year-round; sunscreen and a hat for summer."
      }
    ]
  }
