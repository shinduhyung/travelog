  "transit": {
    "best": "Metro for main sights; taxis or Didi for short hops, especially in winter cold.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Lines 1, 2 and 3 run 06:00–21:00; fares ¥2–5. Good for reaching the centre and Songbei."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses cover most of the city; fares ¥1–2, pay by IC card or cash."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are cheap; ask for the meter (请打表) and expect a ¥1 fuel surcharge. Didi works too; taxis often stop for extra passengers at peak."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Not advised for short visits; traffic is dense and signage is mostly Chinese."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine around Zhongyang Dajie and the old town. In winter, ice makes pavements slippery."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Summer ferries cross the Songhua River to Sun Island; tickets sold at the dock."
      }
    ]
  },
  "climate_guide": {
    "summary": "Long, very cold winters and short, warm, rainy summers. Winter is the headline season; summer is green and humid.",
    "items": [
      {
        "icon": "🧊",
        "title": "Winter is the draw",
        "text": "December to February highs sit between -12°C and -6°C. The Ice and Snow Festival runs in this window; check exact dates."
      },
      {
        "icon": "🧥",
        "title": "Pack for real cold",
        "text": "Thermal layers, a heavy down coat, hat, gloves and boots with grip. Wind makes it feel colder than the numbers."
      },
      {
        "icon": "🌧️",
        "title": "Summer is wet",
        "text": "June to August brings 14–15 rain days a month. Carry an umbrella and plan indoor backups."
      },
      {
        "icon": "🌤️",
        "title": "Best shoulder months",
        "text": "May and September are mild and drier, around 21°C highs. Good for walking and river trips."
      },
      {
        "icon": "☀️",
        "title": "Short daylight in winter",
        "text": "Days are short in December and January. Do outdoor sights in the morning and early afternoon."
      },
      {
        "icon": "👟",
        "title": "Watch your footing",
        "text": "Ice and packed snow make pavements slippery from November to March. Grippy boots help."
      }
    ]
  }
