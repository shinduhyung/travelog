  "climate_guide": {
    "summary": "Mild four-season climate with warm summers and cool winters. Rain falls all year, so keep plans flexible.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Warm days around 24–26°C and mild nights. Best for beaches and the Rambla."
      },
      {
        "icon": "🧥",
        "title": "Cool winters (June to August)",
        "text": "Highs near 14–15°C and lows near 9–10°C. Bring a warm jacket and layers."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 7–10 rain days every month. October is the wettest. A small umbrella helps."
      },
      {
        "icon": "🌬️",
        "title": "Breezy coast",
        "text": "The Rambla is windy; a light windproof layer is useful even in summer."
      },
      {
        "icon": "🌡️",
        "title": "No extreme heat",
        "text": "Summers are warm, not scorching. Evenings stay comfortable for outdoor dinners."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Summer: light clothes, sunscreen and a hat. Winter: warm layers, a coat and closed shoes."
