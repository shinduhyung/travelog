  "climate_guide": {
    "summary": "Temperate continental climate: cold winters, warm summers, and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days around 19–25°C and long evenings. Ideal for walking and outdoor cafés."
      },
      {
        "icon": "🥶",
        "title": "Cold winters (December to February)",
        "text": "Highs of 2–5°C and lows near or below freezing. Pack a proper coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 10–13 rain days every month. Carry a small umbrella or rain jacket any season."
      },
      {
        "icon": "🌡️",
        "title": "Big swings between seasons",
        "text": "From near 0°C in January to 25°C in July. Check the forecast before you pack."
      },
      {
        "icon": "🌳",
        "title": "Spring and autumn are mild",
        "text": "April, May, September and October are comfortable for sightseeing with a light layer."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobblestones; warm boots and gloves in winter."
      }
    ]
