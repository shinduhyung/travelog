  "transit": {
    "best": "Walk the compact centre; use metro or tram for longer hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "STIB/MIVB metro and trams reach most sights. A single ride costs about €2.10–2.60; tap a contactless bank card or buy a MOBIB card (about €6) for cheaper fares."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "STIB buses cover the city. De Lijn buses serve the airport and Flanders, but their tickets are not valid on STIB."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber, Bolt and local taxi apps work. Taxis from the airport cost around €60."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is slow and parking is costly. A low-emission zone covers the centre; check your car meets the rules."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre is compact and walkable. Shared bikes and scooters are common for longer trips."
      }
    ]
  },
  "climate_guide": {
    "summary": "Temperate and often cloudy: mild summers, cool winters and rain in every month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 18–23°C and the most daylight. Ideal for walking the centre and sitting outside."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 10–14 rain days every month. Showers are often short; carry a small umbrella."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "December to February highs of 6–8°C and lows near 2°C. A warm coat and layers are essential."
      },
      {
        "icon": "🌡️",
        "title": "Mild, not hot, summers",
        "text": "July and August peak near 23°C. Rarely very hot; evenings can still feel cool."
      },
      {
        "icon": "☁️",
        "title": "Grey skies are common",
        "text": "Overcast days are frequent. Plan museums and cafés as backups to outdoor plans."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobblestones. Add a scarf and gloves in winter."
      }
    ]
  }
