  "climate_guide": {
    "summary": "Humid continental climate: cold, grey winters and warm, pleasant summers. Rain is spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Highs around 23–26°C and lows near 16–20°C. Best for walking, parks and the lakefront."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs near 2–5°C and lows around -4°C. Dress in warm layers and plan indoor sights."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 10–16 wet days every month. April is the wettest; September the driest."
      },
      {
        "icon": "🍂",
        "title": "Spring and autumn are mild",
        "text": "Highs near 13–19°C in spring and 10–17°C in autumn. Changeable, so pack layers."
      },
      {
        "icon": "💨",
        "title": "Lake-effect weather",
        "text": "Winds off Lake Erie can bring sudden cold and snow in winter. Check the forecast on the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "A waterproof jacket and umbrella any month; warm coat, hat and gloves for winter; light layers for summer."
      }
    ]
  }
