  "climate_guide": {
    "summary": "Humid subtropical: hot, sticky summers with afternoon storms, and mild-to-cold winters. Spring and autumn are the sweet spots.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: April to May and September to October",
        "text": "Highs around 20–28°C with comfortable evenings. Ideal for walking downtown and outdoor music."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (June to August)",
        "text": "Highs near 30–32°C with muggy air. Do outdoor sights in the morning; rest indoors at midday."
      },
      {
        "icon": "⛈️",
        "title": "Summer storms",
        "text": "July and August bring the most rain days, around 15–17. Storms are often short but heavy; carry a small umbrella."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold but short",
        "text": "January highs near 9°C and lows around -1°C. A warm coat and layers are needed for evening walks."
      },
      {
        "icon": "🌧️",
        "title": "Rain is spread through the year",
        "text": "Most months see 9–17 rain days. Spring has more rain days than autumn, so pack a light rain jacket."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes and sunscreen for summer; a rain jacket; a warm coat and layers for December to February; comfortable shoes for walking downtown."
      }
    ]
  }
