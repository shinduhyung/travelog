  "climate_guide": {
    "summary": "Subtropical Miami: warm most of the year, with a wet, humid summer and a drier, milder winter.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to April",
        "text": "Highs around 24–28°C with fewer rain days. Ideal for the beach, walking and outdoor sights."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: June to September",
        "text": "About 22–25 rain days a month. Expect short, heavy afternoon storms; mornings are often clearer."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid summer",
        "text": "Highs near 30–31°C and lows around 25–26°C. Muggy nights; plan indoor breaks midday."
      },
      {
        "icon": "🌀",
        "title": "Hurricane season",
        "text": "Runs roughly June to November, peaking late summer and autumn. Check forecasts and travel insurance."
      },
      {
        "icon": "🏖️",
        "title": "Beach days",
        "text": "Comfortable from spring to autumn, but summer sun is strong. Use shade and sunscreen."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a rain jacket or umbrella for summer, sunscreen and a hat; a light layer for cooler winter evenings."
      }
    ]
  }
