  "climate_guide": {
    "summary": "Tropical coastal climate: hot, humid and sunny from spring to summer, with a wetter season from autumn to early winter.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: March to August",
        "text": "Mostly dry days at 24–34°C with fewer rain days. Good for beaches, sea swims and motorbike trips."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: September to December",
        "text": "Rain falls on 22–26 days a month. Showers come and go, so plan indoor sights and keep rain gear in your bag."
      },
      {
        "icon": "🥵",
        "title": "Hot afternoons (May to August)",
        "text": "Highs reach 32–34°C. Do outdoor sights before 11:00 and rest in the afternoon."
      },
      {
        "icon": "💧",
        "title": "Humidity year-round",
        "text": "Air feels heavy, especially near the sea. Carry water and wear light, breathable clothes."
      },
      {
        "icon": "🌊",
        "title": "Sea conditions change",
        "text": "Waves can be rough in the wet months. Check local warnings and follow lifeguard flags at the beach."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a hat, strong sunscreen, a compact rain jacket and a light layer for air-conditioned rooms. Bring modest clothes for temples."
      }
    ]
  }
