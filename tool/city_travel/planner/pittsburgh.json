  "transit": {
    "best": "Walk downtown and ride the free T there; use buses, the T or ride apps for hills and river crossings.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Light rail ('The T') serves downtown, the North Shore and the south. Free downtown between Allegheny and First Avenue stations."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Buses reach most neighbourhoods. Fare is $2.75 with ConnectCard or app; cash needs exact change. A $7 day pass gives unlimited rides, and tickets allow transfers for three hours."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber and Lyft are widely used and often cheaper than taxis. Street hailing is hard, so book in the app."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Handy for day trips, but hills and rivers make driving confusing. A GPS helps."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Downtown is walkable, but expect hills and steps. The two inclines are a paid ride, not a walk."
      },
      {
        "mode": "Incline",
        "has": true,
        "text": "Two historic inclines climb the hills for views. Fare is $2.75 with ConnectCard or app; cash exact fare."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, grey winters and warm, humid summers, with rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to October",
        "text": "Highs run about 18–29°C. May, September and October are the most comfortable for walking."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs near 3–7°C and lows down to about -5°C. Snow and ice are possible; wear warm, grippy shoes."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 10–16 wet days every month, peaking in spring and early summer. Pack a light rain jacket."
      },
      {
        "icon": "🥵",
        "title": "Humid summers",
        "text": "July and August highs near 28–29°C with muggy air. Do hilltop views and trails early in the day."
      },
      {
        "icon": "🍂",
        "title": "Crisp autumn",
        "text": "October highs near 18°C and cool nights. Good light and fall colours on the hills."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable walking shoes for hills and steps; a warm coat and hat in winter."
      }
    ]
