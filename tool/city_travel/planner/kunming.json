  "transit": {
    "best": "Metro for most trips; Didi or taxi for late nights and the airport.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Five lines run about 07:00–22:00, fares ¥2–10. Ticket machines take paper cash only, so keep small notes."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses cost ¥2 and run roughly 06:00–22:00. A bus card cuts fares to about ¥0.90."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis start at ¥8 plus a ¥3 fuel surcharge; insist on the meter. Didi works, and WeChat or Alipay are widely used to pay."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed for city sights. Use trains and buses for day trips instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in the centre and parks. Distances grow outside downtown, so mix walking with the metro."
      },
      {
        "mode": "Bikes / e-bikes",
        "has": true,
        "text": "Hostels rent bikes for about ¥20 a day. Shared e-bikes cost about ¥2.5 for the first 20 minutes."
      },
      {
        "mode": "Airport link",
        "has": true,
        "text": "Line 6 links Changshui Airport to East Bus Station, then Line 3 into downtown."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mild highland climate: cool, dry winters and a long, wet summer. Rarely hot, rarely freezing.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: October to April",
        "text": "Mild days around 15–24°C and fewer rainy days. Ideal for parks, temples and day trips."
      },
      {
        "icon": "🌧️",
        "title": "Wet summer (June to September)",
        "text": "Rain on most days, up to 26 rain days in July and August. Showers often pass; carry rain gear."
      },
      {
        "icon": "🧥",
        "title": "Cool nights all year",
        "text": "Lows drop to 4–8°C in winter. Even summer evenings are mild, so bring a light jacket."
      },
      {
        "icon": "☀️",
        "title": "Strong highland sun",
        "text": "Days are bright even in the wet season. Use sunscreen and a hat at altitude."
      },
      {
        "icon": "🍄",
        "title": "Mushroom season",
        "text": "Wild mushrooms peak in the wet months. Eat them only at busy restaurants, always cooked."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket and waterproof shoes for summer; a warm coat for winter nights."
      }
    ]
  }
