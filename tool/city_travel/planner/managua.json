  "transit": {
    "best": "Taxis for most trips; cheap numbered buses if you know the route and travel by day.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail in the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Numbered city buses are cheap (about C$2.50) but stop early; no night service. Bus 266 runs from Mercado Oriental to the airport along Carretera Norte."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are collective or private; agree the fare first. No Uber, and ride apps are limited, so book by phone or through your hotel."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is congested and addresses use landmarks, not street numbers. Useful for day trips; check insurance and parking."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine downtown and at Puerto Salvador Allende by day. Cycling is for the bold."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year, with a sharp dry season from December to April and a long wet season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Highs around 31–33°C with only a few rainy days. Best for walking and day trips."
      },
      {
        "icon": "🥵",
        "title": "Hottest: March and April",
        "text": "Highs near 34–35°C. Sightsee early morning and rest in the shade at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "Rain on 20–27 days a month. Showers are often heavy but short; plan indoor stops."
      },
      {
        "icon": "☔",
        "title": "Wettest: September and October",
        "text": "About 27 rainy days each. Carry an umbrella and a waterproof bag for phones."
      },
      {
        "icon": "🌡️",
        "title": "Warm nights",
        "text": "Lows stay around 23–25°C all year. Air-conditioning or a fan helps at night."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a hat and sunscreen; a rain jacket in the wet months; modest clothes for churches."
      }
    ]
  }
