  "climate_guide": {
    "summary": "Continental climate: cold winters, warm summers, and rain spread through the year.",
    "items": [
      {
        "icon": "❄️",
        "title": "Cold winters (Dec–Feb)",
        "text": "Highs near 0–4°C and lows down to -7°C. Wind off the lake makes it feel colder."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 8–14 rain days each month; April is wettest. Carry a light rain jacket."
      },
      {
        "icon": "☀️",
        "title": "Best months: May–September",
        "text": "Highs 19–27°C. Ideal for the lakefront, walking and outdoor dining."
      },
      {
        "icon": "🥵",
        "title": "Summer heat",
        "text": "July and August peak near 27°C with humid days. Plan indoor breaks at midday."
      },
      {
        "icon": "🍂",
        "title": "Crisp fall",
        "text": "September and October cool to 17–24°C with fewer rain days. Good for parks."
      },
      {
        "icon": "🧥",
        "title": "What to pack",
        "text": "Layers year-round; a warm coat, hat and gloves for winter; a rain jacket and comfortable shoes for walking."
