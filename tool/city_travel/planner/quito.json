  "climate_guide": {
    "summary": "High-altitude equatorial climate: mild all year, cool nights, and rain possible in any month. July to September is driest.",
    "items": [
      {
        "icon": "🌦️",
        "title": "Rain in most months",
        "text": "Rain days range from about 12 in July to 29 in March. A light rain jacket beats an umbrella in the wind."
      },
      {
        "icon": "🌡️",
        "title": "Mild days, cool nights",
        "text": "Highs stay near 17–19°C all year; lows are 7–9°C. Bring a warm layer for evenings."
      },
      {
        "icon": "☀️",
        "title": "Best time: July to September",
        "text": "Fewer rain days and slightly warmer days. Best odds for volcano views and hikes."
      },
      {
        "icon": "⛰️",
        "title": "Altitude matters",
        "text": "Quito sits very high. Take the first day easy, drink water and go slow on stairs."
      },
      {
        "icon": "🌤️",
        "title": "Mornings are clearer",
        "text": "Clouds and showers often build in the afternoon. Do outdoor sights early."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket, sturdy shoes and sunscreen. The sun is strong at altitude even when cloudy."
      }
    ]
  }
