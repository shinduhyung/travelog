  "climate_guide": {
    "summary": "Tropical city: hot all year, with a dry, cooler season from November to February and a long wet season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Highs around 31–32°C, lows 22–23°C and only 4–5 rain days. Best for temples and walking."
      },
      {
        "icon": "🥵",
        "title": "Hot season: March to May",
        "text": "Highs of 33–34°C. Sightsee early morning and late afternoon; rest in air-conditioning at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "20–26 rain days a month, often short heavy afternoon showers. Carry a light rain jacket or umbrella."
      },
      {
        "icon": "💧",
        "title": "Humid all year",
        "text": "Expect sticky air most days. Light, breathable clothes help; so does a spare shirt."
      },
      {
        "icon": "🌂",
        "title": "Plan around the rain",
        "text": "Keep indoor backups like malls, food courts and museums. Storms usually pass within an hour or two."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, sandals, sunscreen and a hat. Cover shoulders and knees for temples. A rain jacket for May–October."
      }
    ]
  }
