  "transit": {
    "best": "Walk in the centre; use U-Bahn and trams for longer hops and always validate your ticket.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Rheinbahn runs U-Bahn, trams and buses. Single ticket €3.80, 24-hour pass €7.60 (2026). Validate before boarding; fines €60 for unstamped tickets."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Rheinbahn buses fill the gaps where trams don't run. Same tickets as U-Bahn and trams; validate before boarding."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber, Bolt and Free Now work in Düsseldorf. Handy for late nights and airport runs."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "The city centre is an environmental zone; cars need a pollution sticker. Parking is limited, so a car is best for day trips out of town."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Walking is easy in the compact centre. Bike hire from about €9 a day is a good alternative."
      },
      {
        "mode": "Ferry",
        "has": false,
        "text": "No ferry across the Rhine. Use the bridges to cross between the centre and Oberkassel."
      }
    ]
  },
  "climate_guide": {
    "summary": "Temperate and changeable: mild summers, cool winters, and rain in every month. Pack layers and an umbrella year-round.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 11–17 rain days every month. Showers pass quickly; a small umbrella and a waterproof jacket help."
      },
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs around 19–24°C and long evenings. Ideal for the Rhine promenade, Altstadt terraces and parks."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "December to February highs are 6–8°C with lows near 1–3°C. A warm coat, scarf and gloves are worth packing."
      },
      {
        "icon": "🌡️",
        "title": "Rarely very hot",
        "text": "Summer highs top out near 24°C. Heatwaves are short; most days are comfortable for walking."
      },
      {
        "icon": "🍂",
        "title": "Good shoulder months",
        "text": "April, May, September and October are mild and less crowded. Rain is still likely, so keep plans flexible."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket, an umbrella and comfortable walking shoes. Add a warm coat and gloves for November to March."
      }
    ]
  }
