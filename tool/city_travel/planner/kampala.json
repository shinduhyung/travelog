    "best": "Use Uber, Bolt or SafeBoda for most trips; matatus are cheap but crowded.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail in the city."
      },
      {
        "mode": "Matatu (minibus)",
        "has": true,
        "text": "Fixed routes from Old Taxi Park and other stages; fares roughly UGX 1,000–3,000. Cheap but crowded and slow in traffic."
      },
      {
        "mode": "Boda-boda",
        "has": true,
        "text": "Fast but risky. Agree the fare first, usually UGX 3,000–20,000 in town. App bodas like SafeBoda include helmets."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber, Bolt, Faras and SafeBoda work in Kampala. Special-hire taxis rarely use meters; agree a fare, often UGX 15,000–20,000 for central trips."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is possible but hectic. Traffic is heavy and rain slows it further."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine by day in central areas. Use rides at night and in heavy rain."
      }
    ]
