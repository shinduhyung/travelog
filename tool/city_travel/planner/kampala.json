  "climate_guide": {
    "summary": "Kampala sits near the equator: warm days, mild nights and rain in every month, heaviest from March to May and October to November.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Warm days, mild nights",
        "text": "Highs stay around 25–28°C all year and lows around 17–19°C. Light layers are enough."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Every month has rain days, from about 13 in January and July to 26 in April."
      },
      {
        "icon": "☔",
        "title": "Wettest months",
        "text": "April, May, October and November are the rainiest. Expect short, heavy afternoon showers."
      },
      {
        "icon": "🌤️",
        "title": "Drier windows",
        "text": "January, February and July have the fewest rain days. Still carry a rain jacket."
      },
      {
        "icon": "🛣️",
        "title": "Rain and traffic",
        "text": "Heavy rain slows traffic and floods some roads. Build extra time into rides in wet months."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a rain jacket or umbrella, quick-dry shoes and mosquito repellent for evenings."
      }
    ]
  }
