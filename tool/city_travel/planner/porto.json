  "climate_guide": {
    "summary": "Mild Atlantic climate: wet from October to March, warm and dry in July and August.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 20–25°C and few rain days, especially July and August."
      },
      {
        "icon": "🌧️",
        "title": "Wettest months: October to March",
        "text": "Around 12–14 rain days a month. Bring a rain jacket and waterproof shoes."
      },
      {
        "icon": "🌡️",
        "title": "Mild winters",
        "text": "January highs near 13°C and lows near 7°C. Rarely freezing, but damp and chilly."
      },
      {
        "icon": "🥵",
        "title": "Warm summers, not extreme",
        "text": "July and August peak around 24–25°C. Comfortable for walking, but the hills are steep."
      },
      {
        "icon": "🌂",
        "title": "Rain can come any month",
        "text": "Even summer has a few wet days. A small umbrella is worth packing."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a rain jacket and comfortable shoes for cobbled hills. Add sunglasses and a hat for summer."
      }
    ]
  }
