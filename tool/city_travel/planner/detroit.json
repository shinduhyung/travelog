  "climate_guide": {
    "summary": "Four clear seasons: cold, snowy winters, mild springs, warm humid summers and crisp autumns. Rain falls year-round.",
    "items": [
      {
        "icon": "❄️",
        "title": "Winter is cold (Dec–Feb)",
        "text": "Highs around 1–4°C and lows near -6°C. Snow is likely. Bring a heavy coat, hat and gloves."
      },
      {
        "icon": "🌸",
        "title": "Spring is mild and wet",
        "text": "Highs climb from 7°C in March to 20°C in May. April is the wettest month with about 14 rain days."
      },
      {
        "icon": "☀️",
        "title": "Summer is warm and humid",
        "text": "Highs around 26–28°C from June to August. Not extreme, but muggy at times; mornings are best outdoors."
      },
      {
        "icon": "🍂",
        "title": "Autumn is crisp",
        "text": "Highs fall from 24°C in September to 9°C in November. A light jacket helps in the evenings."
      },
      {
        "icon": "🌧️",
        "title": "Rain any month",
        "text": "Expect roughly 9–14 rain days each month. Keep a compact umbrella handy."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm winter coat for Dec–Feb, and light clothes for summer. Comfortable shoes for walking."
      }
    ]
  }
