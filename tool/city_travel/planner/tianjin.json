  "transit": {
    "best": "Metro for most trips; Didi or taxi for short hops and late nights.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "10+ lines, fares ¥2–8, trains about 06:00–22:30. Line 2 links the railway station to Binhai Airport for ¥3."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Old but extensive network, about ¥1.5–2 a ride. Cheap; allow extra time."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis: ¥8 flag for 3 km, then about ¥1.7/km. Avoid touts at stations. Didi works widely; have your destination in Chinese."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed for a city visit; metro, taxi and Didi cover the sights."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Best in spring and autumn around the Five Great Avenues and the riverfront. Summer heat makes long walks hard."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "Metro Line 9 plus the TEDA tram reach the Binhai seaside area."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries run from Binhai to Dalian and Incheon. Check schedules on the day."
      }
    ]
  },
  "climate_guide": {
    "summary": "Four clear seasons: cold, dry winters and hot, rainy summers. Spring and autumn are the best times to walk the city.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Highs around 19–27°C with low rain. Ideal for the Five Great Avenues and the riverfront."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold and dry",
        "text": "January highs near 2°C and lows around -7°C, with about 1 rain day. Wear a heavy coat."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and wet",
        "text": "July and August reach about 32°C with around 13 rain days each. Go out early or late."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in midsummer",
        "text": "July and August are the wettest months. Keep an umbrella and a backup indoor plan."
      },
      {
        "icon": "🌬️",
        "title": "Spring can be breezy and dusty",
        "text": "March to May warms quickly; some days are windy. A light scarf helps."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat and gloves for winter, light breathable clothes and rain gear for summer."
      }
    ]
  }
