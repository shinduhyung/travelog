    "best": "Use Uber, Careem or taxis for most trips; the BRT bus is the cheap backbone.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram in Amman. Don't plan around rail."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "The BRT bus network is the fast backbone, about 0.610 JOD a ride. City buses are cheap but often Arabic-only; pay exact fare or swipe a Visa or MasterCard."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Yellow and grey taxis use meters; most trips in town stay under 2–5 JOD. Uber and Careem work well, with core rides about 1–4 JOD."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is common but traffic is heavy. Rental desks are at the airport and in town."
      },
      {
        "mode": "Walking",
        "has": false,
        "text": "Walking is patchy: steep hills, missing sidewalks and few crossings. Plan some rides."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mediterranean-style climate: hot, dry summers and cool, wet winters. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and October",
        "text": "Warm days around 23–28°C with little rain. Ideal for the Citadel and walking downtown."
      },
      {
        "icon": "🥵",
        "title": "Hot, dry summer (June to September)",
        "text": "Highs of 31–33°C and almost no rain. Sightsee early morning and evening; rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wet winter (December to February)",
        "text": "Highs of 12–15°C with 6–9 rainy days a month. Bring a warm layer and a rain jacket."
      },
      {
        "icon": "🌂",
        "title": "Rain is seasonal",
        "text": "Most rain falls from November to March. Summer months are almost completely dry."
      },
      {
        "icon": "🌡️",
        "title": "Cool nights year-round",
        "text": "Evenings drop fast, especially in winter. A light jacket helps in spring and autumn."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer; warm layers and a rain jacket for winter. Comfortable shoes for steep, hilly streets."
      }
    ]
  }
