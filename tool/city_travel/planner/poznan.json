    "best": "Walk in the compact centre; use trams for longer hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro in Poznań. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "MPK runs buses and trams. Tickets are time-based: 15 min 4 zł, 45 min 6 zł, 90 min 8 zł. A 24-hour ticket is 15 zł and a 7-day ticket is 50 zł."
      },
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "Trams are the quickest way around the centre and to Jeżyce and Wilda. Same time-based tickets as buses."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber and Bolt operate in Poznań. Handy for late nights and the airport."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Not recommended in the centre: traffic and limited parking. Useful only for day trips out of the city."
      },
      {
        "mode": "Walking",
