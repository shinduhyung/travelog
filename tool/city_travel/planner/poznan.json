  "climate_guide": {
    "summary": "Temperate climate with cold winters and mild, warm summers. Rain falls year-round on roughly 8–14 days a month.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 19–25°C and long days. Ideal for walking and outdoor cafés."
      },
      {
        "icon": "🧥",
        "title": "Cold winters (Dec–Feb)",
        "text": "Highs of 3–6°C and lows near or below freezing. Pack a proper coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect rain on 8–14 days each month. A small umbrella or rain jacket is worth packing any month."
      },
      {
        "icon": "🌡️",
        "title": "Big swings between seasons",
        "text": "From around 3°C in January to 25°C in July and August. Layer your clothes."
      },
      {
        "icon": "🍂",
        "title": "September is a sweet spot",
        "text": "Highs near 21°C with fewer rain days (about 8). Comfortable for sightseeing."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, a rain layer, and a warm jacket outside summer. Sunglasses for the long summer days."
      }
    ]
  }
