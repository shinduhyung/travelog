  "climate_guide": {
    "summary": "Four clear seasons: cold, sometimes snowy winters and warm, humid summers. Spring and autumn are the easiest months for walking.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: May, June, September and October",
        "text": "Highs around 17–25°C and lows around 9–15°C. Comfortable for the Freedom Trail and the waterfront."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs near 3–6°C and lows near -6 to -2°C. Snow and ice are possible; wear warm, waterproof boots."
      },
      {
        "icon": "🥵",
        "title": "Summer is warm and humid (July and August)",
        "text": "Highs near 28°C with lows near 18–19°C. Take indoor breaks and carry water."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "About 8–12 wet days a month. A small umbrella or rain jacket is worth packing year-round."
      },
      {
        "icon": "🍂",
        "title": "Autumn cools quickly",
        "text": "October highs near 17°C drop to about 11°C in November. Bring layers for evenings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, layers, and a rain layer. Add a warm coat, hat and gloves from December to March."
      }
    ]
  }
