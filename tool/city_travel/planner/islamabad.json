  "climate_guide": {
    "summary": "Four clear seasons: cool dry winters, a hot pre-monsoon spring, a wet humid monsoon in July–August, and a dry pleasant autumn.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: October to April",
        "text": "Mild to cool days and low rain. Ideal for Faisal Mosque, Taxila and the Margalla trails."
      },
      {
        "icon": "🥵",
        "title": "Hot before the monsoon (May–June)",
        "text": "Highs of 34–36°C. Sightsee early morning and rest at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon in July–August",
        "text": "About 19–20 rain days a month and humid nights. Short heavy showers; keep plans flexible."
      },
      {
        "icon": "🌦️",
        "title": "Spring showers",
        "text": "March has about 11 rain days. A light rain jacket helps on hill walks."
      },
      {
        "icon": "🧥",
        "title": "Cold winter nights",
        "text": "January lows near 6°C and December near 7°C. Bring a warm jacket for evenings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Modest, breathable clothing; sturdy shoes for trails; a warm layer in winter; sun protection year-round."
