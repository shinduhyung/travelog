  "climate_guide": {
    "summary": "Hot, humid coastal climate: long warm season, a short monsoon in July–August, and mild, dry winters.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Highs of 24–30°C with cooler nights. Ideal for the old city, bazaars and the seafront."
      },
      {
        "icon": "🥵",
        "title": "Hot season April to June",
        "text": "Highs of 32–34°C with high humidity. Do outdoor sights early; rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon in July and August",
        "text": "About 8 rain days each month, often heavy. Streets can flood; keep plans flexible."
      },
      {
        "icon": "💧",
        "title": "Humid near the sea",
        "text": "Sticky evenings for much of the year. Light, breathable clothes help."
      },
      {
        "icon": "🌊",
        "title": "Sea breeze",
        "text": "The coast is cooler and breezier than inland districts; Clifton is pleasant after sunset."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat and sunscreen; a light layer for winter nights and strong AC; an umbrella for July–August; modest dress for religious sites."
      }
    ]
  }
