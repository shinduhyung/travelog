  "transit": {
    "best": "Metro for the airport and main stations; Ola or Uber for everything else.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Blue and Green lines link the airport, Alandur and MGR Chennai Central. Fares ₹10–60. A one-day Tourist Travel Card costs ₹100, with ₹50 refunded on return."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "MTC city buses are very cheap, roughly ₹4–30; deluxe and AC buses cost more. Daily and weekly passes cost about ₹50 and ₹300 on normal and deluxe routes."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Ola and Uber work well and are usually cheaper than prepaid taxis. Autos use meters or you negotiate the fare first."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "Suburban trains are fast and cheap, from ₹5. Buy first class at peak times."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not a common choice for visitors; traffic is heavy. Use apps and the metro instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in Mylapore lanes and around markets in the cooler months. Hot and humid most of the year; take shade and water."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year, with a wet northeast-monsoon season from roughly October to December.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to February",
        "text": "Highs around 28–30°C and few rain days. Ideal for temples, markets and the beach."
      },
      {
        "icon": "🥵",
        "title": "Hot season April to June",
        "text": "Highs of 34–35°C with high humidity. Sightsee early morning and evening; stay in shade at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon October to December",
        "text": "Up to about 20 rain days a month. Rain can be heavy and cause local flooding; keep plans flexible."
      },
      {
        "icon": "🌂",
        "title": "Carry an umbrella May to December",
        "text": "Rain days rise from about 6 in May to a peak near 21 in November. Short, sharp showers are common."
      },
      {
        "icon": "💧",
        "title": "Humid near the coast",
        "text": "Sea breezes help at Marina and Elliot's Beach, but it stays muggy most of the year. Drink water often."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat and sunscreen; a light rain jacket or umbrella; modest clothing for temples (shoulders and knees covered)."
      }
    ]
  }
