  "climate_guide": {
    "summary": "Mild Atlantic climate: warm dry summers, cool wet winters, and rain mostly from October to March.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm and mostly dry, highs 23–28°C. Ideal for walking, trams and the riverfront."
      },
      {
        "icon": "🌧️",
        "title": "Wettest: October to March",
        "text": "Around 8–10 rain days a month. Showers pass; pack a compact umbrella."
      },
      {
        "icon": "🥵",
        "title": "July and August are hot",
        "text": "Highs near 28°C and very dry. Sightsee early morning and rest in the afternoon."
      },
      {
        "icon": "🌬️",
        "title": "Atlantic breeze",
        "text": "The river and ocean keep evenings cooler; a light layer helps after sunset."
      },
      {
        "icon": "🌂",
        "title": "Rain is rarely all day",
        "text": "Winter rain comes in spells. Plan indoor sights like museums as backup."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable shoes for cobbled hills, sunscreen and a hat in summer, a rain jacket in winter."
      }
    ]
  }
