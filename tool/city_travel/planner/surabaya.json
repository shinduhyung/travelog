  "transit": {
    "best": "Ride-hailing motorbike taxis (Gojek, Grab) for most trips; buses if you're saving money.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Commuter trains are very limited; don't plan around rail."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Suroboyo Bus and Trans Semanggi are air-conditioned, Rp 5,000, cashless only (QRIS or e-money card). Clean but waits run 15–30 min; track them on the GOBIS app."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Gojek, Grab and Maxim work well; use GoRide or GrabBike to beat traffic. Taxis are plentiful — check the meter (argo) is on. Green SM runs an electric fleet."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Possible, but traffic is heavy and parking is hard. Most visitors do better with ride apps."
      },
      {
        "mode": "Walking",
        "has": false,
        "text": "Patchy. Sidewalks are inconsistent, so use ride apps for anything beyond a few blocks."
      },
      {
        "mode": "Becak",
        "has": true,
        "text": "Cycle rickshaws are common. Agree a price first, around Rp 5,000–20,000."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries leave from Tanjung Perak harbour. Check schedules on the day."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical and hot all year, around 30–33°C by day. Rain is heavy from November to April and light from June to September.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Driest months, with only about 2–10 rain days. Good for walking and day trips."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: November to April",
        "text": "About 24–29 rain days a month. Showers are often short but heavy; plan indoor backups."
      },
      {
        "icon": "🥵",
        "title": "Hot every month",
        "text": "Highs stay near 30–33°C and lows near 24–25°C. October is the hottest month."
      },
      {
        "icon": "💧",
        "title": "Humid all year",
        "text": "Expect muggy air, especially near the coast. Light, breathable clothes help."
      },
      {
        "icon": "⛈️",
        "title": "Afternoon storms",
        "text": "In the wet season, storms often hit in the afternoon. Do outdoor sights in the morning."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a rain jacket or umbrella, sandals, sunscreen and mosquito repellent."
      }
    ]
  }
