  "transit": {
    "best": "Taxi, Uber or Careem for most trips; city buses if you're saving money.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "City buses cover the island and Yas. AED 2 + 5 fils per km with a Hafilat card. Cheap but slow. The free Yas Express shuttle links the Yas parks, mall and hotels."
      },
      {
        "mode": "Taxi / Uber / Careem",
        "has": true,
        "best": true,
        "text": "Silver metered taxis everywhere: AED 5 flag (AED 20 from the airport), AED 1.82/km, AED 12 minimum. Uber and Careem cost about the same and are handy for airport and late-night rides."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Wide, easy roads and cheap fuel. Strict speed cameras. Check whether your licence needs an International Driving Permit."
      },
      {
        "mode": "Walking",
        "has": false,
        "text": "Only pleasant November to March, and the city is spread out. Use taxis for anything over a few blocks in summer."
      }
    ]
  },
  "climate_guide": {
    "summary": "Hot desert climate: sunny almost every day, very little rain, and a long, humid summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Warm days around 24–30°C and cool evenings. Ideal for the Corniche, beaches and the desert."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to September)",
        "text": "Highs over 40°C with heavy humidity. Plan indoor sights by day; go outside only at sunrise or after dark."
      },
      {
        "icon": "💧",
        "title": "Humid, especially by the sea",
        "text": "Muggy evenings from May to October; sunglasses fog up stepping out of air-conditioning."
      },
      {
        "icon": "🌂",
        "title": "Almost no rain",
        "text": "A few short showers between December and March. No umbrella needed most of the year."
      },
      {
        "icon": "🌪️",
        "title": "Occasional sandstorms",
        "text": "Dusty shamal winds, mostly in spring and early summer, can haze the sky and cancel desert trips."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, a hat and strong sunscreen; a light layer for chilly indoor AC and winter nights; modest clothing for the Grand Mosque."
      }
    ]
  },
  "intro_line": "A city of grand mosques, island museums and desert horizons."
