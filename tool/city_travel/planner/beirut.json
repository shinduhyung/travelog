    "best": "Walk in the centre and on the Corniche; use taxi or ride apps for longer trips.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram. Don't plan around rail in the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "OCFTC blue-and-white buses and LCC red minibuses cost LBP500–1,000; flag them at the roadside."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Shared 'service' taxis charge a fixed LBP2,000 per person; agree the price first. Hail-taxis charge per destination, not distance; a cross-town ride is around LBP10,000. Uber and Bolt work; airport rides are often a fixed fare."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is heavy and aggressive. Only rent if you plan trips outside the city."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best in the compact centre and on the Corniche. Use taxis for longer or late-night trips."
      }
    ]
