  "climate_guide": {
    "summary": "Mediterranean climate: mild, wet winters and hot, dry summers by the sea.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to October",
        "text": "Warm to hot days, little rain and a warm sea. July and August are hottest and most humid."
      },
      {
        "icon": "🌧️",
        "title": "Wet winter (December to March)",
        "text": "About 9–14 rain days a month and highs of 16–19°C. Showers can be heavy; carry a rain jacket."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "Highs of 29–31°C with warm nights around 22–25°C. Sightsee early or late; rest at midday."
      },
      {
        "icon": "🌂",
        "title": "Spring and autumn are mild",
        "text": "April, May, October and November are comfortable for walking, with some rain in spring and autumn."
      },
      {
        "icon": "🌊",
        "title": "Sea and beach season",
        "text": "Beach clubs are busiest June to September. Sea is warmest in late summer."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer; a light layer for evenings; a rain jacket and umbrella for winter."
