  "climate_guide": {
    "summary": "Mediterranean climate: mild, wet winters and very hot, dry summers. Spring and autumn are best.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: March to May and October to November",
        "text": "Mild days around 20–29°C, good for walking the old city."
      },
      {
        "icon": "🥵",
        "title": "Summer is very hot (June to September)",
        "text": "Highs of 34–38°C. Sightsee early morning and evening; stay indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in winter",
        "text": "December to February has the most rain days (7–9 a month). Showers are usually short."
      },
      {
        "icon": "❄️",
        "title": "Cool winter nights",
        "text": "Lows around 7–9°C from December to February. Bring a warm jacket."
      },
      {
        "icon": "☀️",
        "title": "Sunny most of the year",
        "text": "Rain days drop to 1–4 from June to September. Sunscreen all year."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and a hat for summer; a jacket and umbrella for winter; comfortable shoes for cobbled lanes."
      }
