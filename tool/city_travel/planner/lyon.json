  "climate_guide": {
    "summary": "Semi-continental climate: warm to hot summers, cold winters, and rain spread across the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days around 20–28°C. July and August are hottest and driest."
