        "icon": "❄️",
        "title": "Cold winters",
        "text": "December to February highs near 7–8°C and lows near 1–2°C. Bring a warm coat."
      },
      {
        "icon": "🌡️",
        "title": "Hot summer afternoons",
        "text": "July and August reach about 28°C. Sightsee in the morning and rest in the shade at midday."
      },
      {
        "icon": "🍂",
        "title": "Mild spring and autumn",
        "text": "April, May, September and October are comfortable for walking, with highs of 17–23°C."
      },
