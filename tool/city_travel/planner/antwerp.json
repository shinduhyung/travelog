  "climate_guide": {
    "summary": "Temperate maritime climate: mild summers, cool winters, and rain in every month.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: May to September",
        "text": "Highs of 19–23°C and long days. Good for walking the centre and the docks."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 11–14 rain days every month. Carry a small umbrella or rain jacket."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "December to February highs of 7–9°C and lows near 2°C. Dress in layers."
      },
      {
        "icon": "☀️",
        "title": "Mild, not hot, summers",
        "text": "July and August peak near 23°C. Rarely need air-conditioning."
      },
      {
        "icon": "🌬️",
        "title": "Windy and changeable",
        "text": "Weather can shift within a day. Check the forecast each morning."
      },
      {
