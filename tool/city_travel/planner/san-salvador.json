  "climate_guide": {
    "summary": "Tropical highland climate: warm all year, with a sharp dry season from November to March and a long, wet season from May to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to March",
        "text": "Highs around 29–31°C, lows near 19°C, and few rain days. Ideal for walking the centre."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "Rain on 24–29 days a month. Showers often hit in the afternoon; do outdoor sights early."
      },
      {
        "icon": "🌡️",
        "title": "Warm year-round",
        "text": "Highs stay between 27 and 31°C every month. Evenings are mild, around 19–21°C."
      },
      {
        "icon": "🌂",
        "title": "Pack rain gear in the wet months",
        "text": "A light raincoat or umbrella and quick-dry shoes help from May to October."
      },
      {
        "icon": "⛰️",
        "title": "Cooler, greener hills",
        "text": "The wet months turn the hills around the city lush; views are best on clear mornings."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
