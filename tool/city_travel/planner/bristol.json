  "climate_guide": {
    "summary": "Temperate maritime climate: mild, often cloudy and rain in any month. Rarely very hot or very cold.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: May to September",
        "text": "Highs of 16–21°C and long daylight. Best for walking the harbour and Clifton."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 10–15 rain days every month. Showers pass quickly; carry a small umbrella or waterproof."
      },
      {
        "icon": "❄️",
        "title": "Mild winters",
        "text": "January and February highs near 8–9°C, lows near 2–4°C. Frost is possible but snow is rare."
      },
      {
        "icon": "🧥",
        "title": "Layers work best",
        "text": "Days can warm up then cool fast. A light jacket and a warm mid-layer cover most trips."
      },
      {
        "icon": "☀️",
        "title": "Summer is gentle",
        "text": "July peaks near 21°C. No need for air-conditioning; evenings stay around 13°C."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Waterproof jacket, comfortable walking shoes for hills and cobbles, and a warm layer for evenings."
      }
    ]
  }
