    "best": "Walk the centre and Harbourside; use buses or e-scooters for Clifton and longer hops.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or tram in Bristol. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "best": true,
        "text": "Buses cover the centre and suburbs. Contactless tap fares are around £2–3."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "The Severn Beach line links Temple Meads with Clifton Down and Avonmouth. Handy for a car-free day out."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Taxis are common; Uber and Bolt both operate in Bristol."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is slow in the centre. Use Park and Ride at Portway, Brislington or Long Ashton."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre and Harbourside are easy on foot. Temple Meads is about a 15 min walk."
      },
      {
        "mode": "E-scooter / e-bike",
