  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, fairly dry winters. Spring and autumn are the best seasons.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April and October",
        "text": "Around 22–23°C by day with moderate rain. Ideal for West Lake and tea villages."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 29–33°C with many rain days. Go out early and rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June",
        "text": "About 18 rain days. Carry a small umbrella and plan indoor sights."
      },
      {
        "icon": "❄️",
        "title": "Cool winters (December to February)",
        "text": "Highs near 10–12°C, lows near 1–3°C. Rare snow, but damp cold feels sharp."
      },
      {
        "icon": "🍂",
        "title": "Dry, clear autumn",
        "text": "October and November are the driest and clearest months for photos."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a rain jacket in summer, and a warm coat in winter. Comfortable shoes for lake paths."
      }
