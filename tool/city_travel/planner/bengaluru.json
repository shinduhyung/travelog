  "climate_guide": {
    "summary": "Tropical highland city: mild all year, with a long monsoon from June to October.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Dry, mild days around 26–30°C and cool nights. Ideal for parks, markets and walking."
      },
      {
        "icon": "🥵",
        "title": "Hot before the rains (March to April)",
        "text": "Highs reach 33–34°C. Sightsee in the morning and stay shaded at midday."
      },
      {
        "icon": "🌧️",
        "title": "Long monsoon (June to October)",
        "text": "Rain on 16–24 days a month. Expect short heavy showers; carry an umbrella and plan indoor backups."
      },
      {
        "icon": "🌂",
        "title": "May is the changeover",
        "text": "About 16 rain days as pre-monsoon showers arrive. Weather can flip within an hour."
      },
      {
        "icon": "🌡️",
        "title": "Cool nights all year",
        "text": "Lows stay around 16–21°C. A light layer helps in the evening and in air-conditioned places."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a rain jacket or umbrella in monsoon months, comfortable shoes for patchy pavements, and sunscreen."
      }
    ]
  }
