  "climate_guide": {
    "summary": "Tropical climate: hot all year, with a dry season roughly December to April and a very wet season May to November.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: January to March",
        "text": "Highs 30–32°C and only 5–9 rain days. Best for the canal, old town and nature walks."
      },
      {
        "icon": "🌧️",
        "title": "Wet season May to November",
        "text": "Rain on 28–30 days most months. Showers are often heavy but pass; plan indoor backups."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid year-round",
        "text": "Lows stay near 24–25°C. Drink water and take midday breaks."
      },
      {
        "icon": "🌂",
        "title": "Pack rain gear",
        "text": "A light rain jacket or umbrella helps from May to November."
      },
      {
        "icon": "🦟",
        "title": "Mosquitoes in the wet months",
        "text": "Use repellent for parks and evenings, especially May to November."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light breathable clothes, sun hat, sunscreen, rain layer and comfortable walking shoes."
      }
