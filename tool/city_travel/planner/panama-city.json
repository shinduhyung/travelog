  "transit": {
    "best": "Metro for main routes; taxis or ride apps for the old town and canal.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "Line 1 runs underground from Albrook to El Ingenio; Line 2 serves the northern suburbs. Fare B/.0.35 on Line 1 and B/.0.50 on Line 2; last train about 22:00."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Metrobuses need a RapiPass card (about B/.2 plus top-up); cash is not accepted at turnstiles."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis have no meter; fares are zone-based, roughly B/.1.25 in one zone up to B/.5 across town. Uber and inDrive work; agree the price before a street taxi ride."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Useful for day trips outside the city; city traffic is busy. Check parking at your hotel."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Good in Casco Antiguo and along the Causeway. Use taxis for longer hops in the heat."
      }
    ]
