  "climate_guide": {
    "summary": "High-altitude, semi-arid climate: sunny much of the year, cold winters, warm summers and quick afternoon storms in summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Warm, mostly dry days with highs around 28–31°C. Ideal for trails and outdoor sights."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (December to February)",
        "text": "Highs near 5–7°C and lows around -10°C. Snow and ice are possible; bring a warm coat and boots."
      },
      {
        "icon": "⛈️",
        "title": "Summer afternoon storms",
        "text": "July and August often bring afternoon thunderstorms. Hike early and be off exposed ridges by midday."
      },
      {
        "icon": "🌂",
        "title": "Wettest in spring",
        "text": "May has the most rain days (about 13). Carry a light rain jacket in spring."
      },
      {
        "icon": "🏔️",
        "title": "High altitude",
        "text": "Denver sits about a mile high. Take it easy on day one, drink water and use sunscreen."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers year-round, a warm jacket for winter, sun protection in summer and sturdy shoes for trails."
      }
    ]
  }
