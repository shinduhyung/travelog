  "climate_guide": {
    "summary": "Hot most of the year, with a warm monsoon from June to October. Best months are November to February.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Highs around 28–31°C and cool nights. Ideal for forts, bazaars and long walks."
      },
      {
        "icon": "🥵",
        "title": "Hot season: March to May",
        "text": "Highs reach 34–37°C. Sightsee early morning and stay indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon: June to October",
        "text": "18–21 rain days in the wettest months. Showers are often short; carry a light rain jacket."
      },
      {
        "icon": "💧",
        "title": "Humidity in the rains",
        "text": "Sticky days from June to September. Loose cotton clothes help."
      },
      {
        "icon": "🌂",
        "title": "Rain plan",
        "text": "Keep one indoor backup per day: museums, malls or a long lunch."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat, sunscreen and a small umbrella for monsoon months. A light layer for December nights."
      }
    ]
  }
