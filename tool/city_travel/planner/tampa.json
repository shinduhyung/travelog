  "transit": {
    "best": "Ride apps or a rental car for most trips; the free streetcar for downtown and Ybor.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro or train inside the city. Don't plan around rail."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "HART buses cover Hillsborough County, about $1.75 local and $2.75 commuter express. PSTA buses serve Pinellas County and connect the airport to downtown Tampa."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Uber and Lyft operate. Taxis are metered; book by app or phone."
      },
      {
        "mode": "Rental car",
        "has": true,
        "best": true,
        "text": "Driving is convenient but rush hours (7:30–9:30AM, 3:30–7:30PM) are slow, especially on I-275."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Downtown is walkable. Bikes and scooters work for short trips, but summer heat is strong."
      },
      {
        "mode": "Streetcar",
        "has": true,
        "text": "TECO Line Streetcar is fare-free and links downtown to Ybor City, roughly every 20 min."
      }
    ]
  },
  "climate_guide": {
    "summary": "Subtropical and humid. Mild, dry winters and hot, stormy summers with heavy afternoon rain.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to April",
        "text": "Highs of 21–28°C with few rain days. Ideal for walking, beaches and outdoor sights."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (June to September)",
        "text": "Highs near 31°C and lows near 24–25°C. Plan outdoor time for early morning."
      },
      {
        "icon": "⛈️",
        "title": "Heavy summer rain",
        "text": "June to September brings 20–27 rain days a month, often short afternoon storms. Keep plans flexible."
      },
      {
        "icon": "🌂",
        "title": "Pack a rain jacket in summer",
        "text": "Storms pass quickly but soak you. An umbrella or light rain shell helps."
      },
      {
        "icon": "🌊",
        "title": "Beach days are best in spring and fall",
        "text": "April, May, October and November give warm water with less rain. Check conditions on the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a hat and strong sunscreen. Add a light layer for winter evenings and indoor AC."
      }
    ]
  }
