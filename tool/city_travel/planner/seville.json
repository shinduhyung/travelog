  "climate_guide": {
    "summary": "Hot, dry summers and mild, sunny winters. Spring and autumn are the best times to walk the old city.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: March to May and October to November",
        "text": "Mild days, roughly 16–27°C, and comfortable evenings. Best for walking and outdoor tapas."
      },
      {
        "icon": "🥵",
        "title": "Summer is extreme (June to August)",
        "text": "Highs reach about 33–37°C with almost no rain. Visit sights early, rest midday and go out again after dark."
      },
      {
        "icon": "🌧️",
        "title": "Rain is mostly in winter and spring",
        "text": "Rainy days cluster from October to March, with the most in March. Showers are usually short."
      },
      {
        "icon": "🌙",
        "title": "Cool winter evenings",
        "text": "December to February can dip to about 6–8°C at night. Bring a jacket for evening walks."
      },
      {
        "icon": "🧴",
        "title": "Strong sun, even in spring",
        "text": "Sun is strong from April. Use sunscreen, a hat and water, and seek shade in the middle of the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes for summer, layers for winter, comfortable walking shoes for cobbled streets, and a small umbrella for spring and autumn."
      }
    ]
  }
