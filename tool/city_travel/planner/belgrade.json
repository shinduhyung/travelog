  "climate_guide": {
    "summary": "Continental climate: cold winters, warm to hot summers, and rain spread fairly evenly through the year.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to June and September to October",
        "text": "Mild highs of about 18–27°C and fewer extreme days. Ideal for walking the fortress and old town."
      },
      {
        "icon": "🥵",
        "title": "Summer can be hot (July–August)",
        "text": "Highs near 29°C and warm nights around 19°C. Sightsee in the morning; evenings are for the river clubs."
      },
      {
        "icon": "❄️",
        "title": "Winter is cold (December–February)",
        "text": "Highs of 5–10°C and lows near or below freezing. Snow is possible. Bring a proper coat and warm shoes."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 7–13 rain days every month, peaking in May. A compact umbrella is worth packing any month."
      },
      {
        "icon": "🌡️",
        "title": "Big swings between seasons",
        "text": "From about 5°C highs in January to 29°C in July–August. Check the forecast before you pack."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers and a light rain jacket in spring and autumn; a warm coat, hat and gloves in winter; light clothes and sunscreen in summer."
      }
    ]
  }
