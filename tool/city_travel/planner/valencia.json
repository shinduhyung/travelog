  "climate_guide": {
    "summary": "Mediterranean climate: mild winters, hot dry summers and a short rainy spell in spring and autumn.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to June and September to October",
        "text": "Warm days around 24–28°C with few rain days. Good for both sightseeing and the beach."
      },
      {
        "icon": "🥵",
        "title": "July and August are hot",
        "text": "Highs of 31°C and nights near 22°C. Sightsee early, rest at midday, swim in the evening."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in March and September",
        "text": "About 8 rain days each. Showers are often short; carry a light rain jacket."
      },
      {
        "icon": "🌤️",
        "title": "Mild winters",
        "text": "January and December highs of 16–17°C with cool nights near 7–8°C. A coat is enough."
      },
      {
        "icon": "🏖️",
        "title": "Beach season",
        "text": "Sea and sand are best from June to September. May and October are fine for a walk, cooler for swimming."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and sunscreen for summer, a warm layer for winter, and a small umbrella in spring and autumn."
      }
    ]
  }
