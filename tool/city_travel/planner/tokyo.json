  "climate_guide": {
    "summary": "Four clear seasons: cold dry winters, a humid rainy season in June, and hot, sticky summers.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: March to May and October to November",
        "text": "Mild days around 17–23°C. Ideal for walking neighbourhoods and day trips."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (July to September)",
        "text": "Highs near 30–31°C with muggy nights. Plan indoor sights midday and go out early or late."
      },
      {
        "icon": "🌧️",
        "title": "Rainy season in June",
        "text": "About 15 rain days and 26°C. Carry an umbrella and keep a museum or shopping backup."
      },
      {
        "icon": "❄️",
        "title": "Cold, dry winters",
        "text": "January highs near 9°C and lows around 0°C. A warm coat and layers matter; rain is light."
      },
      {
        "icon": "🌀",
        "title": "Typhoon season",
        "text": "Late summer and September can bring storms. Check forecasts and train status on the day."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Comfortable walking shoes, layers for cool evenings, an umbrella in June and September, and light breathable clothes in summer."
      }
    ]
