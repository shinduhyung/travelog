  "climate_guide": {
    "summary": "Temperate and changeable: mild summers, cold winters and rain in every month. Pack layers and a rain jacket year-round.",
    "items": [
      {
        "icon": "🌤️",
        "title": "Best time: June to September",
        "text": "Highs of 19–24°C and the most daylight. Ideal for the old town, valley walks and outdoor cafés."
      },
      {
        "icon": "🌧️",
        "title": "Rain in every month",
        "text": "About 10–15 rain days a month, most in November to January. A light waterproof beats an umbrella in wind."
      },
      {
        "icon": "❄️",
        "title": "Cold winters",
        "text": "December to February highs of 4–7°C and lows near 0°C. Snow is possible but not guaranteed; check on the day."
      },
      {
        "icon": "🧥",
        "title": "Layers are key",
        "text": "Days can swing from cool mornings to warm afternoons. Bring a jacket even in summer evenings."
      },
      {
        "icon": "☀️",
        "title": "Long summer days",
        "text": "July and August give late sunsets, good for evening walks on the ramparts and in the Grund."
      },
      {
        "icon": "🎄",
        "title": "Winter charm",
        "text": "December is cold and wet but festive, with Christmas markets in the centre. Dress for damp cold."
      }
    ]
  }
