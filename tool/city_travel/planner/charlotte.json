  "climate_guide": {
    "summary": "Humid subtropical: hot, stormy summers and mild-to-cold winters. Spring and autumn are the most comfortable.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May, September, October",
        "text": "Highs around 22–28°C with fewer rain days. Ideal for walking, parks and outdoor dining."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 31–33°C and muggy. Do outdoor sights early; expect afternoon thunderstorms."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in summer",
        "text": "August has about 15 rain days, July about 13. Showers are often short; carry a light rain jacket."
      },
      {
        "icon": "❄️",
        "title": "Cold winters (December to February)",
        "text": "Highs near 10–14°C and lows near 1–3°C. Snow is rare but possible; pack warm layers."
      },
      {
        "icon": "🌤️",
        "title": "Shoulder months are mild",
        "text": "March and November sit around 16–17°C highs. Comfortable with a jacket, good for city walks."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Breathable clothes and sunscreen for summer; a warm coat and layers for winter; an umbrella or rain jacket year-round."
      }
    ]
  }
