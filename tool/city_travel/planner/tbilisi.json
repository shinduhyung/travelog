  "climate_guide": {
    "summary": "Tbilisi has four clear seasons: cold winters, mild springs, hot dry-ish summers and a warm, pleasant autumn.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best months: May, September and October",
        "text": "Mild to warm days around 17–25°C. September is warm and drier than spring."
      },
      {
        "icon": "☀️",
        "title": "Hot summer (July–August)",
        "text": "Highs near 30°C. Sightsee in the morning, then rest or stay indoors in the afternoon."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in spring",
        "text": "March, April and May have the most rain days (12–14). Carry a small umbrella."
      },
      {
        "icon": "❄️",
        "title": "Cold winter (December–February)",
        "text": "Highs of 6–8°C and lows near or below freezing. A warm coat and shoes are essential."
      },
      {
        "icon": "🍂",
        "title": "Autumn is a sweet spot",
        "text": "September and October are warm and drier, with 7–9 rain days. Great for walking and day trips."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, and light clothes plus sun protection for summer. Good walking shoes for uneven pavements."
      }
    ]
  }
