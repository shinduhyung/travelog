  "climate_guide": {
    "summary": "Humid subtropical climate: hot summers, cool-to-cold winters, and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: March to May and September to November",
        "text": "Mild highs of 17–25°C. Good for walking, parks and outdoor sights."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (December to February)",
        "text": "Highs near 27–28°C with muggy nights. Sightsee early or late; rest at midday."
      },
      {
        "icon": "🧥",
        "title": "Winter is cool (June to August)",
        "text": "Highs of 14–16°C and lows near 8°C. Pack a warm coat and layers."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 6–9 rain days each month. Showers can be heavy but short; carry a small umbrella."
      },
      {
        "icon": "🌬️",
        "title": "Windy days",
        "text": "Breezy spells, especially near the river in Puerto Madero. A light windproof layer helps."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, comfortable walking shoes, a light rain jacket and sunscreen for summer."
      }
