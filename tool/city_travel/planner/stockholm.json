  "climate_guide": {
    "summary": "Northern coastal climate: cold winters, mild summers, and rain spread across the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs from about 16°C to 22°C. Long daylight makes walking and ferries easy."
      },
      {
        "icon": "🥶",
        "title": "Winter is cold (Dec–Feb)",
        "text": "Highs near 1–2°C and lows around -4°C. Pack a warm coat, hat and gloves."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 8–12 rain days each month. July is the wettest. Carry a small umbrella."
      },
      {
        "icon": "🌡️",
        "title": "Mild summer, not hot",
        "text": "July highs near 22°C. Evenings can be cool, so bring a light layer."
      },
      {
        "icon": "🌗",
        "title": "Big daylight swing",
        "text": "Very long days in June, very short in December. Plan winter sightseeing for midday."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes. Add warm winter gear from November to March."
      }
