  "climate_guide": {
    "summary": "Tropical monsoon climate: a cool dry winter, a hot sticky spring, and a long, very wet summer.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: November to February",
        "text": "Dry, mild days around 24–29°C and cooler evenings. Ideal for walking and the old city."
      },
      {
        "icon": "🥵",
        "title": "Hot season: March to May",
        "text": "Highs reach 33°C with rising humidity. Go out early and rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Monsoon: June to September",
        "text": "Rain on 25–28 days a month. Expect flooded streets and traffic delays; carry an umbrella."
      },
      {
        "icon": "💧",
        "title": "Humid most of the year",
        "text": "Lows stay near 24–26°C in the wet months. Light, breathable clothes help."
      },
      {
        "icon": "🌂",
        "title": "Pack for rain in summer",
        "text": "A compact umbrella and quick-dry shoes are useful from May to October."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light cotton clothes, a hat and sunscreen; a light layer for December–January evenings; modest dress for mosques."
      }
    ]
  }
