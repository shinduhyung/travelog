    "best": "Walk the centre; use trams for longer hops and ride apps for the airport.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro in Bratislava. Don't plan around rail inside the city."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Bus 61 links the airport to the main train station; N61 runs at night. Buy tickets from machines before boarding."
      },
      {
        "mode": "Tram / Trolleybus",
        "has": true,
        "best": true,
        "text": "Trams and trolleybuses cover the centre. Buy tickets from machines before boarding."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "text": "Uber, Bolt, Hopin and Liftago work reliably. Airport taxis are pricey; use an app instead."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is easy, but parking in the old town is scarce and costly."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "The centre is very walkable. Bikes are fine along the Danube."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "A ferry runs on the Danube to Devín and across to Austria in season."
