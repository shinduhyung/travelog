  "climate_guide": {
    "summary": "Continental climate: cold winters, warm summers and rain spread through the year.",
    "items": [
      {
        "icon": "🌡️",
        "title": "Best time: May to September",
        "text": "Highs from about 20°C to 28°C. Comfortable for walking the old town and castle."
      },
      {
        "icon": "❄️",
        "title": "Cold winters (December to February)",
        "text": "Highs of 4–8°C and lows near or below freezing. Warm coat, hat and gloves needed."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 7–11 rain days every month. May and June are the wettest; March the driest."
      },
      {
        "icon": "☀️",
        "title": "Sunny summers",
        "text": "July and August reach about 28°C with around 8 rain days. Long daylight hours."
      },
      {
        "icon": "🍂",
        "title": "Mild shoulder months",
        "text": "April and October sit around 16°C, good for sightseeing with fewer crowds."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers and a waterproof jacket any month; a warm coat for winter; light clothes and sunscreen for summer."
      }
    ]
  }
