  "climate_guide": {
    "summary": "Four clear seasons: cold dry winters, hot humid summers with the most rain, and pleasant spring and autumn.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and September to October",
        "text": "Mild highs of about 20–27°C. Ideal for the springs, Daming Lake and walking the old streets."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (June to August)",
        "text": "Highs near 32°C with lows around 22–24°C. Go out early or after sunset."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in July and August",
        "text": "About 13–14 rain days each month. Pack a light umbrella and a waterproof layer."
      },
      {
        "icon": "❄️",
        "title": "Cold, dry winter (December to February)",
        "text": "Highs of 5–9°C and lows down to -4°C. Very few rainy days; wear a warm coat."
      },
      {
        "icon": "🌬️",
        "title": "Spring can be breezy and dry",
        "text": "March to May warms quickly with only a few wet days. A light jacket helps on windy days."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for winter, and light breathable clothes plus an umbrella for summer."
      }
    ]
  }
