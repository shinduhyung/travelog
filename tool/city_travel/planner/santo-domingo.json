    "best": "Walk the Zona Colonial and Malecón; use Uber or InDrive for longer trips.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "text": "Two lines, RD$20 per ride with a smartcard (RD$60 card plus RD$20 minimum). Useful for some cross-city trips."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Cheap but confusing; fares around RD$20–40. Fine if you have time and local help."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis have no meters, so agree the fare before you get in. Uber and InDrive work and are often easier."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is chaotic; not recommended for short visits."
      },
      {
        "mode": "Walking",
        "has": true,
        "best": true,
        "text": "Best in the Zona Colonial and along the Malecón. Sidewalks are uneven, so watch your step."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferry to Puerto Rico (Mayagüez or San Juan) is about US$200 roundtrip and takes around 12 hours."
      }
