  "climate_guide": {
    "summary": "Tropical climate: warm all year, with a wetter season from May to October and a drier, slightly cooler stretch from November to April.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: December to March",
        "text": "Highs around 28–29°C and fewer rain days. Ideal for walking the Colonial Zone."
      },
      {
        "icon": "🌧️",
        "title": "Wet season: May to October",
        "text": "About 20–23 rain days a month. Showers are often short and heavy; plan around them."
      },
      {
        "icon": "🥵",
        "title": "Hottest months: July and August",
        "text": "Highs near 31°C with warm nights around 24°C. Go out early or after sunset."
      },
      {
        "icon": "🌀",
        "title": "Hurricane season: June to November",
        "text": "Peaks around September. Check forecasts and keep plans flexible."
      },
      {
        "icon": "👕",
        "title": "What to pack",
        "text": "Light, breathable clothes, a rain jacket or umbrella, sunscreen and a hat. A light layer for air-conditioned museums."
      },
      {
        "icon": "🌂",
        "title": "Rain timing",
        "text": "Downpours often come in the afternoon. Do outdoor sights in the morning and keep a backup indoor plan."
      }
    ]
