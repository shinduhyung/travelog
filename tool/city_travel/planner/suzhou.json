  "transit": {
    "best": "Metro for most trips; Didi or taxi for gardens and evenings.",
    "modes": [
      {
        "mode": "Metro",
        "has": true,
        "best": true,
        "text": "9 lines; lines 1 and 4 cross downtown. Fares ¥2–6. Fast and cheap for the old town and the station."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Buses run 05:00–21:00 every 10–20 min. Most fares ¥1–2; exact change needed. Tourist buses Y1–Y5 link the railway station and main sights."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis flag ¥10 for 3 km, then about ¥3.2/km. Use the queue, not touts. Didi works well; few drivers speak English, so show Chinese addresses."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not worth it for a short visit. Traffic and parking in the old town are hard; use metro and taxis instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine downtown and along the canals. Bikes rent for about ¥30/day; keep bikes locked."
      }
    ]
  },
  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, fairly dry winters. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April to May and October to November",
        "text": "Highs of 21–26°C and 23°C in October. Comfortable for gardens and canal walks."
      },
      {
        "icon": "🥵",
        "title": "Summer is hot and humid (June to August)",
        "text": "Highs of 28–32°C with 14–16 rain days. Sightsee early morning; rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June and July",
        "text": "About 16 rain days each month. Pack a light raincoat and shoes that dry fast."
      },
      {
        "icon": "❄️",
        "title": "Winter is cool, not freezing",
        "text": "January highs near 9°C and lows near 1°C. Rarely snows, but damp cold feels sharp; bring a warm layer."
      },
      {
        "icon": "☂️",
        "title": "Spring rain",
        "text": "March and April each have about 11 rain days. An umbrella is worth carrying."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a warm coat for December to February, and rain gear for summer. Comfortable shoes for garden paths."
      }
    ]
  }
}