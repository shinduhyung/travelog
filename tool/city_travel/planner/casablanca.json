  "transit": {
    "best": "Tram for main streets, red petits taxis or ride apps for everything else.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro. The tram is the main rail option in the city."
      },
      {
        "mode": "Tram",
        "has": true,
        "best": true,
        "text": "Runs 05:30–22:30. One ride is about 6–8 MAD with a rechargeable card. Good for the centre."
      },
      {
        "mode": "Train",
        "has": true,
        "text": "Al Bidaoui train links the airport and some city stops, but stops are far apart. Check times on the day."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "Cheap at about 5 MAD, but routes are unclear and pickpockets are a risk. Keep bags close."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Red petits taxis use meters, minimum 7 MAD, and drivers may pick up others. White grand taxis run fixed routes and leave when full. Careem and inDrive work."
      },
      {
        "mode": "Rental car",
        "has": false,
        "text": "Not needed for the centre. Traffic and parking are a hassle; use taxis instead."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Fine in the centre and the medina. Wear comfortable shoes for uneven streets."
      }
    ]
  },
  "climate_guide": {
    "summary": "Mild coastal climate: warm dry summers and cool, sometimes wet winters. Rain is light but most likely from November to March.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm and almost rain-free, highs of 24–28°C. Ideal for the Corniche and long walks."
      },
      {
        "icon": "🌧️",
        "title": "Wettest months: November to March",
        "text": "About 6–9 rain days a month. Showers are usually short; carry a small umbrella."
      },
      {
        "icon": "🌡️",
        "title": "Mild winters",
        "text": "January and February sit around 18°C by day and 9–10°C at night. A jacket helps in the evening."
      },
      {
        "icon": "🌊",
        "title": "Sea breeze",
        "text": "The Atlantic keeps the city cooler than inland Morocco, but evenings by the Corniche can feel chilly."
      },
      {
        "icon": "🕶️",
        "title": "Strong summer sun",
        "text": "July and August are dry and bright. Use sunscreen and avoid midday sun on the beach."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers for summer, a warm layer and rain jacket for winter, plus modest clothing for the mosque."
      }
    ]
  }
