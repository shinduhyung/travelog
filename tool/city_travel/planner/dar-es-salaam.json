  "transit": {
    "best": "Ride apps or taxis for most trips; DART buses for cheap cross-city runs.",
    "modes": [
      {
        "mode": "Metro",
        "has": false,
        "text": "No metro. DART is a bus rapid transit system, not rail."
      },
      {
        "mode": "Bus",
        "has": true,
        "text": "DART buses run on dedicated lanes; Phase 1 links Kimara to Kivukoni Ferry via Posta. Daladala minibuses are cheap (under TSh 1,000) but slow and crowded; look for POSTA signs."
      },
      {
        "mode": "Taxi / ride apps",
        "has": true,
        "best": true,
        "text": "Taxis are everywhere; agree the fare first, as meters are rare. Bolt and Uber work in Dar and often beat street-taxi prices."
      },
      {
        "mode": "Rental car",
        "has": true,
        "text": "Driving is on the left. Traffic is heavy, especially at evening rush hour."
      },
      {
        "mode": "Walking",
        "has": true,
        "text": "Walking suits the compact centre. Cycling is possible but risky on busy roads."
      },
      {
        "mode": "Ferry",
        "has": true,
        "text": "Ferries from Kivukoni cross to Kigamboni in the south."
      }
    ]
  },
  "climate_guide": {
    "summary": "Tropical coastal climate: hot all year, with a long rainy season around April and short rains late in the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: June to September",
        "text": "Driest and coolest months, with highs near 28–29°C and few rain days. Ideal for beaches and walking."
      },
      {
        "icon": "🌧️",
        "title": "Long rains in April",
        "text": "About 26 rain days, the wettest month. Expect heavy showers and plan indoor sights."
      },
      {
        "icon": "🌦️",
        "title": "Short rains in November and December",
        "text": "Around 20–21 rain days. Showers are often short but frequent; carry an umbrella."
      },
      {
        "icon": "🥵",
        "title": "Hot and humid all year",
        "text": "Highs stay around 28–31°C and lows 22–26°C. Drink water and take midday breaks."
      },
      {
        "icon": "🌊",
        "title": "Sea breezes help",
        "text": "Coastal spots like Oyster Bay and the islands feel cooler than the city centre."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes, a hat, sunscreen and insect repellent. Add a rain jacket for April and November–December."
