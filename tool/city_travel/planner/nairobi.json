  "climate_guide": {
    "summary": "Nairobi sits high, so days are mild year-round and nights are cool. Rain comes in two seasons: long rains in April–May and short rains in November.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: January to March and June to September",
        "text": "Warm days around 23–27°C with the fewest rain days. Good for parks, markets and day trips."
      },
      {
        "icon": "🌧️",
        "title": "Long rains in April and May",
        "text": "April has about 26 rain days. Expect heavy afternoon showers, muddy trails and slower traffic."
      },
      {
        "icon": "🌦️",
        "title": "Short rains in November",
        "text": "About 23 rain days, usually afternoon downpours. Mornings are often clear."
      },
      {
        "icon": "🧥",
        "title": "Cool nights all year",
        "text": "Lows sit around 12–16°C. Bring a light jacket or fleece for evenings and early game drives."
      },
      {
        "icon": "🌤️",
        "title": "July and August are cool and dry",
        "text": "Highs near 23°C with only 5–7 rain days. Pack layers; mornings can feel chilly."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light layers, a rain jacket, comfortable shoes and sunscreen. Add a warm layer for nights and a hat for the sun."
      }
    ]
  }
