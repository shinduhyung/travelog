  "climate_guide": {
    "summary": "Four clear seasons: cold, fairly dry winters and hot, humid, rainy summers.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: spring and autumn",
        "text": "April, May and October bring mild highs around 19–23°C, ideal for walking and sightseeing."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer",
        "text": "July and August reach highs near 30–32°C with many rain days. Take indoor breaks and carry water."
      },
      {
        "icon": "🌧️",
        "title": "Rainy spells",
        "text": "June and September have the most rain days. Keep an umbrella and a backup indoor plan."
      },
      {
        "icon": "❄️",
        "title": "Cold, drier winter",
        "text": "January and February highs near 9–10°C, lows near 1°C. Few rain days; dress warmly."
      },
      {
        "icon": "🌂",
        "title": "Pack an umbrella",
        "text": "Rain days range from about 7 to 16 a month, so a compact umbrella helps year-round."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, light breathable clothes for summer, and a warm coat for winter."
      }
    ]
  }
