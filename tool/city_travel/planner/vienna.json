  "climate_guide": {
    "summary": "Continental climate: cold winters, warm summers, and rain spread through the year. Spring and autumn are the easiest months to walk the city.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best months: April to June and September",
        "text": "Highs around 16–26°C. Comfortable for walking and palaces without summer heat."
      },
      {
        "icon": "☀️",
        "title": "Summer is warm, not extreme",
        "text": "July and August peak near 27°C with mild nights around 17°C. Some afternoons feel humid."
      },
      {
        "icon": "❄️",
        "title": "Winter is properly cold",
        "text": "December to February highs of 4–6°C and lows near or below freezing. Snow is possible but not guaranteed."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "About 7–13 rain days every month, most in May. Showers often pass; a small umbrella is enough."
      },
      {
        "icon": "🧥",
        "title": "Pack layers",
        "text": "A warm coat and gloves for November to March; light layers and a rain jacket for spring and autumn."
      },
      {
        "icon": "🎄",
        "title": "December is festive but cold",
        "text": "Christmas markets are outdoors. Wear boots and thermals, and warm up in coffee houses."
      }
    ]
  }
