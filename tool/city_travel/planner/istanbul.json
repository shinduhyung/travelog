  "climate_guide": {
    "summary": "Istanbul has a mild, wet climate: cool wet winters and warm, drier summers.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Warm days from 21°C to 29°C and fewer rain days. Ideal for ferries and walking."
      },
      {
        "icon": "🌧️",
        "title": "Wettest in winter",
        "text": "December and January have about 13–14 rain days. Bring a waterproof jacket and shoes."
      },
      {
        "icon": "🥵",
        "title": "Hot summer afternoons",
        "text": "July and August reach 29°C. Sightsee in the morning and rest in the shade at midday."
      },
      {
        "icon": "🧥",
        "title": "Cold winter nights",
        "text": "January and February lows near 4°C. Pack warm layers for evenings."
      },
      {
        "icon": "🌂",
        "title": "Rain any month",
        "text": "Even summer has a few wet days. A small umbrella is always useful."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Light clothes and a hat for summer; a warm coat and waterproof shoes for winter; modest clothing for mosques."
      }
    ]
  }
