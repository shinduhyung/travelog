  "climate_guide": {
    "summary": "Mild, changeable and often wet: rain on roughly 12–15 days every month, and rarely very hot or very cold.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain any month",
        "text": "Expect rain on about 12–15 days each month. Showers are often short; carry a compact waterproof."
      },
      {
        "icon": "🧥",
        "title": "Pack layers",
        "text": "Highs run from about 8°C in winter to 19°C in summer. A warm mid-layer and a rain jacket cover most trips."
      },
      {
        "icon": "☀️",
        "title": "Best months: May to September",
        "text": "Warmest and brightest, with highs of 15–19°C. Still bring rain gear — wet days happen."
      },
      {
        "icon": "🥶",
        "title": "Winter is cool, not freezing",
        "text": "January and February sit around 8–9°C by day and 4°C at night. Wind off the river feels colder."
      },
      {
        "icon": "🕶️",
        "title": "Long summer evenings",
        "text": "June and July give the longest daylight, good for late walks and outdoor pints."
      },
      {
        "icon": "👟",
        "title": "Wear comfortable shoes",
        "text": "You will walk a lot on cobbles and wet pavements. Waterproof shoes beat an umbrella in wind."
      }
    ]
  }
