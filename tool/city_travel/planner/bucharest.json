  "climate_guide": {
    "summary": "Continental climate: hot summers, cold winters, and rain spread through the year.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May, June and September",
        "text": "Warm days around 22–27°C and long evenings. Ideal for walking the old town and parks."
      },
      {
        "icon": "🥵",
        "title": "Summer can be hot",
        "text": "July and August reach about 30°C. Sightsee in the morning and evening; rest indoors at midday."
      },
      {
        "icon": "🥶",
        "title": "Winters are cold",
        "text": "January highs near 4°C and lows around -4°C. Bring a proper coat, hat and warm shoes."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect roughly 5–12 rain days each month. June is wettest; September is driest. A small umbrella helps."
      },
      {
        "icon": "🍂",
        "title": "Spring and autumn are mild",
        "text": "April, May and October are comfortable for walking, with highs of 18–22°C."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobblestones; a warm coat for December to February."
      }
