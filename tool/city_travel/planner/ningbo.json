  "climate_guide": {
    "summary": "Humid subtropical: hot, wet summers and cool, drier winters. Spring and autumn are the best times to visit.",
    "items": [
      {
        "icon": "🌸",
        "title": "Best time: April, May and October",
        "text": "Highs of 21–25°C with manageable rain. Good for walking the old streets and the Bund."
      },
      {
        "icon": "🥵",
        "title": "Hot, humid summer (July–August)",
        "text": "Highs near 33°C and lows near 26°C. Do outdoor sights early or late; rest indoors at midday."
      },
      {
        "icon": "🌧️",
        "title": "Rain peaks in June",
        "text": "About 19 rain days in June and 14 in May. Bring a compact umbrella and waterproof shoes."
      },
      {
        "icon": "🧥",
        "title": "Cool winters (December–February)",
        "text": "Highs of 11–12°C and lows of 3–4°C. A warm coat and layers are needed, especially by the river."
      },
      {
        "icon": "💧",
        "title": "Humid most of the year",
        "text": "Summers feel sticky. Light, breathable clothes help; indoor air-conditioning can feel cold."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers for spring and autumn, a rain jacket, sunscreen and a hat for summer, and a warm coat for winter."
      }
    ]
  }
