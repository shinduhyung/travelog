  "climate_guide": {
    "summary": "Cool coastal climate: mild summers, cold winters, and rain in every month. Pack layers and a rain jacket.",
    "items": [
      {
        "icon": "☀️",
        "title": "Best time: May to September",
        "text": "Highs of 15–21°C and long days. Best for walking, bikes and the harbour."
      },
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "9–13 rain days every month. Showers pass quickly; a light waterproof beats an umbrella in wind."
      },
      {
        "icon": "🧥",
        "title": "Winter is cold and dark",
        "text": "December to February highs of 4–6°C, lows near 1°C. Daylight is short; plan indoor sights."
      },
      {
        "icon": "🌬️",
        "title": "Windy by the water",
        "text": "The harbour and canals feel colder than the forecast. A windproof layer helps."
      },
      {
        "icon": "🌡️",
        "title": "Summers are mild, not hot",
        "text": "July and August peak around 20–21°C. Rarely need air-conditioning."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof jacket and comfortable shoes for cobblestones. Add a warm hat and gloves in winter."
      }
    ]
  }
