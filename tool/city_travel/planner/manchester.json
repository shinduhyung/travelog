  "climate_guide": {
    "summary": "Temperate and often wet: mild summers, cool winters, and rain possible in any month.",
    "items": [
      {
        "icon": "🌧️",
        "title": "Rain all year",
        "text": "Expect 12–19 rain days every month. A waterproof jacket beats an umbrella in the wind."
      },
      {
        "icon": "🌡️",
        "title": "Mild summers",
        "text": "July and August peak near 20°C with lows around 12°C. Rarely hot."
      },
      {
        "icon": "🧥",
        "title": "Cool winters",
        "text": "January and February highs near 7–8°C and lows around 2°C. Bring a warm coat."
      },
      {
        "icon": "🌤️",
        "title": "Best odds: April to June",
        "text": "April has the fewest rain days and May–June are mild and bright."
      },
      {
        "icon": "☂️",
        "title": "Wettest: July and December",
        "text": "July has about 19 rain days and December about 18. Plan indoor backups."
      },
      {
        "icon": "🧳",
        "title": "What to pack",
        "text": "Layers, a waterproof shell and comfortable shoes for wet pavements."
