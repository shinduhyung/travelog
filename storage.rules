rules_version = '2';

// Objects outside private/ are published content (quizzes, l10n catalogs,
// badge/landmark/passport images) read by the app over plain HTTPS without
// auth. private/ contains server-only poll archives and is never client-readable.
// The app never writes to Storage from the client; uploads go through
// the Admin SDK / gcloud (e.g. tool/l10n/publish.py), which bypass these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{top}/{allPaths=**} {
      allow read: if top != 'private';
      allow write: if false;
    }
  }
}
